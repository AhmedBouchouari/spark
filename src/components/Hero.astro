---
import { Image } from "astro:assets";
import heroBg from "../assets/images/hero/Gemini_Generated_Image_xo9uefxo9uefxo9u.webp";

const trustPoints = [
  "ADS",
  "OFFRES",
  "LEADS",
  "RENDEZ-VOUS",
];
---

<section id="hero" class="hero" aria-labelledby="hero-title">

  <!-- Background image -->
  <div class="hero-bg" aria-hidden="true">
    <Image
      src={heroBg}
      alt=""
      class="hero-bg-img"
      loading="eager"
      width={1600}
      height={900}
      sizes="100vw"
    />

    <div class="hero-bg-overlay"></div>
  </div>


  <!-- Subtle grid -->
  <div class="hero-grid" aria-hidden="true"></div>


  <!-- Main container -->
  <div class="hero-container">

    <!-- CONTENT -->

    <div class="hero-content">

      <div class="hero-eyebrow">
        <span class="eyebrow-dot"></span>

        <span>SPARK</span>

        <span class="eyebrow-slash">/</span>

        <span>BEAUTY GROWTH SYSTEM</span>
      </div>


      <h1 id="hero-title" class="hero-title">
        Plus de clientes.
        <span>Un agenda plus rempli.</span>
      </h1>


      <p class="hero-description">
        Nous aidons les salons de beauté à attirer de nouvelles clientes
        grâce à un système marketing pensé pour générer des demandes,
        des conversations et des rendez-vous.
      </p>


      <div class="hero-actions">

        <a
          href="#contact"
          class="hero-cta"
          aria-label="Parler à Spark au sujet de votre salon"
        >
          <span>Parler à Spark</span>

          <span
            class="cta-arrow"
            aria-hidden="true"
          >
            →
          </span>
        </a>

      </div>


      <!-- Keywords -->

      <div
        class="hero-keywords"
        aria-label="Services Spark"
      >

        {
          trustPoints.map((item, index) => (
            <>
              <span>{item}</span>

              {index < trustPoints.length - 1 && (
                <i aria-hidden="true"></i>
              )}
            </>
          ))
        }

      </div>

    </div>

  </div>


  <!-- BOTTOM BOUNDARY -->

  <div class="hero-footer">

    <div class="hero-footer-line"></div>

    <div class="hero-footer-content">

      <span>VISIBILITÉ</span>

      <i></i>

      <span>DEMANDES</span>

      <i></i>

      <span>RENDEZ-VOUS</span>

    </div>

    <div class="hero-footer-line"></div>

  </div>

</section>


<style>

/* =========================================================
   HERO
========================================================= */

.hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;

  color: #ffffff;

  border-bottom:
    1px solid
    rgba(255,255,255,.08);
}


/* =========================================================
   BACKGROUND
========================================================= */

.hero-bg {
  position: absolute;

  inset: 0;

  z-index: -3;
}


.hero-bg-img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: center 25%;
}


.hero-bg-overlay {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      105deg,
      rgba(1,22,64,.84) 0%,
      rgba(1, 22, 64, 0) 45%,
      rgba(1, 22, 64, 0.075) 100%
    );
}


/* =========================================================
   GRID
========================================================= */

.hero-grid {
  position: absolute;

  inset: 0;

  z-index: -2;

  pointer-events: none;

  opacity: .16;

  background-image:
    linear-gradient(
      rgba(255,255,255,.06) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.06) 1px,
      transparent 1px
    );

  background-size: 72px 72px;

  mask-image:
    linear-gradient(
      to bottom,
      black 0%,
      black 60%,
      transparent 100%
    );
}


/* =========================================================
   CONTAINER
========================================================= */

.hero-container {
  position: relative;

  z-index: 2;

  width:
    min(
      1240px,
      calc(100% - 64px)
    );

  /*
    Reduced from 760px → 620px
  */

  min-height: 620px;

  margin: 0 auto;

  display: flex;

  align-items: center;

  padding:
    75px 0
    65px;
}


/* =========================================================
   CONTENT
========================================================= */

.hero-content {
  position: relative;

  z-index: 3;

  max-width: 680px;
}


/* =========================================================
   EYEBROW
========================================================= */

.hero-eyebrow {
  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 9px;

  margin-bottom: 22px;

  color:
    rgba(255,255,255,.65);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .16em;

  text-transform: uppercase;
}


.eyebrow-dot {
  width: 7px;

  height: 7px;

  flex: 0 0 auto;

  border-radius: 50%;

  background: #3BC9DB;

  box-shadow:
    0 0 0 4px
    rgba(59,201,219,.22);
}


.eyebrow-slash {
  color:
    rgba(255,255,255,.3);
}


/* =========================================================
   HEADLINE
========================================================= */

.hero-title {
  max-width: 680px;

  margin: 0;

  color: #ffffff;

  font-size:
    clamp(
      52px,
      5.8vw,
      82px
    );

  line-height: .94;

  letter-spacing: -.065em;

  font-weight: 850;
}


.hero-title span {
  display: block;

  margin-top: 8px;

  color: #3BC9DB;
}


/* =========================================================
   DESCRIPTION
========================================================= */

.hero-description {
  max-width: 500px;

  margin: 25px 0 0;

  color:
    rgba(255,255,255,.72);

  font-size: 14px;

  line-height: 1.75;

  letter-spacing: -.01em;
}


/* =========================================================
   CTA
========================================================= */

.hero-actions {
  display: flex;

  align-items: flex-start;

  flex-direction: column;

  margin-top: 28px;
}


.hero-cta {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 16px;

  min-height: 50px;

  padding:
    0 16px
    0 21px;

  border:
    1px solid
    rgba(255,255,255,.18);

  border-radius: 8px;

  background:
    rgba(255,255,255,.10);

  backdrop-filter: blur(10px);

  color: white;

  text-decoration: none;

  font-size: 11px;

  font-weight: 750;

  box-shadow:
    0 16px 32px
    rgba(0,0,0,.25);

  transition:
    transform .2s ease,
    background .2s ease,
    box-shadow .2s ease;
}


.hero-cta:hover {
  transform:
    translateY(-2px);

  background:
    rgba(255,255,255,.18);

  box-shadow:
    0 20px 38px
    rgba(0,0,0,.32);
}


.hero-cta:focus-visible {
  outline:
    2px solid
    #3BC9DB;

  outline-offset: 4px;
}


.cta-arrow {
  display: flex;

  align-items: center;

  justify-content: center;

  width: 27px;

  height: 27px;

  border-radius: 6px;

  background:
    rgba(59,201,219,.22);

  color: #3BC9DB;

  font-size: 15px;

  transition:
    transform .2s ease;
}


.hero-cta:hover .cta-arrow {
  transform:
    translateX(3px);
}


/* =========================================================
   KEYWORDS
========================================================= */

.hero-keywords {
  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 10px;

  margin-top: 20px;

  color:
    rgba(255,255,255,.38);

  font-size: 7px;

  font-weight: 800;

  letter-spacing: .16em;
}


.hero-keywords i {
  width: 3px;

  height: 3px;

  flex: 0 0 auto;

  border-radius: 50%;

  background: #3BC9DB;
}


/* =========================================================
   FOOTER / BOUNDARY
========================================================= */

.hero-footer {
  position: relative;

  z-index: 3;

  width:
    min(
      1240px,
      calc(100% - 64px)
    );

  margin: 0 auto;

  padding-bottom: 20px;

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  gap: 20px;
}


.hero-footer-line {
  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.2)
    );
}


.hero-footer-line:last-child {
  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.2),
      transparent
    );
}


.hero-footer-content {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  color:
    rgba(255,255,255,.4);

  font-size: 6px;

  font-weight: 800;

  letter-spacing: .15em;

  white-space: nowrap;
}


.hero-footer-content i {
  width: 3px;

  height: 3px;

  border-radius: 50%;

  background: #3BC9DB;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1050px) {

  .hero-container {
    width:
      min(
        calc(100% - 48px),
        1000px
      );

    min-height: 570px;

    padding:
      65px 0
      55px;
  }


  .hero-title {
    font-size:
      clamp(
        48px,
        6.5vw,
        68px
      );
  }


  .hero-description {
    font-size: 13px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 780px) {

  .hero-bg-overlay {
    background:
      rgba(1,22,64,.76);
  }


  .hero-grid {
    opacity: .10;

    background-size:
      58px 58px;
  }


  .hero-container {
    width:
      min(
        calc(100% - 32px),
        640px
      );

    min-height: auto;

    padding:
      62px 0
      52px;
  }


  .hero-content {
    max-width: none;
  }


  .hero-eyebrow {
    margin-bottom: 19px;

    font-size: 8px;
  }


  .hero-title {
    font-size:
      clamp(
        42px,
        10.5vw,
        58px
      );

    line-height: .96;
  }


  .hero-description {
    margin-top: 21px;

    font-size: 13px;

    line-height: 1.72;
  }


  .hero-actions {
    margin-top: 24px;
  }


  .hero-cta {
    width: 100%;

    min-height: 52px;
  }


  .hero-keywords {
    margin-top: 17px;
  }


  .hero-footer {
    width:
      min(
        calc(100% - 32px),
        640px
      );

    grid-template-columns: 1fr;

    gap: 10px;

    padding-bottom: 20px;
  }


  .hero-footer-line {
    width: 45px;

    margin: 0 auto;

    background:
      rgba(255,255,255,.2);
  }


  .hero-footer-line:last-child {
    display: none;
  }


  .hero-footer-content {
    order: -1;

    flex-wrap: wrap;

    font-size: 5.5px;

    white-space: normal;

    line-height: 1.6;

    text-align: center;
  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 420px) {

  .hero-container {
    width:
      calc(100% - 24px);

    padding:
      52px 0
      44px;
  }


  .hero-eyebrow {
    gap: 6px;

    font-size: 7px;
  }


  .hero-title {
    font-size: 39px;
  }


  .hero-description {
    font-size: 12.5px;
  }


  .hero-keywords {
    gap: 8px;

    font-size: 6.5px;
  }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  .hero-cta,
  .cta-arrow {
    transition: none;
  }

}

</style>

