---
import { Image } from "astro:assets";
import sparkLogo from "../assets/images/logo/spark-logo.png";

const navigation = [
  {
    label: "Le système",
    href: "#system",
  },
  {
    label: "L'offre",
    href: "#offer",
  },
  {
    label: "Pourquoi Spark",
    href: "#why-spark",
  },
];
---

<header class="site-header">
  <nav class="navbar">

    <!-- =====================================================
         LOGO
    ====================================================== -->

    <a href="#hero" class="logo" aria-label="Spark — Accueil">
      <Image
        src={sparkLogo}
        alt="Spark"
        class="logo-image"
        loading="eager"
      />
    </a>


    <!-- =====================================================
         DESKTOP NAVIGATION
    ====================================================== -->

    <div class="desktop-navigation">
      {
        navigation.map((item) => (
          <a href={item.href} class="nav-link">
            {item.label}
          </a>
        ))
      }
    </div>


    <!-- =====================================================
         DESKTOP CTA
    ====================================================== -->

    <a
      href="https://wa.me/YOUR_NUMBER"
      target="_blank"
      rel="noopener noreferrer"
      class="nav-cta"
    >
      <span>Parler à Spark</span>

      <span class="nav-cta-arrow" aria-hidden="true">
        →
      </span>
    </a>


    <!-- =====================================================
         MOBILE MENU BUTTON
    ====================================================== -->

    <button
      class="menu-button"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
    </button>

  </nav>


  <!-- =======================================================
       MOBILE NAVIGATION
  ======================================================== -->

  <div id="mobile-navigation" class="mobile-navigation" hidden>

    {
      navigation.map((item) => (
        <a href={item.href} class="mobile-nav-link">
          {item.label}
        </a>
      ))
    }

    <a
      href="https://wa.me/YOUR_NUMBER"
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-nav-cta"
    >
      <span>Parler à Spark</span>

      <span aria-hidden="true">
        →
      </span>
    </a>

  </div>
</header>


<script>
  const button =
    document.querySelector<HTMLButtonElement>(".menu-button");

  const mobileNavigation =
    document.querySelector<HTMLElement>("#mobile-navigation");

  if (button && mobileNavigation) {
    button.addEventListener("click", () => {
      const isOpen =
        button.getAttribute("aria-expanded") === "true";

      button.setAttribute(
        "aria-expanded",
        String(!isOpen)
      );

      button.setAttribute(
        "aria-label",
        isOpen
          ? "Ouvrir le menu"
          : "Fermer le menu"
      );

      mobileNavigation.hidden = isOpen;
    });

    mobileNavigation
      .querySelectorAll("a")
      .forEach((link) => {
        link.addEventListener("click", () => {
          button.setAttribute(
            "aria-expanded",
            "false"
          );

          button.setAttribute(
            "aria-label",
            "Ouvrir le menu"
          );

          mobileNavigation.hidden = true;
        });
      });
  }
</script>


<style>

  /* =========================================================
     HEADER
  ========================================================= */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;

    width: 100%;

    background:
      rgba(255, 255, 255, 0.92);

    backdrop-filter:
      blur(16px);

    -webkit-backdrop-filter:
      blur(16px);

    border-bottom:
      1px solid
      rgba(1, 22, 64, 0.08);
  }


  /* =========================================================
     NAVBAR
  ========================================================= */

  .navbar {
    width:
      min(
        calc(100% - 40px),
        var(--container-width)
      );

    min-height: 76px;

    margin: 0 auto;

    display: flex;

    align-items: center;

    gap: 32px;
  }


  /* =========================================================
     LOGO
  ========================================================= */

  .logo {
    display: inline-flex;

    align-items: center;

    flex-shrink: 0;

    text-decoration: none;

    line-height: 0;

    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }


  .logo:hover {
    opacity: 0.85;

    transform:
      translateY(-1px);
  }


  .logo-image {
    display: block;

    width: auto;

    height: 38px;

    max-width: 150px;

    object-fit: contain;
  }


  /* =========================================================
     DESKTOP NAVIGATION
  ========================================================= */

  .desktop-navigation {
    display: flex;

    align-items: center;

    gap: 32px;

    margin-left: auto;
  }


  .nav-link {
    position: relative;

    padding: 8px 0;

    color:
      #3f3f3f;

    font-size: 13px;

    font-weight: 550;

    text-decoration: none;

    transition:
      color 180ms ease;
  }


  .nav-link::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: 2px;

    width: 0;
    height: 1px;

    background:
      #0b5fa5;

    transition:
      width 180ms ease;
  }


  .nav-link:hover {
    color:
      #011640;
  }


  .nav-link:hover::after {
    width: 100%;
  }


  /* =========================================================
     DESKTOP CTA
  ========================================================= */

  .nav-cta,
  .mobile-nav-cta {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 10px;

    border-radius: 999px;

    background:
      #011640;

    color:
      #ffffff;

    font-size: 13px;

    font-weight: 650;

    text-decoration: none;

    transition:
      transform 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }


  .nav-cta {
    flex-shrink: 0;

    padding:
      12px 17px
      12px 19px;
  }


  .nav-cta:hover,
  .mobile-nav-cta:hover {
    transform:
      translateY(-2px);

    background:
      #0a4a82;

    box-shadow:
      0 10px 25px
      rgba(1, 22, 64, 0.16);
  }


  .nav-cta-arrow {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 23px;
    height: 23px;

    border-radius: 50%;

    background:
      rgba(59, 201, 219, 0.14);

    color:
      #3bc9db;

    font-size: 14px;

    transition:
      transform 180ms ease;
  }


  .nav-cta:hover .nav-cta-arrow {
    transform:
      translateX(2px);
  }


  /* =========================================================
     MOBILE BUTTON
  ========================================================= */

  .menu-button {
    display: none;

    width: 42px;
    height: 42px;

    margin-left: auto;

    padding: 0;

    border:
      1px solid
      rgba(1, 22, 64, 0.1);

    border-radius: 10px;

    background:
      #f1f3f5;

    cursor: pointer;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 6px;

    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }


  .menu-button:hover {
    background:
      #f3faff;

    border-color:
      rgba(11, 95, 165, 0.2);
  }


  .menu-button span {
    display: block;

    width: 19px;
    height: 1.5px;

    border-radius: 999px;

    background:
      #011640;

    transition:
      transform 180ms ease;
  }


  /* =========================================================
     MOBILE NAVIGATION
  ========================================================= */

  .mobile-navigation {
    display: none;
  }


  /* =========================================================
     TABLET / MOBILE
  ========================================================= */

  @media (max-width: 768px) {

    .navbar {
      width:
        min(
          calc(100% - 32px),
          var(--container-width)
        );

      min-height: 68px;

      gap: 20px;
    }


    .logo-image {
      height: 34px;

      max-width: 135px;
    }


    .desktop-navigation,
    .nav-cta {
      display: none;
    }


    .menu-button {
      display: flex;
    }


    .mobile-navigation:not([hidden]) {
      display: flex;

      flex-direction: column;

      gap: 4px;

      padding:
        14px 16px 18px;

      border-top:
        1px solid
        rgba(1, 22, 64, 0.07);

      background:
        rgba(255, 255, 255, 0.98);
    }


    .mobile-nav-link {
      display: flex;

      align-items: center;

      min-height: 50px;

      padding:
        0 14px;

      border-radius: 9px;

      color:
        #3f3f3f;

      font-size: 15px;

      font-weight: 550;

      text-decoration: none;

      transition:
        background-color 180ms ease,
        color 180ms ease;
    }


    .mobile-nav-link:hover {
      background:
        #f3faff;

      color:
        #011640;
    }


    .mobile-nav-cta {
      margin-top: 10px;

      min-height: 52px;

      padding:
        0 18px;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media (max-width: 420px) {

    .navbar {
      width:
        calc(100% - 24px);
    }


    .logo-image {
      height: 31px;

      max-width: 120px;
    }


    .menu-button {
      width: 40px;
      height: 40px;
    }

  }


  /* =========================================================
     REDUCED MOTION
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .logo,
    .nav-link,
    .nav-link::after,
    .nav-cta,
    .mobile-nav-cta,
    .nav-cta-arrow,
    .menu-button,
    .menu-button span {
      transition: none;
    }

  }

</style>