---
const problems = [
  {
    number: "01",
    titleKey: "p1Title",
    descKey: "p1Desc",
    impactKey: "p1Impact",
    title: "Créneaux vides dans l'agenda",
    description: "Des journées ou heures creuses inutilisées alors que vos charges fixes restent identiques.",
    consequence: "Manque à gagner direct chaque semaine.",
    icon: "calendar",
  },
  {
    number: "02",
    titleKey: "p2Title",
    descKey: "p2Desc",
    impactKey: "p2Impact",
    title: "Des likes, mais pas de patientes",
    description: "Une présence sur Instagram qui génère des réactions mais très peu de prises de rendez-vous réelles.",
    consequence: "Visibilité sans impact financier sur votre cabinet.",
    icon: "visibility",
  },
  {
    number: "03",
    titleKey: "p3Title",
    descKey: "p3Desc",
    impactKey: "p3Impact",
    title: "Publicités sans retour clair",
    description: "Des budgets dépensés en annonces sans savoir combien de patientes/clientes cela vous rapporte.",
    consequence: "Incertitude et gaspillage de votre budget marketing.",
    icon: "ads",
  },
  {
    number: "04",
    titleKey: "p4Title",
    descKey: "p4Desc",
    impactKey: "p4Impact",
    title: "Pas le temps de faire du marketing",
    description: "Votre cœur de métier est de soigner et sublimer, pas de passer 4h/jour à paramétrer des pubs.",
    consequence: "La communication passe toujours au second plan.",
    icon: "time",
  },
];
---

<section id="problem" class="ps" aria-labelledby="problem-title">
  <div class="ps-wrap">
    <!-- CHAPTER ONE — LE PROBLÈME -->
    <div class="chapter chapter-problem">
      <header class="ps-header">
        <p class="ps-eyebrow">
          <span class="ps-eyebrow-rule"></span>
          <span data-i18n="problemEyebrow">LES DÉFIS DU QUOTIDIEN</span>
        </p>

        <div class="ps-heading-row">
          <h2 id="problem-title" class="ps-h2">
            <span data-i18n="problemTitleMain">Votre cabinet mérite</span><br>
            <em data-i18n="problemTitleHighlight">des rendez-vous, pas des likes.</em>
          </h2>

          <p class="ps-lead" data-i18n="problemLead">
            Que vous soyez Médecin Esthétique, Kinésithérapeute ou Responsable d'un Centre d'Esthétique, votre temps est précieux. Votre système marketing doit amener des patientes/clientes qualifiées directement sur WhatsApp.
          </p>
        </div>
      </header>

      <!-- Problem cards grid -->
      <div class="ps-grid" role="list">
        {problems.map((p) => (
          <article class="ps-card" role="listitem">
            <div class="ps-card-head">
              <span class="ps-card-num">{p.number}</span>
              <span class="ps-card-icon" aria-hidden="true">
                {p.icon === "calendar" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                )}
                {p.icon === "visibility" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                )}
                {p.icon === "ads" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M23 6l-9.5 9.5-5-5L1 18"/>
                    <path d="M17 6h6v6"/>
                  </svg>
                )}
                {p.icon === "time" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                )}
              </span>
            </div>

            <div class="ps-card-body">
              <span class="ps-card-label" data-i18n="pivotLabelLeft">LE CONSTAT</span>
              <h3 data-i18n={p.titleKey}>{p.title}</h3>
              <p data-i18n={p.descKey}>{p.description}</p>
            </div>

            <div class="ps-card-foot">
              <span class="ps-card-arrow" aria-hidden="true">→</span>
              <div>
                <span class="ps-consequence-label">IMPACT</span>
                <p data-i18n={p.impactKey}>{p.consequence}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- PIVOT HINGE -->
    <div class="ps-pivot" aria-hidden="true">
      <div class="ps-pivot-line"></div>
      <div class="ps-pivot-node">
        <span class="ps-pivot-dot"></span>
      </div>
      <div class="ps-pivot-labels">
        <span data-i18n="pivotLabelLeft">LE CONSTAT</span>
        <span data-i18n="pivotLabelRight">LA SOLUTION SPARK</span>
      </div>
    </div>

    <!-- CHAPTER TWO — LA SOLUTION -->
    <div class="chapter chapter-solution">
      <div class="ps-resolution">
        <div class="ps-resolution-copy">
          <p class="ps-resolution-eyebrow">
            <span class="ps-eyebrow-rule ps-eyebrow-rule--cyan"></span>
            <span data-i18n="solutionEyebrow">LA SOLUTION SPARK</span>
          </p>

          <h2 class="ps-resolution-h2">
            <span data-i18n="solutionTitleMain">Un système automatique</span><br />
            <em data-i18n="solutionTitleHighlight">pensé pour votre activité.</em>
          </h2>

          <p class="ps-resolution-body" data-i18n="solutionBody">
            Spark crée des campagnes ciblées qui incitent les patientes et clientes locales à demander un rendez-vous directement via WhatsApp, réduisant les créneaux vacants.
          </p>
        </div>

        <div class="ps-resolution-right">
          <div class="ps-pillars">
            <div class="ps-pillar">
              <span class="ps-pillar-num">01</span>
              <div>
                <strong data-i18n="solutionPillar1Title">Demandes WhatsApp Qualifiées</strong>
                <p data-i18n="solutionPillar1Desc">Pas des simples vues. Des messages de personnes motivées.</p>
              </div>
            </div>

            <div class="ps-pillar">
              <span class="ps-pillar-num">02</span>
              <div>
                <strong data-i18n="solutionPillar2Title">Agenda Rempli Régulièrement</strong>
                <p data-i18n="solutionPillar2Desc">Des prises de RDV simples et rapides à confirmer.</p>
              </div>
            </div>

            <div class="ps-pillar">
              <span class="ps-pillar-num">03</span>
              <div>
                <strong data-i18n="solutionPillar3Title">Zéro Gestion Technique</strong>
                <p data-i18n="solutionPillar3Desc">Nous gérons tout A à Z pour que vous vous concentriez sur vos soins.</p>
              </div>
            </div>
          </div>

          <a href="#spark-system" class="ps-cta" aria-label="Découvrir le fonctionnement du système">
            <span data-i18n="solutionCta">Découvrir le fonctionnement</span>
            <span class="ps-cta-icon" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ps {
    position: relative;
    background: var(--color-bg-light);
    color: var(--color-text-main);
    padding: 100px 0;
    transition: var(--theme-transition);
  }

  [dir="rtl"] .ps {
    text-align: right;
  }

  .ps-wrap {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
  }

  .ps-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--color-teal);
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .ps-eyebrow-rule {
    width: 24px;
    height: 2px;
    background: var(--color-teal);
  }

  .ps-heading-row {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 60px;
    align-items: flex-end;
    margin-bottom: 50px;
  }

  .ps-h2 {
    margin: 0;
    font-size: clamp(38px, 4.5vw, 60px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }

  .ps-h2 em {
    font-style: normal;
    color: var(--color-teal);
  }

  .ps-lead {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .ps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .ps-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: transform 200ms ease, box-shadow 200ms ease, var(--theme-transition);
  }

  .ps-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-teal);
  }

  .ps-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .ps-card-num {
    font-size: 12px;
    font-weight: 800;
    color: var(--color-text-light);
  }

  .ps-card-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--color-surface-hover);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ps-card-icon svg {
    width: 20px;
    height: 20px;
  }

  .ps-card-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    text-transform: uppercase;
  }

  .ps-card-body h3 {
    margin: 6px 0 10px;
    font-size: 18px;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.25;
  }

  .ps-card-body p {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .ps-card-foot {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px dashed var(--color-border);
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .ps-card-arrow {
    color: #e11d48;
    font-weight: 700;
  }

  [dir="rtl"] .ps-card-arrow {
    transform: rotate(180deg);
  }

  .ps-consequence-label {
    font-size: 9px;
    font-weight: 800;
    color: #e11d48;
    letter-spacing: 0.08em;
    display: block;
  }

  .ps-card-foot p {
    margin: 2px 0 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .ps-pivot {
    margin: 70px 0;
    text-align: center;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ps-pivot-line {
    position: absolute;
    width: 100%;
    height: 1px;
    background: var(--color-border);
    z-index: 1;
  }

  .ps-pivot-labels {
    position: relative;
    z-index: 2;
    background: var(--color-surface);
    padding: 8px 24px;
    border: 1px solid var(--color-border);
    border-radius: 99px;
    display: flex;
    gap: 20px;
    font-size: 11px;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: 0.1em;
  }

  .ps-resolution {
    background: linear-gradient(135deg, #0a2540 0%, #0f4c81 100%);
    border-radius: 24px;
    padding: 50px;
    color: #ffffff;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 50px;
    align-items: center;
    box-shadow: 0 20px 45px -15px rgba(10, 37, 64, 0.2);
  }

  [data-theme="dark"] .ps-resolution {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(100, 238, 234, 0.2);
  }

  .ps-resolution-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #64eeea;
  }

  .ps-eyebrow-rule--cyan {
    background: #64eeea;
  }

  .ps-resolution-h2 {
    margin: 16px 0;
    font-size: clamp(32px, 3.8vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
  }

  .ps-resolution-h2 em {
    font-style: normal;
    color: #64eeea;
  }

  .ps-resolution-body {
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
  }

  .ps-pillars {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .ps-pillar {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.08);
    padding: 16px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .ps-pillar-num {
    font-size: 14px;
    font-weight: 800;
    color: #64eeea;
    background: rgba(0, 168, 150, 0.2);
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ps-pillar strong {
    display: block;
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
  }

  .ps-pillar p {
    margin: 2px 0 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.75);
  }

  .ps-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px;
    border-radius: 12px;
    background: #00a896;
    color: #ffffff;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: background 200ms ease, transform 200ms ease;
  }

  [dir="rtl"] .ps-cta-icon {
    transform: rotate(180deg);
  }

  .ps-cta:hover {
    background: #028090;
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .ps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .ps-heading-row, .ps-resolution {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 640px) {
    .ps-grid {
      grid-template-columns: 1fr;
    }
    .ps-resolution {
      padding: 30px 20px;
    }
  }
</style>