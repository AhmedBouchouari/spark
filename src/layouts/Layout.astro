---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SPARK — Beauty Growth System",
  description = "Un système marketing pensé pour aider les salons de beauté à attirer plus de clientes et remplir leur agenda.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <slot />
  </body>
</html>