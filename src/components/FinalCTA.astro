---
const whatsappUrl = import.meta.env.PUBLIC_WHATSAPP_URL || "https://wa.me/212600000000";
const footerPromise = "Centres d'Esthétique • Médecins Esthétiques • Kinésithérapie";
---

<section id="contact" class="final-cta">
  <div class="cta-grid" aria-hidden="true"></div>
  <div class="cta-glow" aria-hidden="true"></div>

  <div class="cta-container">
    <div class="cta-card">
      <!-- BRAND BADGE -->
      <div class="cta-brand">
        <div class="brand-mark">S</div>
        <div class="brand-text">
          <span>SPARK</span>
          <small>GROWTH SYSTEM</small>
        </div>
      </div>

      <!-- MAIN CONTENT -->
      <div class="cta-content">
        <div class="cta-eyebrow">
          <span class="eyebrow-line"></span>
          <span data-i18n="ctaEyebrow">ÉCHANGE SANS ENGAGEMENT</span>
        </div>

        <h2>
          <span data-i18n="ctaTitleMain">Prêt à remplir votre agenda</span><br />
          <span data-i18n="ctaTitleHighlight">dès cette semaine ?</span>
        </h2>

        <p class="cta-description" data-i18n="ctaDesc">
          Discutez directement avec un conseiller sur WhatsApp. Nous étudierons votre zone géographique et vos prestations pour vous montrer concrètement les résultats atteignables.
        </p>

        <div class="cta-action">
          <a
            href={whatsappUrl}
            class="whatsapp-button"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Parler à Spark sur WhatsApp"
          >
            <span class="whatsapp-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.1 3.9A11.85 11.85 0 0 0 12.02.55C5.67.55.5 5.72.5 12.07c0 2.03.53 4.02 1.53 5.76L.43 23.45l5.76-1.51a11.5 11.5 0 0 0 5.83 1.58h.01c6.35 0 11.5-5.17 11.5-11.52 0-3.08-1.2-5.97-3.43-8.1Z" fill="currentColor"/>
                <path d="M17.64 14.47c-.31-.16-1.84-.91-2.12-1.02-.28-.1-.49-.16-.69.16-.2.31-.8 1.02-.98 1.22-.18.2-.36.23-.67.08-.31-.16-1.31-.48-2.5-1.54-.92-.82-1.54-1.84-1.72-2.15-.18-.31-.02-.48.14-.64.14-.14.31-.36.47-.54.16-.18.21-.31.31-.51.1-.2.05-.38-.03-.54-.08-.16-.69-1.67-.95-2.29-.25-.6-.5-.52-.69-.53h-.59c-.2 0-.51.08-.78.38-.27.31-1.03 1.01-1.03 2.47s1.05 2.87 1.2 3.07c.15.2 2.06 3.15 5 4.42.7.3 1.25.48 1.68.62.71.23 1.35.2 1.86.12.57-.09 1.84-.75 2.1-1.47.26-.72.26-1.34.18-1.47-.08-.13-.28-.2-.59-.36Z" fill="white"/>
              </svg>
            </span>
            <span data-i18n="ctaBtn">Démarrer l'échange sur WhatsApp</span>
            <span class="button-arrow" aria-hidden="true">→</span>
          </a>

          <div class="cta-trust-items">
            <span data-i18n="trustItem1">✓ Sans engagement</span>
            <span data-i18n="trustItem2">✓ Réponse en moins de 5 min</span>
            <span data-i18n="trustItem3">✓ Lancement sous 48h</span>
          </div>
        </div>
      </div>

      <!-- BOTTOM PROMISE -->
      <div class="cta-bottom">
        <span class="bottom-line"></span>
        <p data-i18n="footerPromise">{footerPromise}</p>
        <span class="bottom-line"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    background: #0a2540;
    color: #ffffff;
    padding: 100px 0;
    overflow: hidden;
    transition: var(--theme-transition);
  }

  [data-theme="dark"] .final-cta {
    background: #080e1a;
  }

  .cta-container {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .cta-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 28px;
    padding: 60px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
  }

  [data-theme="dark"] .cta-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(100, 238, 234, 0.2);
  }

  .cta-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    background: #00a896;
    color: #ffffff;
    font-weight: 800;
    font-size: 18px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text span {
    display: block;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #ffffff;
  }

  .brand-text small {
    font-size: 9px;
    color: #64eeea;
    font-weight: 700;
  }

  .cta-content {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 50px;
  }

  .cta-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #64eeea;
    margin-bottom: 20px;
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background: #64eeea;
  }

  .cta-content h2 {
    margin: 0;
    font-size: clamp(38px, 4.8vw, 64px);
    font-weight: 800;
    line-height: 1.05;
    color: #ffffff;
    letter-spacing: -0.03em;
  }

  .cta-content h2 span {
    display: block;
    color: #64eeea;
  }

  .cta-description {
    margin: 20px 0 36px;
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
  }

  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .whatsapp-button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 18px 36px;
    background: #25d366;
    color: #ffffff;
    font-weight: 800;
    font-size: 16px;
    border-radius: 99px;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.35);
    transition: transform 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  [dir="rtl"] .button-arrow {
    transform: rotate(180deg);
  }

  .whatsapp-button:hover {
    transform: translateY(-2px);
    background: #20bd5a;
    box-shadow: 0 14px 40px rgba(37, 211, 102, 0.45);
  }

  .whatsapp-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
  }

  .cta-trust-items {
    display: flex;
    gap: 20px;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-bottom {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .bottom-line {
    flex-grow: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
  }

  .cta-bottom p {
    margin: 0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 640px) {
    .cta-card {
      padding: 30px 20px;
    }
    .whatsapp-button {
      width: 100%;
      justify-content: center;
      padding: 16px 20px;
      font-size: 14px;
    }
    .cta-trust-items {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
