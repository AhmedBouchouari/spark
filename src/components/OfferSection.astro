---
const features = [
  {
    categoryKey: "f1Cat",
    number: "01",
    itemKeys: ["f1i1", "f1i2", "f1i3"],
    category: "Lancement & Stratégie",
    items: [
      "Création de la proposition de valeur",
      "Sélection des prestations phares",
      "Paramétrage complet des comptes Ads",
    ],
  },
  {
    categoryKey: "f2Cat",
    number: "02",
    itemKeys: ["f2i1", "f2i2", "f2i3"],
    category: "Création de Contenu",
    items: [
      "Rédaction des annonces persuasives",
      "Mise en avant visuelle des soins",
      "Adaptation aux codes santé & beauté",
    ],
  },
  {
    number: "03",
    categoryKey: "f3Cat",
    itemKeys: ["f3i1", "f3i2", "f3i3"],
    category: "Diffusion & Ciblage",
    items: [
      "Ciblage géographique par ville/quartier",
      "Ciblage par centres d'intérêt & âge",
      "Optimisation continue du budget",
    ],
  },
  {
    number: "04",
    categoryKey: "f4Cat",
    itemKeys: ["f4i1", "f4i2", "f4i3"],
    category: "Contact & Conversion",
    items: [
      "Bouton WhatsApp direct",
      "Messages pré-remplis pour chaque soin",
      "Accompagnement à la confirmation des RDV",
    ],
  },
];
const whatsappUrl = import.meta.env.PUBLIC_WHATSAPP_URL || "https://wa.me/212600000000";
---

<section id="offer" class="offer" aria-labelledby="offer-title">
  <div class="offer-container">
    <!-- HEADER -->
    <header class="offer-header">
      <div class="eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span data-i18n="offerEyebrow">TARIF TRANSPARENT</span>
      </div>

      <div class="offer-heading">
        <div class="heading-main">
          <span class="heading-index" data-i18n="offerIndex">PROPOSITION SPARK</span>
          <h2 id="offer-title">
            <span data-i18n="offerTitleMain">Un abonnement mensuel</span><br />
            <span data-i18n="offerTitleHighlight">simple & sans surprise.</span>
          </h2>
        </div>

        <div class="heading-side">
          <p data-i18n="offerDesc">
            Tout ce dont votre centre ou cabinet a besoin pour attirer des patientes régulièrement. Aucun contrat piégé, aucun frais caché.
          </p>
          <div class="heading-note">
            <span class="note-dot"></span>
            <span data-i18n="offerNote">Résiliable chaque mois en 1 clic</span>
          </div>
        </div>
      </div>
    </header>

    <!-- OFFER MAIN CARD -->
    <div class="offer-layout">
      <article class="pricing-card">
        <div class="pricing-top">
          <div class="plan-information">
            <div class="plan-icon">S</div>
            <div class="plan-copy">
              <span class="plan-label font-mono" data-i18n="planBadge">FORMULE UNIQUE</span>
              <h3 data-i18n="planTitle">Spark Growth System</h3>
              <p data-i18n="planSubtitle">Système complet d'acquisition Beauté & Santé</p>
            </div>
          </div>

          <div class="price">
            <span class="price-amount font-mono" data-i18n="priceAmount">1 500</span>
            <span class="price-currency" data-i18n="priceCurrency">DH</span>
            <span class="price-period" data-i18n="pricePeriod">/ mois</span>
          </div>
        </div>

        <div class="included">
          <div class="included-header">
            <div>
              <span class="included-label" data-i18n="includedLabel">CE QUI EST INCLUS</span>
              <span class="included-subtitle" data-i18n="includedSubtitle">Gestion intégrale de votre acquisition client</span>
            </div>
            <span class="included-count font-mono" data-i18n="includedBadge">PACK TOUT-EN-UN</span>
          </div>

          <div class="included-grid">
            {features.map((group) => (
              <div class="feature-group">
                <div class="feature-group-header">
                  <span class="feature-number font-mono">{group.number}</span>
                  <div>
                    <span class="feature-title" data-i18n={group.categoryKey}>{group.category}</span>
                  </div>
                </div>
                <div class="feature-list">
                  {group.items.map((item, idx) => (
                    <div class="feature">
                      <span class="check">✓</span>
                      <span data-i18n={group.itemKeys[idx]}>{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="pricing-footer">
          <div class="footer-message">
            <strong data-i18n="footerQuestion">Des questions sur notre fonctionnement ?</strong>
            <span data-i18n="footerAnswer">Échangez directement avec notre responsable par message.</span>
          </div>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="offer-button">
            <span data-i18n="offerCta">Démarrer sur WhatsApp</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <aside class="offer-visual">
        <div class="visual-top">
          <span class="visual-eyebrow" data-i18n="visualEyebrow">CROISSANCE ESTIMÉE</span>
          <h3>
            <span data-i18n="visualTitleMain">Des résultats</span><br />
            <span data-i18n="visualTitleHighlight">dès le 1er mois.</span>
          </h3>
        </div>

        <div class="growth-graph" aria-hidden="true">
          <svg class="growth-line" viewBox="0 0 500 200" preserveAspectRatio="none">
            <path class="graph-area" d="M0 160 C100 140, 200 110, 300 80 C400 50, 450 30, 500 20 L500 200 L0 200 Z" fill="rgba(0, 168, 150, 0.15)"></path>
            <path class="graph-path" d="M0 160 C100 140, 200 110, 300 80 C400 50, 450 30, 500 20" fill="none" stroke="#00a896" stroke-width="3"></path>
          </svg>
        </div>

        <div class="visual-metrics">
          <div class="metric">
            <span class="metric-label" data-i18n="visualMetric1Label">CIBLAGE</span>
            <strong data-i18n="visualMetric1Val">LOCAL</strong>
            <small data-i18n="visualMetric1Note">Dans votre zone</small>
          </div>
          <div class="metric">
            <span class="metric-label" data-i18n="visualMetric2Label">CONTACT</span>
            <strong data-i18n="visualMetric2Val">WHATSAPP</strong>
            <small data-i18n="visualMetric2Note">Direct & réactif</small>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .offer {
    position: relative;
    background: var(--color-bg-light);
    color: var(--color-text-main);
    padding: 100px 0;
    border-top: 1px solid var(--color-border);
    transition: var(--theme-transition);
  }

  [dir="rtl"] .offer {
    text-align: right;
  }

  .offer-container {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--color-teal);
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background: var(--color-teal);
  }

  .offer-heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: flex-end;
    margin: 20px 0 50px;
  }

  .heading-index {
    font-size: 10px;
    font-weight: 800;
    color: var(--color-text-light);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 8px;
  }

  .heading-main h2 {
    margin: 0;
    font-size: clamp(38px, 4.5vw, 60px);
    font-weight: 800;
    line-height: 1.05;
    color: var(--color-primary);
    letter-spacing: -0.03em;
  }

  .heading-main h2 span {
    display: block;
    color: var(--color-teal);
  }

  .heading-side p {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .heading-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .note-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-teal);
  }

  .offer-layout {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 24px;
  }

  .pricing-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: var(--theme-transition);
  }

  .pricing-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32px 40px;
    background: var(--color-surface-hover);
    border-bottom: 1px solid var(--color-border);
  }

  .plan-information {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .plan-icon {
    width: 44px;
    height: 44px;
    background: #0a2540;
    color: #ffffff;
    font-weight: 800;
    font-size: 18px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .plan-label {
    font-size: 10px;
    font-weight: 800;
    color: var(--color-teal);
    letter-spacing: 0.1em;
  }

  .plan-copy h3 {
    margin: 2px 0 0;
    font-size: 20px;
    font-weight: 800;
    color: var(--color-primary);
  }

  .plan-copy p {
    margin: 2px 0 0;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .price {
    display: flex;
    align-items: flex-end;
    gap: 6px;
  }

  .price-amount {
    font-size: 48px;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .price-currency {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-teal);
  }

  .price-period {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .included {
    padding: 32px 40px;
  }

  .included-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
  }

  .included-label {
    display: block;
    font-size: 11px;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: 0.05em;
  }

  .included-subtitle {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .included-count {
    font-size: 10px;
    font-weight: 800;
    color: var(--color-teal);
    background: var(--color-teal-soft);
    padding: 4px 10px;
    border-radius: 99px;
  }

  .included-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .feature-group-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .feature-number {
    font-size: 12px;
    font-weight: 800;
    color: var(--color-teal);
  }

  .feature-title {
    font-size: 13px;
    font-weight: 800;
    color: var(--color-primary);
    display: block;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-main);
  }

  .check {
    color: #25d366;
    font-weight: 800;
  }

  .pricing-footer {
    padding: 24px 40px;
    background: var(--color-surface-hover);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-message strong {
    display: block;
    font-size: 14px;
    color: var(--color-primary);
  }

  .footer-message span {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .offer-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: #25d366;
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    border-radius: 99px;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.25);
    transition: transform 200ms ease, background 200ms ease;
  }

  [dir="rtl"] .arrow {
    transform: rotate(180deg);
  }

  .offer-button:hover {
    transform: translateY(-2px);
    background: #20bd5a;
  }

  .offer-visual {
    background: linear-gradient(135deg, #0a2540 0%, #0f4c81 100%);
    border-radius: 24px;
    padding: 32px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-md);
  }

  [data-theme="dark"] .offer-visual {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(100, 238, 234, 0.2);
  }

  .visual-eyebrow {
    font-size: 10px;
    font-weight: 800;
    color: #64eeea;
    letter-spacing: 0.1em;
  }

  .visual-top h3 {
    margin: 8px 0 0;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
  }

  .visual-top h3 span {
    color: #64eeea;
  }

  .growth-graph {
    margin: 30px 0;
    height: 140px;
  }

  .growth-line {
    width: 100%;
    height: 100%;
  }

  .visual-metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .metric {
    background: rgba(255, 255, 255, 0.08);
    padding: 14px;
    border-radius: 12px;
  }

  .metric-label {
    font-size: 9px;
    font-weight: 800;
    color: #94a3b8;
    letter-spacing: 0.05em;
  }

  .metric strong {
    display: block;
    font-size: 15px;
    font-weight: 800;
    color: #64eeea;
    margin-top: 2px;
  }

  .metric small {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 1024px) {
    .offer-layout, .offer-heading {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .included-grid {
      grid-template-columns: 1fr;
    }
    .pricing-top, .pricing-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>