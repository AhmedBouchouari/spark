---
import { Image } from "astro:assets";
import { translations } from "../data/translations";

/* ==========================================
   DESKTOP IMAGES
   ========================================== */

import imgBeaute from "../assets/images/hero/Salon de beauté.webp";
import imgMedecin from "../assets/images/hero/Médecin esthétique.webp";
import imgKine from "../assets/images/hero/Cabinet kinésithérapie.webp";

/* ==========================================
   MOBILE IMAGES
   ========================================== */

import imgBeauteMobile from "../assets/images/hero/spark mb1.png";
import imgMedecinMobile from "../assets/images/hero/spark mb2.png";
import imgKineMobile from "../assets/images/hero/spark mb3.png";


/* ==========================================
   HERO SLIDES
   ========================================== */

const slides = [
  {
    src: imgBeaute,
    srcMobile: imgBeauteMobile,

    alt: "Salon de beauté et soins",

    key: "heroFooter1",
    label: "SALON DE BEAUTÉ",

    descKey: "heroDescBeaute",

    desc:
      "Le premier système d'acquisition spécialement conçu pour les Salons de Beauté et Centres de Soins. Transformez votre visibilité en rendez-vous fermes via WhatsApp.",
  },

  {
    src: imgMedecin,
    srcMobile: imgMedecinMobile,

    alt: "Cabinet de médecin esthétique",

    key: "heroFooter2",
    label: "MÉDECINS ESTHÉTIQUES",

    descKey: "heroDescMedecin",

    desc:
      "Le premier système d'acquisition spécialement conçu pour les Médecins Esthétiques et Cliniques. Transformez votre visibilité en consultations fermes via WhatsApp.",
  },

  {
    src: imgKine,
    srcMobile: imgKineMobile,

    alt: "Cabinet de kinésithérapie",

    key: "heroFooter3",
    label: "KINÉSITHÉRAPIE",

    descKey: "heroDescKine",

    desc:
      "Le premier système d'acquisition spécialement conçu pour les Cabinets de Kinésithérapie et Rééducation. Transformez votre visibilité en séances de soins confirmées via WhatsApp.",
  },
];


/* ==========================================
   TRUST BADGES
   ========================================== */

const trustBadges = [
  {
    icon: "calendar",
    titleKey: "heroTrust1Title",
    descKey: "heroTrust1Desc",

    title: "Rendez-vous Qualifiés",
    desc: "Moins d'annulations",
  },

  {
    icon: "whatsapp",
    titleKey: "heroTrust2Title",
    descKey: "heroTrust2Desc",

    title: "Relance WhatsApp",
    desc: "Conversion immédiate",
  },

  {
    icon: "chart",
    titleKey: "heroTrust3Title",
    descKey: "heroTrust3Desc",

    title: "Budget Maîtrisé",
    desc: "ROI mesurable",
  },
];


/* ==========================================
   WHATSAPP
   ========================================== */

const waBase =
  import.meta.env.PUBLIC_WHATSAPP_URL ||
  "https://wa.me/212605767055";

const whatsappUrl =
  `${waBase}?text=${encodeURIComponent(
    translations.fr.whatsappMessage
  )}`;
---


<section
  id="hero"
  class="hero"
  aria-labelledby="hero-title"
>

  <!-- =====================================
       BACKGROUND SLIDES
       ===================================== -->

  <div
    class="hero-bg-slider"
    aria-hidden="true"
  >

    {
      slides.map((slide, index) => (

        <div
          class={`slide-item ${
            index === 0 ? "active" : ""
          }`}
          data-slide-index={index}
        >

          <!-- DESKTOP -->

          <Image
            src={slide.src}
            alt=""
            class="hero-bg-img hero-bg-img--desktop"

            loading={
              index === 0
                ? "eager"
                : "lazy"
            }

            fetchpriority={
              index === 0
                ? "high"
                : "auto"
            }

            width={1600}
            height={900}

            sizes="100vw"
          />


          <!-- MOBILE -->

          <Image
            src={slide.srcMobile}
            alt=""
            class="hero-bg-img hero-bg-img--mobile"

            loading={
              index === 0
                ? "eager"
                : "lazy"
            }

            fetchpriority={
              index === 0
                ? "high"
                : "auto"
            }

            width={1024}
            height={1792}

            sizes="100vw"
          />

        </div>

      ))
    }


    <!-- cinematic readability overlay -->

    <div class="hero-bg-overlay"></div>

  </div>


  <!-- =====================================
       SUBTLE GRID
       ===================================== -->

  <div
    class="hero-grid"
    aria-hidden="true"
  ></div>


  <!-- =====================================
       MAIN HERO CONTENT
       ===================================== -->

  <div class="hero-container">

    <div class="hero-content">


      <!-- EYEBROW -->

      <div class="hero-eyebrow">

        <span class="eyebrow-dot"></span>

        <span
          class="eyebrow-brand"
          data-i18n="heroEyebrowBrand"
        >
          SPARK GROWTH SYSTEM
        </span>

        <span class="eyebrow-divider">
          |
        </span>

        <span
          class="eyebrow-niche"
          data-i18n="heroEyebrowNiche"
        >
          BEAUTÉ • MÉDECINE • KINÉ
        </span>

      </div>


      <!-- TITLE -->

      <h1
        id="hero-title"
        class="hero-title"
      >

        <span data-i18n="heroTitleMain">
          Plus de clientes.
        </span>

        <br />

        <span
          class="gradient-text"
          data-i18n="heroTitleGradient"
        >
          Un agenda plus rempli.
        </span>

      </h1>


      <!-- =====================================
           DYNAMIC DESCRIPTION
           ===================================== -->

      <div class="hero-descriptions-container">

        {
          slides.map((slide, index) => (

            <p
              class={`hero-description slide-desc ${
                index === 0
                  ? "active"
                  : ""
              }`}

              data-slide-desc-index={index}

              data-i18n={slide.descKey}
            >

              {slide.desc}

            </p>

          ))
        }

      </div>


      <!-- =====================================
           CTA BUTTONS
           ===================================== -->

      <div class="hero-actions">


        <!-- PRIMARY CTA — Contact form -->
        <a
          href="#contact-form"
          class="btn-primary"
          aria-label="Demander un rendez-vous via le formulaire de contact"
        >
          <span class="btn-form-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </span>
          <span data-i18n="heroCtaPrimary">Demander un Rendez-vous</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>

        <!-- SECONDARY CTA — scroll to system -->
        <a href="#system" class="btn-secondary">
          <span data-i18n="heroCtaSecondary">Découvrir le Système</span>
        </a>

      </div>


      <!-- =====================================
           TRUST CARDS
           ===================================== -->

      <div class="hero-trust-cards">

        {
          trustBadges.map((badge) => (

            <div class="trust-card">


              <!-- ICON -->

              <div class="trust-card-icon">


                {
                  badge.icon === "calendar" && (

                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >

                      <rect
                        x="3"
                        y="4"
                        width="18"
                        height="18"
                        rx="2"
                        ry="2"
                      />

                      <line
                        x1="16"
                        y1="2"
                        x2="16"
                        y2="6"
                      />

                      <line
                        x1="8"
                        y1="2"
                        x2="8"
                        y2="6"
                      />

                      <line
                        x1="3"
                        y1="10"
                        x2="21"
                        y2="10"
                      />

                    </svg>

                  )
                }


                {
                  badge.icon === "whatsapp" && (

                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >

                      <path
                        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                      />

                    </svg>

                  )
                }


                {
                  badge.icon === "chart" && (

                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >

                      <line
                        x1="18"
                        y1="20"
                        x2="18"
                        y2="10"
                      />

                      <line
                        x1="12"
                        y1="20"
                        x2="12"
                        y2="4"
                      />

                      <line
                        x1="6"
                        y1="20"
                        x2="6"
                        y2="14"
                      />

                    </svg>

                  )
                }

              </div>


              <!-- TEXT -->

              <div>

                <strong
                  data-i18n={badge.titleKey}
                >
                  {badge.title}
                </strong>

                <p
                  data-i18n={badge.descKey}
                >
                  {badge.desc}
                </p>

              </div>

            </div>

          ))
        }

      </div>

    </div>

  </div>


  <!-- =====================================
       HERO FOOTER
       ===================================== -->

  <div class="hero-footer">

    <div class="hero-footer-container">

      {
        slides.map((slide, index) => (

          <>

            <div
              class={`footer-badge slide-niche ${
                index === 0
                  ? "active"
                  : ""
              }`}

              data-niche-index={index}

              data-i18n={slide.key}
            >

              {slide.label}

            </div>


            {
              index < slides.length - 1 && (

                <span class="footer-dot">
                  •
                </span>

              )
            }

          </>

        ))
      }

    </div>

  </div>

</section>



<script>

  /* ==========================================
     SLIDESHOW
     ========================================== */

  const slideItems =
    document.querySelectorAll<HTMLElement>(
      ".slide-item"
    );

  const nicheBadges =
    document.querySelectorAll<HTMLElement>(
      ".slide-niche"
    );

  const slideDescs =
    document.querySelectorAll<HTMLElement>(
      ".slide-desc"
    );


  if (slideItems.length > 1) {

    let currentIndex = 0;


    setInterval(() => {

      /* deactivate current */

      slideItems[currentIndex]
        ?.classList.remove("active");

      nicheBadges[currentIndex]
        ?.classList.remove("active");

      slideDescs[currentIndex]
        ?.classList.remove("active");


      /* next slide */

      currentIndex =
        (currentIndex + 1) %
        slideItems.length;


      /* activate next */

      slideItems[currentIndex]
        ?.classList.add("active");

      nicheBadges[currentIndex]
        ?.classList.add("active");

      slideDescs[currentIndex]
        ?.classList.add("active");

    }, 5000);

  }

</script>



<style>

  /* ==========================================
     HERO
     ========================================== */

  .hero {
    position: relative;

    isolation: isolate;

    min-height: calc(100vh - 110px);

    display: flex;

    flex-direction: column;

    justify-content: center;

    padding: 80px 0 60px;

    background-color: var(--color-bg-light);

    overflow: hidden;
  }


  /* ==========================================
     BACKGROUND SLIDER
     ========================================== */

  .hero-bg-slider {
    position: absolute;

    inset: 0;

    z-index: -2;

    overflow: hidden;
  }


  .slide-item {
    position: absolute;

    inset: 0;

    opacity: 0;

    transition:
      opacity 1000ms ease-in-out;

    pointer-events: none;
  }


  .slide-item.active {
    opacity: 1;
  }


  /* ==========================================
     BACKGROUND IMAGE
     ========================================== */

  .hero-bg-img {
    width: 100%;

    height: 100%;

    object-fit: cover;

    object-position: center;

    filter:
      brightness(0.95)
      contrast(1.02)
      saturate(1.05);

    transform: scale(1.02);
  }


  .hero-bg-img--desktop {
    display: block;
  }


  .hero-bg-img--mobile {
    display: none;
  }


  /* ==========================================
     DESKTOP OVERLAY
     ========================================== */

  .hero-bg-overlay {
    position: absolute;

    inset: 0;

    z-index: 1;

    pointer-events: none;

    background:
      linear-gradient(
        90deg,
        rgba(5, 20, 35, 0.78) 0%,
        rgba(5, 20, 35, 0.55) 35%,
        rgba(5, 20, 35, 0.22) 70%,
        rgba(5, 20, 35, 0.10) 100%
      ),

      linear-gradient(
        180deg,
        rgba(5, 20, 35, 0.15) 0%,
        rgba(5, 20, 35, 0.08) 50%,
        rgba(5, 20, 35, 0.45) 100%
      );
  }


  /* ==========================================
     GRID
     ========================================== */

  .hero-grid {
    position: absolute;

    inset: 0;

    z-index: -1;

    pointer-events: none;

    background-image:
      radial-gradient(
        rgba(0, 168, 150, 0.15) 1px,
        transparent 1px
      );

    background-size: 32px 32px;

    opacity: 0.45;
  }


  /* ==========================================
     CONTAINER
     ========================================== */

  .hero-container {
    width:
      min(
        calc(100% - 40px),
        var(--container-width)
      );

    margin: 0 auto;

    flex-grow: 1;

    display: flex;

    align-items: center;
  }


  .hero-content {
    max-width: 840px;

    color: #ffffff;

    will-change: transform;
  }


  [dir="rtl"] .hero-content {
    text-align: right;
  }


  /* ==========================================
     EYEBROW
     ========================================== */

  .hero-eyebrow {
    display: inline-flex;

    align-items: center;

    gap: 10px;

    padding: 6px 16px;

    border-radius: 99px;

    background:
      rgba(
        255,
        255,
        255,
        0.10
      );

    backdrop-filter: blur(12px);

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.15
      );

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.08em;

    margin-bottom: 24px;

    white-space: nowrap;
  }


  .eyebrow-dot {
    width: 8px;

    height: 8px;

    border-radius: 50%;

    background: #00a896;

    box-shadow:
      0 0 10px #00a896;

    flex-shrink: 0;
  }


  .eyebrow-brand {
    color: #ffffff;
  }


  .eyebrow-divider {
    color:
      rgba(
        255,
        255,
        255,
        0.3
      );
  }


  .eyebrow-niche {
    color: #64eeea;
  }


  /* ==========================================
     TITLE
     ========================================== */

  .hero-title {
    margin:
      0 0 20px;

    font-size:
      clamp(
        40px,
        5.5vw,
        72px
      );

    font-weight: 800;

    line-height: 1.08;

    letter-spacing: -0.03em;

    color: #ffffff;
  }


  .gradient-text {
    background:
      linear-gradient(
        135deg,
        #64eeea 0%,
        #00a896 100%
      );

    -webkit-background-clip: text;

    background-clip: text;

    -webkit-text-fill-color:
      transparent;
  }


  /* ==========================================
     DESCRIPTIONS
     ========================================== */

  .hero-descriptions-container {
    position: relative;

    min-height: 100px;

    margin-bottom: 30px;

    max-width: 720px;
  }


  .slide-desc {
    position: absolute;

    inset: 0;

    margin: 0;

    font-size:
      clamp(
        16px,
        2vw,
        19px
      );

    line-height: 1.65;

    color:
      rgba(
        255,
        255,
        255,
        0.9
      );

    opacity: 0;

    transition:
      opacity
      1000ms
      ease-in-out;

    pointer-events: none;
  }


  .slide-desc.active {
    position: relative;

    opacity: 1;

    pointer-events: auto;
  }


  /* ==========================================
     BUTTONS
     ========================================== */

  .hero-actions {
    display: flex;

    align-items: center;

    gap: 16px;

    flex-wrap: wrap;

    margin-bottom: 42px;
  }


  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 32px;
    border-radius: 99px;
    background: var(--color-teal);
    color: #ffffff;
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(0, 168, 150, 0.35);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    background: var(--color-teal-light);
    box-shadow: 0 14px 36px rgba(0, 168, 150, 0.45);
  }

  .btn-form-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-form-icon svg {
    width: 20px;
    height: 20px;
  }

  /* keep old class in case still referenced */
  .btn-whatsapp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-whatsapp-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }


  .arrow {
    transition:
      transform
      180ms ease;
  }


  .btn-primary:hover .arrow {
    transform:
      translateX(4px);
  }


  [dir="rtl"] .arrow {
    transform:
      rotate(180deg);
  }


  [dir="rtl"]
  .btn-primary:hover
  .arrow {
    transform:
      rotate(180deg)
      translateX(4px);
  }


  .btn-secondary {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding:
      16px 28px;

    border-radius: 99px;

    background:
      rgba(
        255,
        255,
        255,
        0.10
      );

    backdrop-filter:
      blur(12px);

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.2
      );

    color: #ffffff;

    font-weight: 700;

    font-size: 15px;

    text-decoration: none;

    transition:
      background
      180ms ease,
      border-color
      180ms ease;
  }


  .btn-secondary:hover {
    background:
      rgba(
        255,
        255,
        255,
        0.18
      );

    border-color:
      rgba(
        255,
        255,
        255,
        0.35
      );
  }


  /* ==========================================
     TRUST CARDS
     ========================================== */

  .hero-trust-cards {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 16px;

    max-width: 780px;
  }


  .trust-card {
    display: flex;

    align-items: center;

    gap: 12px;

    padding:
      14px 18px;

    border-radius: 16px;

    background:
      rgba(
        15,
        23,
        42,
        0.65
      );

    backdrop-filter:
      blur(16px);

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.1
      );
  }


  .trust-card-icon {
    width: 38px;

    height: 38px;

    border-radius: 10px;

    background:
      rgba(
        0,
        168,
        150,
        0.2
      );

    color: #64eeea;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;
  }


  .trust-card-icon svg {
    width: 20px;

    height: 20px;
  }


  .trust-card strong {
    display: block;

    font-size: 13px;

    font-weight: 700;

    color: #ffffff;
  }


  .trust-card p {
    margin: 2px 0 0;

    font-size: 11px;

    color:
      rgba(
        255,
        255,
        255,
        0.7
      );
  }


  /* ==========================================
     FOOTER
     ========================================== */

  .hero-footer {
    margin-top: 40px;

    padding-top: 24px;

    border-top:
      1px solid
      rgba(
        255,
        255,
        255,
        0.1
      );
  }


  .hero-footer-container {
    width:
      min(
        calc(100% - 40px),
        var(--container-width)
      );

    margin: 0 auto;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 16px;

    flex-wrap: wrap;
  }


  .footer-badge {
    font-size: 11px;

    font-weight: 800;

    letter-spacing: 0.12em;

    color:
      rgba(
        255,
        255,
        255,
        0.45
      );

    padding:
      6px 14px;

    border-radius: 99px;

    border:
      1px solid transparent;

    transition:
      color 400ms ease,
      background 400ms ease,
      border-color 400ms ease,
      transform 400ms ease;
  }


  .footer-badge.active {
    color: #64eeea;

    background:
      rgba(
        0,
        168,
        150,
        0.25
      );

    border-color:
      rgba(
        100,
        238,
        234,
        0.4
      );

    transform:
      scale(1.04);
  }


  .footer-dot {
    color:
      rgba(
        255,
        255,
        255,
        0.3
      );
  }


  /* ==========================================
     TABLET
     ========================================== */

  @media (max-width: 1024px) {

    .hero {
      min-height: auto;

      padding:
        90px 0 50px;
    }


    .hero-container {
      width:
        min(
          calc(100% - 48px),
          var(--container-width)
        );
    }


    .hero-content {
      max-width: 760px;
    }


    .hero-title {
      font-size:
        clamp(
          42px,
          6vw,
          62px
        );
    }


    .hero-descriptions-container {
      max-width: 650px;
    }


    .hero-trust-cards {
      max-width: 100%;

      gap: 12px;
    }


    .trust-card {
      padding:
        13px 14px;
    }


    .trust-card strong {
      font-size: 12px;
    }


    .trust-card p {
      font-size: 10px;
    }

  }


/* ==========================================
   MOBILE
   ========================================== */

@media (max-width: 768px) {

  .hero {
    min-height: 100svh;
    padding: 0;
    justify-content: flex-start;
    background: #051423;
  }


  /* ======================================
     MOBILE BACKGROUND
     ====================================== */

  .hero-bg-slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide-item {
    width: 100%;
    height: 100%;
  }

  .hero-bg-img--desktop {
    display: none;
  }

  .hero-bg-img--mobile {
    display: block;
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center top;

    filter:
      brightness(0.86)
      contrast(1.03)
      saturate(1.02);

    transform: none;
  }


  /* ======================================
     MOBILE OVERLAY
