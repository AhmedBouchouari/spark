---
const whatsappUrl =
  import.meta.env.PUBLIC_WHATSAPP_URL || "#";

const footerPromise =
  "Plus de clientes. Un agenda plus rempli.";
---

<section id="contact" class="final-cta">

  <div class="cta-grid" aria-hidden="true"></div>

  <div class="cta-glow" aria-hidden="true"></div>

  <div class="cta-container">

    <!-- Brand marker -->

    <div class="cta-brand">

      <div class="brand-mark">
        S
      </div>

      <div class="brand-text">
        <span>SPARK</span>
        <small>BEAUTY GROWTH SYSTEM</small>
      </div>

    </div>


    <!-- Main content -->

    <div class="cta-content">

      <div class="cta-eyebrow">
        <span class="eyebrow-line"></span>
        PARLONS DE VOTRE SALON
      </div>


      <h2>
        Prêt à remplir
        <span>davantage votre agenda ?</span>
      </h2>


      <p class="cta-description">
        Chaque salon a des opportunités différentes.
        Parlons de votre activité et voyons comment
        Spark peut vous aider à attirer plus de clientes.
      </p>


      <div class="cta-action">

        <a
          href={whatsappUrl}
          class="whatsapp-button"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Parler à Spark sur WhatsApp"
        >

          <span class="whatsapp-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M20.1 3.9A11.85 11.85 0 0 0 12.02.55C5.67.55.5 5.72.5 12.07c0 2.03.53 4.02 1.53 5.76L.43 23.45l5.76-1.51a11.5 11.5 0 0 0 5.83 1.58h.01c6.35 0 11.5-5.17 11.5-11.52 0-3.08-1.2-5.97-3.43-8.1Z"
                fill="currentColor"
              />
              <path
                d="M17.64 14.47c-.31-.16-1.84-.91-2.12-1.02-.28-.1-.49-.16-.69.16-.2.31-.8 1.02-.98 1.22-.18.2-.36.23-.67.08-.31-.16-1.31-.48-2.5-1.54-.92-.82-1.54-1.84-1.72-2.15-.18-.31-.02-.48.14-.64.14-.14.31-.36.47-.54.16-.18.21-.31.31-.51.1-.2.05-.38-.03-.54-.08-.16-.69-1.67-.95-2.29-.25-.6-.5-.52-.69-.53h-.59c-.2 0-.51.08-.78.38-.27.31-1.03 1.01-1.03 2.47s1.05 2.87 1.2 3.07c.15.2 2.06 3.15 5 4.42.7.3 1.25.48 1.68.62.71.23 1.35.2 1.86.12.57-.09 1.84-.75 2.1-1.47.26-.72.26-1.34.18-1.47-.08-.13-.28-.2-.59-.36Z"
                fill="white"
              />
            </svg>
          </span>

          <span>
            Parler à Spark sur WhatsApp
          </span>

          <span class="button-arrow" aria-hidden="true">
            →
          </span>

        </a>


        <span class="cta-microcopy">
          Sans engagement.
        </span>

      </div>

    </div>


    <!-- Bottom promise -->

    <div class="cta-bottom">

      <span class="bottom-line"></span>

      <p>
        {footerPromise}
      </p>

      <span class="bottom-line"></span>

    </div>

  </div>
  <style>

  /* ==================================================
     FINAL CTA
  ================================================== */

  .final-cta {
    position: relative;

    overflow: hidden;

    background: #ffffff;

    color: #0b1115;
  }


  .cta-container {
    position: relative;

    z-index: 2;

    width: min(
      1180px,
      calc(100% - 48px)
    );

    min-height: 690px;

    margin: 0 auto;

    padding:
      82px 0
      70px;

    display: flex;

    flex-direction: column;
  }


  /* ==================================================
     BACKGROUND GRID
  ================================================== */

  .cta-grid {
    position: absolute;

    inset: 0;

    pointer-events: none;

    opacity: 0.55;

    background-image:
      linear-gradient(
        #edf2f3 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        #edf2f3 1px,
        transparent 1px
      );

    background-size: 72px 72px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 20%,
        black 80%,
        transparent
      );
  }


  .cta-glow {
    position: absolute;

    top: 50%;
    left: 50%;

    width: 650px;
    height: 450px;

    transform:
      translate(-50%, -50%);

    pointer-events: none;

    background:
      radial-gradient(
        circle,
        rgba(0, 175, 185, 0.09),
        rgba(0, 175, 185, 0.025) 35%,
        transparent 70%
      );
  }


  /* ==================================================
     BRAND
  ================================================== */

  .cta-brand {
    display: flex;

    align-items: center;

    gap: 11px;
  }


  .brand-mark {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 37px;
    height: 37px;

    border-radius: 8px;

    background: #0b1115;

    color: #ffffff;

    font-size: 13px;

    font-weight: 900;

    box-shadow:
      0 7px 20px
      rgba(11, 17, 21, 0.12);
  }


  .brand-text {
    display: flex;

    flex-direction: column;

    gap: 2px;
  }


  .brand-text span {
    color: #0b1115;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 0.16em;
  }


  .brand-text small {
    color: #8a969b;

    font-size: 6px;

    font-weight: 800;

    letter-spacing: 0.14em;
  }


  /* ==================================================
     MAIN CONTENT
  ================================================== */

  .cta-content {
    display: flex;

    flex-direction: column;

    align-items: center;

    max-width: 850px;

    margin:
      auto
      auto
      85px;

    text-align: center;
  }


  .cta-eyebrow {
    display: flex;

    align-items: center;

    gap: 9px;

    margin-bottom: 22px;

    color: #008c96;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.16em;
  }


  .eyebrow-line {
    width: 25px;
    height: 1px;

    background: #00afb9;
  }


  /* ==================================================
     HEADLINE
  ================================================== */

  .cta-content h2 {
    max-width: 850px;

    margin: 0;

    color: #0b1115;

    font-size: clamp(
      52px,
      6.5vw,
      82px
    );

    line-height: 0.94;

    letter-spacing: -0.065em;

    font-weight: 800;
  }


  .cta-content h2 span {
    display: block;

    color: #008c96;
  }


  /* ==================================================
     DESCRIPTION
  ================================================== */

  .cta-description {
    max-width: 570px;

    margin:
      28px auto
      0;

    color: #69777d;

    font-size: 13px;

    line-height: 1.8;
  }


  /* ==================================================
     CTA
  ================================================== */

  .cta-action {
    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 13px;

    margin-top: 34px;
  }


  .whatsapp-button {
    display: inline-flex;

    align-items: center;

    gap: 12px;

    min-height: 54px;

    padding:
      0 22px;

    border:
      1px solid #0b1115;

    border-radius: 7px;

    background: #0b1115;

    color: #ffffff;

    text-decoration: none;

    font-size: 11px;

    font-weight: 750;

    letter-spacing: -0.01em;

    box-shadow:
      0 14px 30px
      rgba(11, 17, 21, 0.12);

    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      background-color 220ms ease;
  }


  .whatsapp-button:hover {
    transform:
      translateY(-2px);

    background: #151d22;

    box-shadow:
      0 18px 38px
      rgba(11, 17, 21, 0.17);
  }


  .whatsapp-button:focus-visible {
    outline:
      3px solid
      rgba(0, 175, 185, 0.35);

    outline-offset: 4px;
  }


  .whatsapp-icon {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 20px;
    height: 20px;

    color: #25d366;
  }


  .whatsapp-icon svg {
    width: 19px;
    height: 19px;
  }


  .button-arrow {
    color: #8fa0a5;

    font-size: 14px;

    transition:
      transform 220ms ease,
      color 220ms ease;
  }


  .whatsapp-button:hover .button-arrow {
    color: #ffffff;

    transform:
      translateX(3px);
  }


  .cta-microcopy {
    color: #929da2;

    font-size: 8px;

    font-weight: 600;

    letter-spacing: 0.03em;
  }


  /* ==================================================
     BOTTOM PROMISE
  ================================================== */

  .cta-bottom {
    display: grid;

    grid-template-columns:
      1fr auto 1fr;

    align-items: center;

    gap: 28px;

    margin-top: auto;
  }


  .bottom-line {
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        #dce4e6
      );
  }


  .bottom-line:last-child {
    background:
      linear-gradient(
        90deg,
        #dce4e6,
        transparent
      );
  }


  .cta-bottom p {
    margin: 0;

    color: #8a969b;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.15em;

    text-transform: uppercase;

    white-space: nowrap;
  }


  /* ==================================================
     TABLET
  ================================================== */

  @media (max-width: 900px) {

    .cta-container {
      width: min(
        850px,
        calc(100% - 40px)
      );
    }


    .cta-content h2 {
      font-size: clamp(
        48px,
        7vw,
        68px
      );
    }

  }


  /* ==================================================
     MOBILE
  ================================================== */

  @media (max-width: 680px) {

    .cta-container {
      width: calc(100% - 28px);

      min-height: 650px;

      padding:
        55px 0
        45px;
    }


    .brand-mark {
      width: 34px;
      height: 34px;

      font-size: 12px;
    }


    .brand-text span {
      font-size: 9px;
    }


    .brand-text small {
      font-size: 5px;
    }


    .cta-content {
      margin:
        auto
        0
        70px;
    }


    .cta-eyebrow {
      margin-bottom: 18px;

      font-size: 7px;
    }


    .cta-content h2 {
      font-size: 45px;

      line-height: 0.97;

      letter-spacing: -0.055em;
    }


    .cta-description {
      max-width: 430px;

      margin-top: 23px;

      font-size: 11px;

      line-height: 1.75;
    }


    .cta-action {
      width: 100%;

      margin-top: 29px;
    }


    .whatsapp-button {
      width: min(
        100%,
        350px
      );

      justify-content: center;

      min-height: 52px;

      padding:
        0 17px;

      font-size: 10px;
    }


    .cta-bottom {
      display: flex;

      justify-content: center;
    }


    .bottom-line {
      display: none;
    }


    .cta-bottom p {
      white-space: normal;

      max-width: 240px;

      text-align: center;

      font-size: 7px;

      line-height: 1.5;
    }

  }


  /* ==================================================
     SMALL MOBILE
  ================================================== */

  @media (max-width: 400px) {

    .cta-container {
      min-height: 620px;
    }


    .cta-content h2 {
      font-size: 39px;
    }


    .cta-description {
      font-size: 10px;
    }


    .whatsapp-button {
      font-size: 9px;
    }

  }


  /* ==================================================
     REDUCED MOTION
  ================================================== */

  @media (prefers-reduced-motion: reduce) {

    .whatsapp-button,
    .button-arrow {
      transition: none;
    }

  }

</style>
</section>

