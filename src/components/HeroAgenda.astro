---
import { translations } from "../data/translations";
const t = translations.fr;
const waBase = import.meta.env.PUBLIC_WHATSAPP_URL || "https://wa.me/212605767055";
const whatsappUrl = `${waBase}?text=${encodeURIComponent(t.whatsappMessage)}`;

const days = [1, 2, 3, 4, 5, 6].map((n) => ({
  key: `agendaDay${n}`,
  label: t[`agendaDay${n}` as keyof typeof t] as string,
}));
const hours = ["9h", "11h", "14h", "16h"];

// [day index, hour index, slot copy number]: the order is the order they fill in
const booked: Array<[number, number, number]> = [
  [0, 0, 1], [2, 1, 2], [1, 2, 3], [4, 0, 4], [3, 3, 5], [5, 1, 6], [0, 2, 7], [5, 0, 8],
];
const slotAt = (d: number, h: number) => {
  const i = booked.findIndex(([bd, bh]) => bd === d && bh === h);
  if (i < 0) return null;
  const n = booked[i][2];
  return { order: i, key: `agendaSlot${n}`, label: t[`agendaSlot${n}` as keyof typeof t] as string };
};
---

<section id="hero" class="hero2" aria-labelledby="hero-title">
  <div class="hero2-inner">
    <div class="hero2-copy">
      <h1 id="hero-title" class="hero2-title">
        <span data-i18n="heroTitleMain">{t.heroTitleMain}</span>
        <span data-i18n="heroTitleGradient">{t.heroTitleGradient}</span>
      </h1>
      <p class="hero2-line" data-i18n="heroLine">{t.heroLine}</p>

      <div class="hero2-actions">
        <a href="#contact-form" class="hero2-btn" data-i18n="heroCtaMain">{t.heroCtaMain}</a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="hero2-wa" data-whatsapp-link>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12.012 2c-5.506 0-9.989 4.478-9.989 9.984 0 1.758.459 3.413 1.264 4.852l-1.341 4.9 5.019-1.316c1.393.759 2.977 1.189 4.647 1.189 5.506 0 9.989-4.478 9.989-9.989 0-5.506-4.483-9.984-9.989-9.984zm5.789 14.129c-.244.685-1.42 1.309-1.961 1.365-.494.052-1.139.076-3.298-.813-2.76-1.137-4.542-3.948-4.68-4.133-.137-.184-1.121-1.492-1.121-2.845 0-1.353.709-2.018.961-2.285.252-.267.551-.334.734-.334.184 0 .367.002.527.009.171.008.4.004.596.474.206.494.708 1.728.77 1.854.062.126.103.275.02.438-.083.163-.125.267-.247.412-.122.145-.258.324-.367.435-.122.122-.25.254-.108.497.142.244.631 1.042 1.354 1.686.93.829 1.714 1.087 1.958 1.209.244.122.387.103.53-.061.143-.164.618-.72.783-.967.165-.247.33-.206.556-.122.226.084 1.439.678 1.686.802.247.124.412.185.473.288.061.103.061.602-.183 1.287z"/>
          </svg>
          <span data-i18n="heroCtaWa">{t.heroCtaWa}</span>
        </a>
      </div>

      <p class="hero2-price" data-i18n="heroPriceNote">{t.heroPriceNote}</p>
    </div>

    <figure class="agenda" aria-label={t.agendaTitle}>
      <figcaption class="agenda-head">
        <strong data-i18n="agendaTitle">{t.agendaTitle}</strong>
        <span data-i18n="agendaNote">{t.agendaNote}</span>
      </figcaption>

      <div class="agenda-grid" role="presentation">
        <span class="agenda-corner"></span>
        {days.map((d, di) => (
          <span class={`agenda-day agenda-col-${di}`} data-i18n={d.key}>{d.label}</span>
        ))}
        {hours.map((h, hi) => (
          <>
            <span class="agenda-hour">{h}</span>
            {days.map((_, di) => {
              const slot = slotAt(di, hi);
              return slot ? (
                <span class={`agenda-cell agenda-col-${di} is-booked`} style={`--order:${slot.order}`}>
                  <span data-i18n={slot.key}>{slot.label}</span>
                </span>
              ) : (
                <span class={`agenda-cell agenda-col-${di}`}></span>
              );
            })}
          </>
        ))}
      </div>

      <div class="agenda-bubble">
        <span class="agenda-bubble-from" data-i18n="agendaBubbleFrom">{t.agendaBubbleFrom}</span>
        <p data-i18n="agendaBubble">{t.agendaBubble}</p>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero2 {
    background: var(--color-bg-light);
    color: var(--color-text-main);
    padding: 72px 0 88px;
    transition: var(--theme-transition);
  }

  .hero2-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 64px;
    align-items: center;
  }

  .hero2-title {
    margin: 0;
    font-size: clamp(40px, 5.4vw, 64px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--color-primary);
  }

  .hero2-title span {
    display: block;
  }

  .hero2-line {
    margin: 22px 0 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.45;
    max-width: 30em;
  }

  .hero2-desc {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 34em;
  }

  .hero2-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 32px;
  }

  .hero2-btn {
    display: inline-flex;
    align-items: center;
    padding: 15px 26px;
    border-radius: 10px;
    background: var(--color-primary);
    color: var(--color-bg-light);
    font-size: 16px;
    font-weight: 600;
    transition: background-color 0.15s ease;
  }

  .hero2-btn:hover {
    background: var(--color-teal);
  }

  .hero2-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-main);
    text-decoration: underline;
    text-decoration-color: #25d366;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .hero2-wa svg {
    color: #25d366;
  }

  .hero2-btn:focus-visible,
  .hero2-wa:focus-visible {
    outline: 3px solid var(--color-booked);
    outline-offset: 3px;
  }

  .hero2-price {
    margin: 22px 0 0;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  /* Agenda: the signature element */
  .agenda {
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 22px;
    box-shadow: 0 30px 60px -40px rgba(21, 48, 42, 0.35);
  }

  .agenda-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }

  .agenda-head strong {
    font-size: 17px;
    font-weight: 600;
  }

  .agenda-head span {
    font-size: 13px;
    color: var(--color-text-light);
  }

  .agenda-grid {
    display: grid;
    grid-template-columns: 34px repeat(6, minmax(0, 1fr));
    gap: 5px;
  }

  .agenda-day {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
    text-align: center;
    padding-bottom: 4px;
  }

  .agenda-hour {
    font-size: 11px;
    color: var(--color-text-light);
    align-self: center;
  }

  .agenda-cell {
    min-height: 58px;
    border-radius: 6px;
    background: var(--color-slot);
    padding: 7px;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 600;
  }

  .agenda-cell.is-booked {
    background: var(--color-booked);
    color: var(--color-booked-ink);
    animation: book 0.45s ease-out both;
    animation-delay: calc(0.35s + var(--order) * 0.28s);
  }

  @keyframes book {
    from {
      background: var(--color-slot);
      color: transparent;
      transform: scale(0.94);
    }
    to {
      transform: scale(1);
    }
  }

  .agenda-bubble {
    margin-top: 16px;
    margin-inline-start: auto;
    max-width: 85%;
    background: #dcf8c6;
    color: #10251d;
    border-radius: 12px 12px 4px 12px;
    padding: 10px 14px;
    animation: bubble 0.4s ease-out 2.8s both;
  }

  [dir="rtl"] .agenda-bubble {
    border-radius: 12px 12px 12px 4px;
  }

  .agenda-bubble-from {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: #1f7a4d;
  }

  .agenda-bubble p {
    margin: 2px 0 0;
    font-size: 14px;
    line-height: 1.45;
  }

  @keyframes bubble {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .agenda-cell.is-booked,
    .agenda-bubble {
      animation: none;
    }
  }

  @media (max-width: 960px) {
    .hero2-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .hero2 {
      padding: 36px 0 56px;
    }

    .hero2-inner {
      width: calc(100% - 40px);
    }

    .hero2-title {
      font-size: 38px;
    }

    .hero2-line {
      font-size: 17px;
    }

    .hero2-desc {
      font-size: 15px;
    }

    .hero2-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero2-btn {
      justify-content: center;
    }

    .hero2-wa {
      justify-content: center;
    }

    .agenda {
      padding: 16px;
    }

    /* Three days are enough to read on a phone */
    .agenda-grid {
      grid-template-columns: 30px repeat(3, minmax(0, 1fr));
    }

    .agenda-col-3,
    .agenda-col-4,
    .agenda-col-5 {
      display: none;
    }

    .agenda-cell {
      min-height: 52px;
      font-size: 12px;
    }
  }
</style>
