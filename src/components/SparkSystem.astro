---
import { Image } from "astro:assets";
import heroDashboard from "../assets/images/hero/hero-dashboard.webp";

const steps = [
  {
    number: "01",
    serviceKey: "step1Service",
    titleKey: "step1Title",
    nameKey: "step1Name",
    descKey: "step1Desc",
    service: "ACQUISITION LOCALISÉE",
    title: "CIBLAGE DÉDIÉ",
    name: "Publicités Ciblées Santé & Beauté",
    description: "Nous diffusons vos offres auprès des personnes habitant à proximité de votre centre ou cabinet.",
  },
  {
    number: "02",
    serviceKey: "step2Service",
    titleKey: "step2Title",
    nameKey: "step2Name",
    descKey: "step2Desc",
    service: "CONVERSION DIRECTE",
    title: "OFFRE ATTRACTIVE",
    name: "Mise en Valeur de vos Soins",
    description: "Présentation claire de vos expertises (Laser, Injection, Rééducation, Cures) pour déclencher l'intérêt.",
  },
  {
    number: "03",
    serviceKey: "step3Service",
    titleKey: "step3Title",
    nameKey: "step3Name",
    descKey: "step3Desc",
    service: "CONTACT EXPRESS",
    title: "WHATSAPP DIRECT",
    name: "Échange Direct Sans Intermédiaire",
    description: "La patiente clique et ouvre directement une conversation WhatsApp avec votre secrétariat.",
  },
  {
    number: "04",
    serviceKey: "step4Service",
    titleKey: "step4Title",
    nameKey: "step4Name",
    descKey: "step4Desc",
    service: "FIDÉLISATION",
    title: "RDV CONFIRMÉ",
    name: "Confirmation & Agenda Rempli",
    description: "Votre équipe valide l'heure du soin. Moins d'annulations, des créneaux optimisés.",
  },
];
---

<section id="system" class="system-section" aria-labelledby="system-title">
  <div class="system-container">
    <!-- HEADER -->
    <header class="outcome-header">
      <div class="section-eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span data-i18n="systemEyebrow">LE SYSTÈME SPARK</span>
      </div>

      <div class="outcome-layout">
        <div class="outcome-copy">
          <span class="section-index" data-i18n="systemIndex">COMMENT ÇA MARCHE</span>
          <h2 id="system-title">
            <span data-i18n="systemTitleMain">Un processus en 4 étapes</span><br />
            <span data-i18n="systemTitleHighlight">simple & automatique.</span>
          </h2>
        </div>

        <div class="outcome-description">
          <p data-i18n="systemDesc">
            Nous avons supprimé tout ce qui est inutile : pas de tunnels de vente complexes, pas de formulaires interminables. Un parcours direct de la publicité au message WhatsApp.
          </p>
          <a href="#offer" class="outcome-link">
            <span data-i18n="systemCta">Découvrir le tarif fixe</span>
            <span class="outcome-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <!-- VISUAL DASHBOARD STORY -->
    <div class="story">
      <div class="story-image">
        <Image
          src={heroDashboard}
          alt="Tableau de bord de suivi des rendez-vous Spark"
          width={800}
          height={500}
        />
        <div class="story-overlay"></div>
        <div class="story-topline">
          <span class="story-status-dot"></span>
          <span data-i18n="dashboardTop">SUIVI EN TEMPS RÉEL</span>
        </div>
        <div class="story-caption">
          <span class="caption-label" data-i18n="dashboardLabel">VOTRE AGENDA EN UN COUP D'ŒIL</span>
          <strong data-i18n="dashboardTitle">Demandes WhatsApp Qualifiées</strong>
        </div>
      </div>

      <div class="story-side">
        <span class="story-side-label" data-i18n="storySideLabel">SIMPLICITÉ D'UTILISATION</span>
        <h3>
          <span data-i18n="storySideTitleMain">Vous recevez des messages,</span><br />
          <span data-i18n="storySideTitleHighlight">vous confirmez les soins.</span>
        </h3>
        <p data-i18n="storySideDesc">
          Chaque prospect arrive pré-qualifié avec le soin souhaité. Votre équipe n'a plus qu'à fixer la date.
        </p>

        <div class="story-flow">
          <div class="flow-item">
            <span class="flow-number">1</span>
            <span data-i18n="flow1">Message WhatsApp Reçu</span>
          </div>
          <div class="flow-item">
            <span class="flow-number">2</span>
            <span data-i18n="flow2">Proposition du Créneau</span>
          </div>
          <div class="flow-item">
            <span class="flow-number">3</span>
            <span data-i18n="flow3">Rendez-vous Inscrit à l'Agenda</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 4 STEPS GRID -->
    <div class="process">
      {steps.map((step) => (
        <div class="process-step">
          <div class="process-top">
            <span class="process-number">{step.number}</span>
            <span class="process-service" data-i18n={step.serviceKey}>{step.service}</span>
          </div>
          <div>
            <span class="process-title" data-i18n={step.titleKey}>{step.title}</span>
            <h4 data-i18n={step.nameKey}>{step.name}</h4>
            <p data-i18n={step.descKey}>{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .system-section {
    position: relative;
    background: var(--color-bg-light);
    color: var(--color-text-main);
    padding: 100px 0;
    border-top: 1px solid var(--color-border);
    transition: var(--theme-transition);
  }

  [dir="rtl"] .system-section {
    text-align: right;
  }

  .system-container {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-teal);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    margin-bottom: 16px;
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background: var(--color-teal);
  }

  .outcome-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: flex-end;
    margin-bottom: 50px;
  }

  .section-index {
    display: block;
    font-size: 10px;
    font-weight: 800;
    color: var(--color-text-light);
    letter-spacing: 0.1em;
    margin-bottom: 10px;
  }

  .outcome-copy h2 {
    margin: 0;
    font-size: clamp(38px, 4.5vw, 60px);
    font-weight: 800;
    line-height: 1.05;
    color: var(--color-primary);
    letter-spacing: -0.03em;
  }

  .outcome-copy h2 span {
    display: block;
    color: var(--color-teal);
  }

  .outcome-description p {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .outcome-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
  }

  [dir="rtl"] .outcome-arrow {
    transform: rotate(180deg);
  }

  .outcome-link:hover {
    color: var(--color-teal);
  }

  .story {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    margin-bottom: 50px;
    transition: var(--theme-transition);
  }

  .story-image {
    position: relative;
    min-height: 380px;
  }

  .story-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 37, 64, 0.1) 0%, rgba(10, 37, 64, 0.7) 100%);
  }

  .story-topline {
    position: absolute;
    top: 20px;
    left: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(10, 37, 64, 0.75);
    backdrop-filter: blur(10px);
    padding: 6px 14px;
    border-radius: 99px;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
  }

  [dir="rtl"] .story-topline {
    left: auto;
    right: 20px;
  }

  .story-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #25d366;
  }

  .story-caption {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    color: #ffffff;
  }

  .caption-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #64eeea;
  }

  .story-caption strong {
    display: block;
    font-size: 22px;
    font-weight: 800;
    margin-top: 4px;
  }

  .story-side {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .story-side-label {
    font-size: 10px;
    font-weight: 800;
    color: var(--color-text-light);
    letter-spacing: 0.1em;
  }

  .story-side h3 {
    font-size: 24px;
    font-weight: 800;
    color: var(--color-primary);
    margin: 8px 0;
  }

  .story-side h3 span {
    color: var(--color-teal);
  }

  .story-side p {
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .story-flow {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .flow-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-main);
    padding: 8px 12px;
    background: var(--color-surface-hover);
    border-radius: 10px;
    border: 1px solid var(--color-border);
  }

  .flow-number {
    font-size: 11px;
    font-weight: 800;
    color: var(--color-teal);
    background: var(--color-teal-soft);
    padding: 2px 8px;
    border-radius: 6px;
  }

  .process {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .process-step {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: var(--theme-transition);
  }

  .process-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .process-number {
    font-size: 14px;
    font-weight: 800;
    color: var(--color-teal);
  }

  .process-service {
    font-size: 9px;
    font-weight: 800;
    color: var(--color-text-muted);
    background: var(--color-surface-hover);
    padding: 4px 8px;
    border-radius: 6px;
    letter-spacing: 0.05em;
  }

  .process-title {
    font-size: 10px;
    font-weight: 800;
    color: var(--color-text-light);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 4px;
  }

  .process-step h4 {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .process-step p {
    margin: 0;
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .story, .outcome-layout {
      grid-template-columns: 1fr;
    }
    .process {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .process {
      grid-template-columns: 1fr;
    }
  }
</style>