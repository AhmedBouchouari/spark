---
import { Image } from "astro:assets";
import sparkLogo from "../assets/images/logo/spark-logo2 (2).png";
import { translations } from "../data/translations";

const t = translations.fr;
const waBase = import.meta.env.PUBLIC_WHATSAPP_URL || "https://wa.me/212605767055";
const whatsappUrl = `${waBase}?text=${encodeURIComponent(t.whatsappMessage)}`;

const navigation = [
  { labelKey: "navSystem", href: "#hero", label: "Accueil" },
  { labelKey: "navSystem", href: "#system", label: "Le système" },
  { labelKey: "navOffer", href: "#offer", label: "L'offre" },
  { labelKey: "navTestimonials", href: "#testimonials", label: "Témoignages" },
  { labelKey: "navWhySpark", href: "#why-spark", label: "Pourquoi Spark" },
  { labelKey: "navContact", href: "#contact-form", label: "Contact" },
];

const services = [
  { key: "s1", label: "Acquisition Centres Esthétiques" },
  { key: "s2", label: "Acquisition Médecine Esthétique" },
  { key: "s3", label: "Acquisition Cabinets de Kinésithérapie" },
  { key: "s4", label: "Système de Relance WhatsApp" },
];
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-grid">
      <!-- BRAND -->
      <div class="footer-brand">
        <a href="#hero" class="logo" aria-label="Spark — Accueil">
          <Image
            src={sparkLogo}
            alt="Spark Growth System"
            class="logo-image"
            width={150}
            height={45}
          />
        </a>

        <p class="brand-description" data-i18n="footerBrandDesc">
          Système d'acquisition dédié aux Centres d'Esthétique, Médecins Esthétiques et Cabinets de Kinésithérapie.
        </p>

        <div class="brand-status">
          <span class="status-dot"></span>
          <span data-i18n="footerBrandStatus">HEALTH & BEAUTY GROWTH SYSTEM</span>
        </div>
      </div>

      <!-- NAVIGATION -->
      <div class="footer-column">
        <span class="column-label" data-i18n="footerNavLabel">NAVIGATION</span>
        <nav class="footer-links">
          {navigation.map((item) => (
            <a href={item.href}>
              <span data-i18n={item.labelKey}>{item.label}</span>
              <span>↗</span>
            </a>
          ))}
        </nav>
      </div>

      <!-- SERVICES / NICHES -->
      <div class="footer-column">
        <span class="column-label" data-i18n="footerSpecLabel">SPÉCIALITÉS</span>
        <div class="service-list">
          {services.map((service) => (
            <span data-i18n={service.key}>{service.label}</span>
          ))}
        </div>
      </div>

      <!-- CONTACT -->
      <div class="footer-column footer-contact">
        <span class="column-label" data-i18n="footerContactLabel">CONTACT DIRECT</span>
        <a href="#contact-form" class="contact-link contact-link--form">
          <span data-i18n="footerContactLink">Formulaire de contact</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-link contact-link--wa" data-whatsapp-link>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14" fill="currentColor">
            <path d="M12.012 2c-5.506 0-9.989 4.478-9.989 9.984 0 1.758.459 3.413 1.264 4.852l-1.341 4.9 5.019-1.316c1.393.759 2.977 1.189 4.647 1.189 5.506 0 9.989-4.478 9.989-9.989 0-5.506-4.483-9.984-9.989-9.984zm5.789 14.129c-.244.685-1.42 1.309-1.961 1.365-.494.052-1.139.076-3.298-.813-2.76-1.137-4.542-3.948-4.68-4.133-.137-.184-1.121-1.492-1.121-2.845 0-1.353.709-2.018.961-2.285.252-.267.551-.334.734-.334.184 0 .367.002.527.009.171.008.4.004.596.474.206.494.708 1.728.77 1.854.062.126.103.275.02.438-.083.163-.125.267-.247.412-.122.145-.258.324-.367.435-.122.122-.25.254-.108.497.142.244.631 1.042 1.354 1.686.93.829 1.714 1.087 1.958 1.209.244.122.387.103.53-.061.143-.164.618-.72.783-.967.165-.247.33-.206.556-.122.226.084 1.439.678 1.686.802.247.124.412.185.473.288.061.103.061.602-.183 1.287z"/>
          </svg>
          <span data-i18n="footerContactWa">WhatsApp direct</span>
        </a>
        <p data-i18n="footerContactNote">
          Réponse rapide sous 5 minutes par notre équipe spécialisée.
        </p>
      </div>
    </div>
  </div>

  <!-- FOOTER BOTTOM -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span data-i18n="copyright">© {new Date().getFullYear()} SPARK. TOUS DROITS RÉSERVÉS.</span>
      <div class="bottom-links">
        <a href="#" data-i18n="legal1">Mentions légales</a>
        <a href="#" data-i18n="legal2">Politique de confidentialité</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #061527;
    color: #ffffff;
    font-size: 13px;
    transition: var(--theme-transition);
  }

  [dir="rtl"] .site-footer {
    text-align: right;
  }

  [data-theme="dark"] .site-footer {
    background: #030810;
  }

  .footer-main {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 70px 0;
  }

  .footer-grid {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1fr;
    gap: 50px;
  }

  .logo-image {
    height: 38px;
    width: auto;
  }

  .brand-description {
    margin: 16px 0;
    font-size: 13px;
    color: #94a3b8;
    line-height: 1.6;
  }

  .brand-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 800;
    color: #64eeea;
    letter-spacing: 0.1em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #25d366;
  }

  .column-label {
    font-size: 11px;
    font-weight: 800;
    color: #64eeea;
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 20px;
  }

  .footer-links, .service-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 180ms ease;
    display: flex;
    justify-content: space-between;
  }

  .footer-links a:hover {
    color: #64eeea;
  }

  .service-list span {
    color: #94a3b8;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    transition: opacity 180ms ease;
    margin-bottom: 6px;
  }

  .contact-link--form {
    color: #64eeea;
  }

  .contact-link--wa {
    color: #25d366;
  }

  .contact-link:hover {
    opacity: 0.8;
  }

  .footer-contact p {
    font-size: 12px;
    color: #64748b;
    margin-top: 10px;
  }

  .footer-bottom {
    background: #030a13;
    padding: 20px 0;
  }

  .footer-bottom-inner {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #64748b;
  }

  .bottom-links a {
    color: #64748b;
    margin-left: 20px;
    text-decoration: none;
  }

  [dir="rtl"] .bottom-links a {
    margin-left: 0;
    margin-right: 20px;
  }

  .bottom-links a:hover {
    color: #cbd5e1;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom-inner {
      flex-direction: column;
      gap: 10px;
    }
    .bottom-links a {
      margin-left: 0;
      margin-right: 16px;
    }
  }
</style>
