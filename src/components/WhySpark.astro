---
const differentiators = [
  {
    number: "01",
    labelKey: "d1Label",
    titleKey: "d1Title",
    descKey: "d1Desc",
    label: "SPÉCIALISATION",
    title: "Uniquement Beauté & Santé.",
    description: "Nous connaissons les spécificités des centres d'esthétique, médecins esthétiques et cabinets de kinésithérapie.",
  },
  {
    number: "02",
    labelKey: "d2Label",
    titleKey: "d2Title",
    descKey: "d2Desc",
    label: "RÉSULTATS",
    title: "Des rendez-vous, pas des likes.",
    description: "Toutes nos actions ont pour unique but de générer des demandes WhatsApp de patientes motivées.",
  },
  {
    number: "03",
    labelKey: "d3Label",
    titleKey: "d3Title",
    descKey: "d3Desc",
    label: "SIMPLICITÉ",
    title: "Zéro charge mentale.",
    description: "Aucun outil complexe à apprendre. Nous nous occupons de l'ensemble du système d'acquisition.",
  },
  {
    number: "04",
    labelKey: "d4Label",
    titleKey: "d4Title",
    descKey: "d4Desc",
    label: "TRANSPARENCE",
    title: "Sans engagement.",
    description: "Un tarif clair de 1 500 DH/mois, annulable à tout moment si vous n'êtes pas satisfait.",
  },
];
---

<section id="why-spark" class="why-spark">
  <div class="container">
    <!-- HEADER -->
    <header class="section-header">
      <!-- FORCE SINGLE LINE EYEBROW WITH MARGIN BOTTOM SPACING -->
      <div class="eyebrow inline-flex items-center gap-2 mb-6 whitespace-nowrap text-xs font-extrabold tracking-widest text-[#00a896] dark:text-[#64eeea] uppercase">
        <span class="eyebrow-line w-6 h-0.5 bg-[#00a896] dark:bg-[#64eeea] shrink-0"></span>
        <span class="eyebrow-text whitespace-nowrap inline-block" data-i18n="whyEyebrow">POURQUOI CHOISIR SPARK</span>
      </div>

      <div class="header-grid">
        <div>
          <h2>
            <span data-i18n="whyTitleMain">Pas une agence</span><br />
            <em data-i18n="whyTitleHighlight">généraliste.</em>
          </h2>

          <p class="lead" data-i18n="whyLead">
            Un partenaire spécialisé pour Centres d'Esthétique, Médecins & Kinés.
          </p>
        </div>

        <p class="intro" data-i18n="whyIntro">
          Les agences classiques ne comprennent pas vos contraintes d'agenda ni les exigences de votre patientèle. Nous avons développé un modèle direct et éprouvé.
        </p>
      </div>
    </header>

    <!-- DIFFERENTIATORS GRID -->
    <div class="differentiators">
      {differentiators.map((item) => (
        <article class="differentiator">
          <div class="top">
            <span>{item.number}</span>
            <span data-i18n={item.labelKey}>{item.label}</span>
          </div>

          <div class="content">
            <h3 data-i18n={item.titleKey}>{item.title}</h3>
            <p data-i18n={item.descKey}>{item.description}</p>
          </div>

          <span class="line"></span>
        </article>
      ))}
    </div>

    <!-- MANIFESTO -->
    <div class="manifesto">
      <span class="manifesto-label" data-i18n="manifestoLabel">NOTRE PHILOSOPHIE</span>
      <div class="manifesto-content">
        <p data-i18n="manifestoP">Vous n'avez pas besoin d'une agence qui promet tout.</p>
        <strong data-i18n="manifestoStrong">Vous avez besoin d'un système qui remplit votre agenda.</strong>
      </div>
      <span class="signature" data-i18n="signature">SPARK GROWTH SYSTEM /</span>
    </div>
  </div>
</section>

<style>
  .why-spark {
    background: var(--color-bg-light);
    color: var(--color-text-main);
    padding: 100px 0;
    border-top: 1px solid var(--color-border);
    transition: var(--theme-transition);
  }

  [dir="rtl"] .why-spark {
    text-align: right;
  }

  .container {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 50px;
  }

  /* STRICT SINGLE LINE EYEBROW NO-WRAP FIX */
  .eyebrow {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    letter-spacing: 0.15em !important;
    color: var(--color-teal) !important;
    margin-bottom: 24px !important;
    white-space: nowrap !important;
    flex-wrap: nowrap !important;
    max-width: 100% !important;
    overflow: visible !important;
  }

  .eyebrow-line {
    width: 24px;
    height: 2px;
    background: var(--color-teal);
    flex-shrink: 0;
  }

  .eyebrow-text {
    white-space: nowrap !important;
    display: inline-block !important;
  }

  .header-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 60px;
    align-items: flex-end;
  }

  h2 {
    margin: 0;
    font-size: clamp(38px, 4.5vw, 60px);
    font-weight: 800;
    line-height: 1.05;
    color: var(--color-primary);
    letter-spacing: -0.03em;
  }

  h2 em {
    font-style: normal;
    color: var(--color-teal);
  }

  .lead {
    margin: 16px 0 0;
    font-size: 18px;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .intro {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .differentiators {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 60px;
  }

  .differentiator {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 24px;
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: var(--theme-transition);
  }

  .top {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 800;
    color: var(--color-teal);
    margin-bottom: 30px;
  }

  .content h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 800;
    color: var(--color-primary);
  }

  .content p {
    margin: 0;
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .line {
    position: absolute;
    bottom: 24px;
    left: 24px;
    width: 24px;
    height: 2px;
    background: var(--color-teal);
  }

  [dir="rtl"] .line {
    left: auto;
    right: 24px;
  }

  .manifesto {
    background: linear-gradient(135deg, #0a2540 0%, #0f4c81 100%);
    border-radius: 24px;
    padding: 40px 50px;
    color: #ffffff;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  [data-theme="dark"] .manifesto {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(100, 238, 234, 0.2);
  }

  .manifesto-label {
    font-size: 10px;
    font-weight: 800;
    color: #64eeea;
    letter-spacing: 0.15em;
  }

  .manifesto-content p {
    margin: 0;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.8);
  }

  .manifesto-content strong {
    font-size: 22px;
    color: #ffffff;
    font-weight: 800;
    display: block;
    margin-top: 4px;
  }

  .signature {
    font-size: 11px;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.1em;
  }

  @media (max-width: 1024px) {
    .differentiators {
      grid-template-columns: repeat(2, 1fr);
    }
    .header-grid, .manifesto {
      grid-template-columns: 1fr;
      flex-direction: column;
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .differentiators {
      grid-template-columns: 1fr;
    }
    .manifesto {
      padding: 30px 20px;
    }
  }
</style>