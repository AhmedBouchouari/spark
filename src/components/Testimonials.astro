---
const stats = [
  { valKey: "m1Val", labelKey: "m1Label", noteKey: "m1Note", value: "+35%", label: "De Rendez-vous Confirmés", note: "Moyenne constatée à 30 jours" },
  { valKey: "m2Val", labelKey: "m2Label", noteKey: "m2Note", value: "30+", label: "Praticiens & Centres", note: "Médecins, Kinés, Esthétique" },
  { valKey: "m3Val", labelKey: "m3Label", noteKey: "m3Note", value: "98%", label: "Taux de Satisfaction", note: "Renouvellement mensuel" },
  { valKey: "m4Val", labelKey: "m4Label", noteKey: "m4Note", value: "0", label: "Contrat d'Engagement", note: "Liberté totale & sans contrainte" },
];

const caseStudies = [
  {
    catKey: "c1Cat",
    nameKey: "c1Name",
    detailKey: "c1Detail",
    locKey: "c1Loc",
    resKey: "c1Res",
    category: "Médecine Esthétique",
    name: "Dr. Amina Benjelloun",
    detail: "Médecine Anti-âge & Esthétique",
    location: "Casablanca",
    result: "+40% de consultations laser & injections",
  },
  {
    catKey: "c2Cat",
    nameKey: "c2Name",
    detailKey: "c2Detail",
    locKey: "c2Loc",
    resKey: "c2Res",
    category: "Kinésithérapie",
    name: "Centre Kiné & Sport",
    detail: "Rééducation & Kiné du Sport",
    location: "Rabat",
    result: "Agenda complet à 2 semaines d'avance",
  },
  {
    catKey: "c3Cat",
    nameKey: "c3Name",
    detailKey: "c3Detail",
    locKey: "c3Loc",
    resKey: "c3Res",
    category: "Centre d'Esthétique",
    name: "Maison Éclat Esthétique",
    detail: "Cures Visage & Soins Corps",
    location: "Marrakech",
    result: "+28 nouvelles clientes par mois",
  },
];
---

<section id="testimonials" class="testimonials-section" aria-labelledby="testimonials-title">
  <div class="testimonials-container">
    <!-- SECTION HEADER -->
    <header class="testimonials-header">
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        <span data-i18n="testimonialsEyebrow">PREUVES & RÉSULTATS</span>
      </div>
      <h2 id="testimonials-title" class="testimonials-h2">
        <span data-i18n="testimonialsTitleMain">Ce que disent</span>
        <em data-i18n="testimonialsTitleHighlight">nos praticiens & directeurs.</em>
      </h2>
      <p class="testimonials-lead" data-i18n="testimonialsDesc">
        Des résultats mesurables pour des cabinets médicalisés, centres de soins et cabinets de kinésithérapie au Maroc.
      </p>
    </header>

    <!-- STATS GRID (4 METRICS) -->
    <div class="stats-grid">
      {stats.map((stat) => (
        <div class="stat-card">
          <span class="stat-value font-mono" data-i18n={stat.valKey}>
            {stat.value}
          </span>
          <div class="stat-body">
            <h3 class="stat-label" data-i18n={stat.labelKey}>
              {stat.label}
            </h3>
            <p class="stat-note" data-i18n={stat.noteKey}>
              {stat.note}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- FEATURED MAIN TESTIMONIAL CARD (Dr. Amina Benjelloun) -->
    <div class="featured-card">
      <div class="featured-watermark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>
      </div>

      <div class="featured-content">
        <div class="featured-badge">
          <span>✓</span>
          <span data-i18n="featuredVerified">Cabinet Partenaire Vérifié SPARK</span>
        </div>

        <blockquote class="featured-quote">
          "<span data-i18n="mainQuoteText">Avant Spark, nous avions des likes mais peu de vrais rendez-vous. Aujourd'hui, les patientes nous contactent directement sur WhatsApp pour réserver leurs séances. Notre agenda s'est rempli très naturellement sans qu'on passe nos journées au téléphone.</span>"
        </blockquote>

        <div class="featured-author">
          <div class="avatar-circle">AB</div>
          <div>
            <h4 class="author-name" data-i18n="mainAuthor">Dr. Amina Benjelloun</h4>
            <p class="author-role" data-i18n="mainRole">Médecin Esthétique & Laser · Casablanca</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SECONDARY CASE STUDIES GRID (3 NICHE CARDS) -->
    <div class="cases-grid">
      {caseStudies.map((item) => (
        <div class="case-card">
          <div class="case-top">
            <span class="case-category" data-i18n={item.catKey}>{item.category}</span>
            <span class="case-location" data-i18n={item.locKey}>{item.location}</span>
          </div>

          <div class="case-body">
            <h4 class="case-name" data-i18n={item.nameKey}>{item.name}</h4>
            <p class="case-detail" data-i18n={item.detailKey}>{item.detail}</p>
          </div>

          <div class="case-result">
            <span class="result-arrow" aria-hidden="true">↗</span>
            <span data-i18n={item.resKey}>{item.result}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    position: relative;
    background: var(--color-bg-light);
    color: var(--color-text-main);
    padding: 100px 0;
    border-top: 1px solid var(--color-border);
    transition: var(--theme-transition);
  }

  [dir="rtl"] .testimonials-section {
    text-align: right;
  }

  .testimonials-container {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .testimonials-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--color-teal);
    margin-bottom: 16px;
    white-space: nowrap;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-teal);
  }

  .testimonials-h2 {
    margin: 0 0 16px;
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }

  .testimonials-h2 em {
    font-style: normal;
    color: var(--color-teal);
    display: block;
  }

  .testimonials-lead {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* STATS GRID */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .stat-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: transform 200ms ease, box-shadow 200ms ease, var(--theme-transition);
  }

  .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-teal);
  }

  .stat-value {
    font-size: clamp(36px, 3.5vw, 48px);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-body {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  .stat-label {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-note {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* FEATURED CARD */
  .featured-card {
    position: relative;
    background: linear-gradient(135deg, #0a2540 0%, #0d3154 50%, #0f4c81 100%);
    border-radius: 24px;
    padding: 48px;
    color: #ffffff;
    overflow: hidden;
    box-shadow: 0 20px 45px -15px rgba(10, 37, 64, 0.25);
  }

  [data-theme="dark"] .featured-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border: 1px solid rgba(100, 238, 234, 0.2);
  }

  .featured-watermark {
    position: absolute;
    top: 24px;
    right: 24px;
    opacity: 0.12;
    width: 100px;
    height: 100px;
    pointer-events: none;
  }

  [dir="rtl"] .featured-watermark {
    right: auto;
    left: 24px;
  }

  .featured-content {
    position: relative;
    z-index: 2;
    max-width: 840px;

  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 99px;
    background: rgba(0, 168, 150, 0.2);
    border: 1px solid rgba(0, 168, 150, 0.3);
    color: #64eeea;
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .featured-quote {
    margin: 0 0 28px;
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 500;
    line-height: 1.6;
    color: #ffffff;
    font-style: italic;
  }

  .featured-author {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .avatar-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #00a896 0%, #64eeea 100%);
    color: #0a2540;
    font-size: 18px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-name {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    color: #ffffff;
  }

  .author-role {
    margin: 2px 0 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
  }

  /* CASES GRID */
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .case-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    box-shadow: var(--shadow-sm);
    transition: transform 200ms ease, box-shadow 200ms ease, var(--theme-transition);
  }

  .case-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-teal);
  }

  .case-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
  }

  .case-category {
    font-weight: 800;
    color: var(--color-teal);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .case-location {
    color: var(--color-text-light);
    font-weight: 600;
  }

  .case-name {
    margin: 6px 0 2px;
    font-size: 17px;
    font-weight: 800;
    color: var(--color-primary);
  }

  .case-detail {
    margin: 0;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .case-result {
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-teal);
    font-size: 13px;
    font-weight: 700;
  }

  .result-arrow {
    font-size: 15px;
  }

  [dir="rtl"] .result-arrow {
    transform: rotate(90deg);
  }

  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .cases-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
    .featured-card {
      padding: 30px 20px;
    }
  }
</style>