---
import Layout from "./Layout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={`${title} — SPARK`} description={`${title} du site SPARK.`}>
  <main class="legal">
    <a href="/" class="legal-back">← Retour à l'accueil</a>
    <h1>{title}</h1>
    <p class="legal-ar" dir="rtl" lang="ar">هذه الصفحة متوفرة باللغة الفرنسية فقط.</p>
    <div class="legal-body">
      <slot />
    </div>
  </main>
</Layout>

<style>
  .legal {
    width: min(760px, calc(100% - 32px));
    margin: 0 auto;
    padding: 60px 0 100px;
    color: var(--color-text-main);
    line-height: 1.7;
  }

  .legal-back {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-teal);
  }

  h1 {
    margin: 24px 0 8px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: clamp(30px, 5vw, 42px);
    line-height: 1.15;
  }

  .legal-ar {
    margin: 0 0 32px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .legal-body :global(h2) {
    margin: 36px 0 8px;
    font-size: 20px;
  }

  .legal-body :global(p),
  .legal-body :global(li) {
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .legal-body :global(mark) {
    background: var(--color-gold-soft);
    color: var(--color-text-main);
    padding: 0 4px;
    border-radius: 4px;
  }
</style>
