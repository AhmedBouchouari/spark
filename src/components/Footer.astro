---
import { Image } from "astro:assets";
import sparkLogo from "../assets/images/logo/spark-logo2.png";

const navigation = [
  { labelKey: "navSystem", href: "#hero", label: "Accueil" },
  { labelKey: "navSystem", href: "#system", label: "Le système" },
  { labelKey: "navOffer", href: "#offer", label: "L'offre" },
  { labelKey: "navTestimonials", href: "#testimonials", label: "Témoignages" },
  { labelKey: "navWhySpark", href: "#why-spark", label: "Pourquoi Spark" },
];

const services = [
  { key: "s1", label: "Acquisition Centres Esthétiques" },
  { key: "s2", label: "Acquisition Médecine Esthétique" },
  { key: "s3", label: "Acquisition Cabinets de Kinésithérapie" },
  { key: "s4", label: "Système de Relance WhatsApp" },
];
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-grid">
      <!-- BRAND -->
      <div class="footer-brand">
        <a href="#hero" class="logo" aria-label="Spark — Accueil">
          <Image
            src={sparkLogo}
            alt="Spark Growth System"
            class="logo-image"
            width={150}
            height={45}
          />
        </a>

        <p class="brand-description" data-i18n="footerBrandDesc">
          Système d'acquisition dédié aux Centres d'Esthétique, Médecins Esthétiques et Cabinets de Kinésithérapie.
        </p>

        <div class="brand-status">
          <span class="status-dot"></span>
          <span data-i18n="footerBrandStatus">HEALTH & BEAUTY GROWTH SYSTEM</span>
        </div>
      </div>

      <!-- NAVIGATION -->
      <div class="footer-column">
        <span class="column-label" data-i18n="footerNavLabel">NAVIGATION</span>
        <nav class="footer-links">
          {navigation.map((item) => (
            <a href={item.href}>
              <span data-i18n={item.labelKey}>{item.label}</span>
              <span>↗</span>
            </a>
          ))}
        </nav>
      </div>

      <!-- SERVICES / NICHES -->
      <div class="footer-column">
        <span class="column-label" data-i18n="footerSpecLabel">SPÉCIALITÉS</span>
        <div class="service-list">
          {services.map((service) => (
            <span data-i18n={service.key}>{service.label}</span>
          ))}
        </div>
      </div>

      <!-- CONTACT -->
      <div class="footer-column footer-contact">
        <span class="column-label" data-i18n="footerContactLabel">CONTACT DIRECT</span>
        <a href="#contact" class="contact-link">
          <span data-i18n="footerContactLink">Discuter sur WhatsApp</span> <span>↗</span>
        </a>
        <p data-i18n="footerContactNote">
          Réponse rapide sous 5 minutes par notre équipe spécialisée.
        </p>
      </div>
    </div>
  </div>

  <!-- FOOTER BOTTOM -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span data-i18n="copyright">© {new Date().getFullYear()} SPARK. TOUS DROITS RÉSERVÉS.</span>
      <div class="bottom-links">
        <a href="#" data-i18n="legal1">Mentions légales</a>
        <a href="#" data-i18n="legal2">Politique de confidentialité</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #061527;
    color: #ffffff;
    font-size: 13px;
    transition: var(--theme-transition);
  }

  [dir="rtl"] .site-footer {
    text-align: right;
  }

  [data-theme="dark"] .site-footer {
    background: #030810;
  }

  .footer-main {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 70px 0;
  }

  .footer-grid {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1fr;
    gap: 50px;
  }

  .logo-image {
    height: 38px;
    width: auto;
  }

  .brand-description {
    margin: 16px 0;
    font-size: 13px;
    color: #94a3b8;
    line-height: 1.6;
  }

  .brand-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 800;
    color: #64eeea;
    letter-spacing: 0.1em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #25d366;
  }

  .column-label {
    font-size: 11px;
    font-weight: 800;
    color: #64eeea;
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 20px;
  }

  .footer-links, .service-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 180ms ease;
    display: flex;
    justify-content: space-between;
  }

  .footer-links a:hover {
    color: #64eeea;
  }

  .service-list span {
    color: #94a3b8;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #25d366;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
  }

  .footer-contact p {
    font-size: 12px;
    color: #64748b;
    margin-top: 10px;
  }

  .footer-bottom {
    background: #030a13;
    padding: 20px 0;
  }

  .footer-bottom-inner {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #64748b;
  }

  .bottom-links a {
    color: #64748b;
    margin-left: 20px;
    text-decoration: none;
  }

  [dir="rtl"] .bottom-links a {
    margin-left: 0;
    margin-right: 20px;
  }

  .bottom-links a:hover {
    color: #cbd5e1;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom-inner {
      flex-direction: column;
      gap: 10px;
    }
    .bottom-links a {
      margin-left: 0;
      margin-right: 16px;
    }
  }
</style>
