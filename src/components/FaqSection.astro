---
import { translations } from "../data/translations";
const t = translations.fr;

const steps = [1, 2, 3, 4].map((n) => ({
  dayKey: `tl${n}Day`,
  titleKey: `tl${n}Title`,
  descKey: `tl${n}Desc`,
  day: t[`tl${n}Day` as keyof typeof t] as string,
  title: t[`tl${n}Title` as keyof typeof t] as string,
  desc: t[`tl${n}Desc` as keyof typeof t] as string,
}));

const faqs = [1, 2, 3, 4, 5, 6].map((n) => ({
  qKey: `faqQ${n}`,
  aKey: `faqA${n}`,
  q: t[`faqQ${n}` as keyof typeof t] as string,
  a: t[`faqA${n}` as keyof typeof t] as string,
}));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="faq-container">

    <!-- TIMELINE -->
    <div class="timeline-block">
      <div class="eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span data-i18n="tlEyebrow">{t.tlEyebrow}</span>
      </div>
      <h2 class="faq-h2">
        <span data-i18n="tlTitleMain">{t.tlTitleMain}</span>
        <em data-i18n="tlTitleHighlight">{t.tlTitleHighlight}</em>
      </h2>

      <ol class="timeline">
        {steps.map((s) => (
          <li class="timeline-step">
            <span class="timeline-dot" aria-hidden="true"></span>
            <span class="timeline-day" data-i18n={s.dayKey}>{s.day}</span>
            <strong data-i18n={s.titleKey}>{s.title}</strong>
            <p data-i18n={s.descKey}>{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>

    <!-- FAQ -->
    <div class="faq-block">
      <div class="faq-heading">
        <div class="eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span data-i18n="faqEyebrow">{t.faqEyebrow}</span>
        </div>
        <h2 id="faq-title" class="faq-h2">
          <span data-i18n="faqTitleMain">{t.faqTitleMain}</span>
          <em data-i18n="faqTitleHighlight">{t.faqTitleHighlight}</em>
        </h2>
      </div>

      <div class="faq-list">
        {faqs.map((f, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary>
              <span data-i18n={f.qKey}>{f.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p data-i18n={f.aKey}>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq {
    background: var(--color-bg-light);
    color: var(--color-text-main);
    padding: 100px 0;
    border-top: 1px solid var(--color-border);
    transition: var(--theme-transition);
  }

  [dir="rtl"] .faq {
    text-align: right;
  }

  .faq-container {
    width: min(var(--container-width), calc(100% - 48px));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 90px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--color-teal);
  }

  .eyebrow-line {
    width: 28px;
    height: 2px;
    background: currentColor;
  }

  .faq-h2 {
    margin: 14px 0 0;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .faq-h2 em {
    display: block;
    font-style: normal;
    color: var(--color-teal);
  }

  /* Timeline */
  .timeline {
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 7px;
    inset-inline: 8px;
    height: 2px;
    background: var(--color-border);
  }

  .timeline-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 30px;
  }

  .timeline-dot {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-teal);
    box-shadow: 0 0 0 5px var(--color-teal-soft);
  }

  .timeline-day {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-teal);
  }

  .timeline-step strong {
    font-size: 17px;
    font-weight: 700;
  }

  .timeline-step p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* FAQ */
  .faq-block {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 60px;
    align-items: start;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: var(--theme-transition);
  }

  .faq-item[open] {
    border-color: var(--color-teal);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-teal);
    transition: transform 0.2s ease;
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-icon::after {
    transform: rotate(0deg);
  }

  .faq-item p {
    margin: 0;
    padding: 0 22px 20px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .timeline {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 32px;
    }

    .timeline::before {
      display: none;
    }

    .faq-block {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 560px) {
    .faq {
      padding: 70px 0;
    }

    .faq-container {
      width: calc(100% - 32px);
      gap: 60px;
    }

    .timeline {
      grid-template-columns: 1fr;
    }

    .faq-item summary {
      padding: 16px 18px;
      font-size: 15px;
    }

    .faq-item p {
      padding: 0 18px 18px;
    }
  }

  /* Calmer typography: no eyebrow labels, no accent word */
  .faq .eyebrow {
    display: none;
  }
  .faq-h2 em {
    color: inherit;
  }
  .faq-h2 {
    margin-top: 0;
  }
</style>
