---
import { Image } from "astro:assets";

import imgBeaute from "../assets/images/hero/Salon de beauté.webp";
import imgMedecin from "../assets/images/hero/Médecin esthétique.webp";
import imgKine from "../assets/images/hero/Cabinet kinésithérapie.webp";

const slides = [
  {
    src: imgBeaute,
    alt: "Salon de beauté et soins",
    key: "heroFooter1",
    label: "SALON DE BEAUTÉ",
    descKey: "heroDescBeaute",
    desc: "Le premier système d'acquisition spécialement conçu pour les Salons de Beauté et Centres de Soins. Transformez votre visibilité en rendez-vous fermes via WhatsApp.",
  },
  {
    src: imgMedecin,
    alt: "Cabinet de médecin esthétique",
    key: "heroFooter2",
    label: "MÉDECINS ESTHÉTIQUES",
    descKey: "heroDescMedecin",
    desc: "Le premier système d'acquisition spécialement conçu pour les Médecins Esthétiques et Cliniques. Transformez votre visibilité en consultations fermes via WhatsApp.",
  },
  {
    src: imgKine,
    alt: "Cabinet de kinésithérapie",
    key: "heroFooter3",
    label: "KINÉSITHÉRAPIE",
    descKey: "heroDescKine",
    desc: "Le premier système d'acquisition spécialement conçu pour les Cabinets de Kinésithérapie et Rééducation. Transformez votre visibilité en séances de soins confirmées via WhatsApp.",
  },
];

const trustBadges = [
  { icon: "calendar", titleKey: "heroTrust1Title", descKey: "heroTrust1Desc", title: "Rendez-vous Qualifiés", desc: "Moins d'annulations" },
  { icon: "whatsapp", titleKey: "heroTrust2Title", descKey: "heroTrust2Desc", title: "Relance WhatsApp", desc: "Conversion immédiate" },
  { icon: "chart", titleKey: "heroTrust3Title", descKey: "heroTrust3Desc", title: "Budget Maîtrisé", desc: "ROI mesurable" },
];

import { translations } from "../data/translations";
const waBase = import.meta.env.PUBLIC_WHATSAPP_URL || "https://wa.me/212605767055";
const whatsappUrl = `${waBase}?text=${encodeURIComponent(translations.fr.whatsappMessage)}`;
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <!-- Background image slideshow -->
  <div class="hero-bg-slider" aria-hidden="true">
    {slides.map((slide, index) => (
      <div class={`slide-item ${index === 0 ? 'active' : ''}`} data-slide-index={index}>
        <Image
          src={slide.src}
          alt={slide.alt}
          class="hero-bg-img"
          loading={index === 0 ? "eager" : "lazy"}
          width={1600}
          height={900}
        />
      </div>
    ))}
    <div class="hero-bg-overlay"></div>
  </div>

  <!-- Subtle mesh pattern -->
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Main container -->
  <div class="hero-container">
    <div class="hero-content">
      <!-- Eyebrow Tag -->
      <div class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        <span class="eyebrow-brand" data-i18n="heroEyebrowBrand">SPARK GROWTH SYSTEM</span>
        <span class="eyebrow-divider">|</span>
        <span class="eyebrow-niche" data-i18n="heroEyebrowNiche">BEAUTÉ • MÉDECINE • KINÉ</span>
      </div>

      <!-- Main Headline -->
      <h1 id="hero-title" class="hero-title">
        <span data-i18n="heroTitleMain">Plus de clientes.</span><br />
        <span class="gradient-text" data-i18n="heroTitleGradient">Un agenda plus rempli.</span>
      </h1>

      <!-- Dynamic Sector-Tailored Descriptions -->
      <div class="hero-descriptions-container">
        {slides.map((slide, index) => (
          <p
            class={`hero-description slide-desc ${index === 0 ? 'active' : ''}`}
            data-slide-desc-index={index}
            data-i18n={slide.descKey}
          >
            {slide.desc}
          </p>
        ))}
      </div>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary" aria-label="Discuter sur WhatsApp" data-whatsapp-link>
          <span class="btn-whatsapp-icon">
            <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current">
              <path d="M12.012 2c-5.506 0-9.989 4.478-9.989 9.984 0 1.758.459 3.413 1.264 4.852l-1.341 4.9 5.019-1.316c1.393.759 2.977 1.189 4.647 1.189 5.506 0 9.989-4.478 9.989-9.989 0-5.506-4.483-9.984-9.989-9.984zm5.789 14.129c-.244.685-1.42 1.309-1.961 1.365-.494.052-1.139.076-3.298-.813-2.76-1.137-4.542-3.948-4.68-4.133-.137-.184-1.121-1.492-1.121-2.845 0-1.353.709-2.018.961-2.285.252-.267.551-.334.734-.334.184 0 .367.002.527.009.171.008.4.004.596.474.206.494.708 1.728.77 1.854.062.126.103.275.02.438-.083.163-.125.267-.247.412-.122.145-.258.324-.367.435-.122.122-.25.254-.108.497.142.244.631 1.042 1.354 1.686.93.829 1.714 1.087 1.958 1.209.244.122.387.103.53-.061.143-.164.618-.72.783-.967.165-.247.33-.206.556-.122.226.084 1.439.678 1.686.802.247.124.412.185.473.288.061.103.061.602-.183 1.287z"/>
            </svg>
          </span>
          <span data-i18n="heroCtaPrimary">Demander un Échange WhatsApp</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>

        <a href="#system" class="btn-secondary">
          <span data-i18n="heroCtaSecondary">Découvrir le Système</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="hero-trust-cards">
        {trustBadges.map((badge) => (
          <div class="trust-card">
            <div class="trust-card-icon">
              {badge.icon === "calendar" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              )}
              {badge.icon === "whatsapp" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              )}
              {badge.icon === "chart" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              )}
            </div>
            <div>
              <strong data-i18n={badge.titleKey}>{badge.title}</strong>
              <p data-i18n={badge.descKey}>{badge.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom boundary with synchronized niche badges -->
  <div class="hero-footer">
    <div class="hero-footer-container">
      {slides.map((slide, index) => (
        <>
          <div
            class={`footer-badge slide-niche ${index === 0 ? 'active' : ''}`}
            data-niche-index={index}
            data-i18n={slide.key}
          >
            {slide.label}
          </div>
          {index < slides.length - 1 && <span class="footer-dot">•</span>}
        </>
      ))}
    </div>
  </div>
</section>

<script>
  const slideItems = document.querySelectorAll<HTMLElement>('.slide-item');
  const nicheBadges = document.querySelectorAll<HTMLElement>('.slide-niche');
  const slideDescs = document.querySelectorAll<HTMLElement>('.slide-desc');

  if (slideItems.length > 1) {
    let currentIndex = 0;
    setInterval(() => {
      // Deactivate current slide, niche pill, & description
      slideItems[currentIndex]?.classList.remove('active');
      nicheBadges[currentIndex]?.classList.remove('active');
      slideDescs[currentIndex]?.classList.remove('active');

      // Cycle to next state (0 -> 1 -> 2 -> 0)
      currentIndex = (currentIndex + 1) % slideItems.length;

      // Activate next slide, niche pill, & description
      slideItems[currentIndex]?.classList.add('active');
      nicheBadges[currentIndex]?.classList.add('active');
      slideDescs[currentIndex]?.classList.add('active');
    }, 3000);
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - 110px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 0 60px;
    background-color: var(--color-bg-light);
    overflow: hidden;
  }

  .hero-bg-slider {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .slide-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1000ms ease-in-out;
    pointer-events: none;
  }

  .slide-item.active {
    opacity: 1;
  }

  .hero-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;

  /* Keep the original image bright and natural */
  filter: brightness(0.95) contrast(1.02) saturate(1.05);

  transform: scale(1.02);
}

/* Light cinematic overlay — keeps text readable without killing the image */
.hero-bg-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(5, 20, 35, 0.72) 0%,
      rgba(5, 20, 35, 0.42) 45%,
      rgba(5, 20, 35, 0.16) 100%
    ),
    linear-gradient(
      180deg,
      rgba(5, 20, 35, 0.18) 0%,
      rgba(5, 20, 35, 0.10) 50%,
      rgba(5, 20, 35, 0.42) 100%
    );
}

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(0, 168, 150, 0.15) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.6;
  }

  .hero-container {
    width: min(calc(100% - 40px), var(--container-width));
    margin: 0 auto;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }

  .hero-content {
    max-width: 840px;
    color: #ffffff;
    will-change: transform;
  }

  [dir="rtl"] .hero-content {
    text-align: right;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 24px;
    white-space: nowrap;
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00a896;
    box-shadow: 0 0 10px #00a896;
  }

  .eyebrow-brand {
    color: #ffffff;
  }

  .eyebrow-divider {
    color: rgba(255, 255, 255, 0.3);
  }

  .eyebrow-niche {
    color: #64eeea;
  }

  .hero-title {
    margin: 0 0 20px;
    font-size: clamp(40px, 5.5vw, 72px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .gradient-text {
    background: linear-gradient(135deg, #64eeea 0%, #00a896 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-descriptions-container {
    position: relative;
    min-height: 68px;
    margin-bottom: 36px;
    max-width: 720px;
  }

  .slide-desc {
    position: absolute;
    inset: 0;
    margin: 0;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.9);
    opacity: 0;
    transition: opacity 1000ms ease-in-out;
    pointer-events: none;
  }

  .slide-desc.active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 50px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    border-radius: 99px;
    background: #25d366;
    color: #ffffff;
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.35);
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    background: #20bd5a;
    box-shadow: 0 14px 36px rgba(37, 211, 102, 0.45);
  }

  .btn-whatsapp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arrow {
    transition: transform 180ms ease;
  }

  [dir="rtl"] .arrow {
    transform: rotate(180deg);
  }

  .btn-primary:hover .arrow {
    transform: translateX(4px);
  }

  [dir="rtl"] .btn-primary:hover .arrow {
    transform: rotate(180deg) translateX(4px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 16px 28px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .hero-trust-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 780px;
  }

  .trust-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 16px;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .trust-card-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(0, 168, 150, 0.2);
    color: #64eeea;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-card-icon svg {
    width: 20px;
    height: 20px;
  }

  .trust-card strong {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
  }

  .trust-card p {
    margin: 2px 0 0;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
  }

  .hero-footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-footer-container {
    width: min(calc(100% - 40px), var(--container-width));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-badge {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.45);
    padding: 6px 14px;
    border-radius: 99px;
    border: 1px solid transparent;
    transition: color 400ms ease, background 400ms ease, border-color 400ms ease, transform 400ms ease;
  }

  .footer-badge.active {
    color: #64eeea;
    background: rgba(0, 168, 150, 0.25);
    border-color: rgba(100, 238, 234, 0.4);
    transform: scale(1.04);
  }

  .footer-dot {
    color: rgba(255, 255, 255, 0.3);
  }

  /* ==========================================
   RESPONSIVE HERO
   ========================================== */

/* Tablets */
@media (max-width: 1024px) {
  .hero {
    min-height: auto;
    padding: 90px 0 50px;
  }

  .hero-container {
    width: min(calc(100% - 48px), var(--container-width));
  }

  .hero-content {
    max-width: 760px;
  }

  .hero-title {
    font-size: clamp(42px, 6vw, 62px);
  }

  .hero-descriptions-container {
    max-width: 650px;
  }

  .hero-trust-cards {
    max-width: 100%;
    gap: 12px;
  }

  .trust-card {
    padding: 13px 14px;
  }

  .trust-card strong {
    font-size: 12px;
  }

  .trust-card p {
    font-size: 10px;
  }
}


/* ==========================================
   MOBILE
   ========================================== */

@media (max-width: 768px) {

  .hero {
    min-height: auto;
    padding: 90px 0 0;
  }

  /* Container */
  .hero-container {
    width: calc(100% - 32px);
    margin: 0 auto;
    align-items: flex-start;
  }

  .hero-content {
    width: 100%;
    max-width: none;
    padding: 30px 0 50px;
  }


  /* ==========================================
     BACKGROUND
     ========================================== */

  .hero-bg-img {
    object-position: center center;
    filter: brightness(0.92) contrast(1.02) saturate(1.05);
  }

  .hero-bg-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(5, 20, 35, 0.45) 0%,
        rgba(5, 20, 35, 0.48) 45%,
        rgba(5, 20, 35, 0.72) 100%
      );
  }

  .hero-grid {
    opacity: 0.18;
    background-size: 24px 24px;
  }


  /* ==========================================
     EYEBROW
     ========================================== */

  .hero-eyebrow {
    max-width: 100%;
    margin-bottom: 20px;

    padding: 6px 12px;
    gap: 7px;

    font-size: 9px;
    letter-spacing: 0.05em;

    white-space: normal;
    flex-wrap: wrap;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
  }

  .eyebrow-divider {
    display: none;
  }


  /* ==========================================
     TITLE
     ========================================== */

  .hero-title {
    margin-bottom: 18px;

    font-size: clamp(36px, 10vw, 52px);
    line-height: 1.08;

    letter-spacing: -0.035em;
  }


  /* ==========================================
     DESCRIPTION
     ========================================== */

  .hero-descriptions-container {
    max-width: 100%;
    min-height: 120px;
    margin-bottom: 28px;
  }

  .slide-desc {
    font-size: 16px;
    line-height: 1.6;
  }


  /* ==========================================
     BUTTONS
     ========================================== */

  .hero-actions {
    width: 100%;

    display: flex;
    flex-direction: column;
    align-items: stretch;

    gap: 12px;
    margin-bottom: 32px;
  }

  .btn-primary,
  .btn-secondary {
    width: 100%;
    min-height: 54px;

    justify-content: center;
    text-align: center;

    box-sizing: border-box;
  }

  .btn-primary {
    padding: 15px 20px;
    font-size: 14px;
  }

  .btn-secondary {
    padding: 15px 20px;
    font-size: 14px;
  }


  /* ==========================================
     TRUST CARDS
     ========================================== */

  .hero-trust-cards {
    width: 100%;

    display: grid;
    grid-template-columns: 1fr;

    gap: 10px;
  }

  .trust-card {
    width: 100%;
    box-sizing: border-box;

    padding: 12px 14px;

    border-radius: 14px;

    background: rgba(15, 23, 42, 0.58);
    backdrop-filter: blur(14px);
  }

  .trust-card-icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
  }

  .trust-card strong {
    font-size: 12px;
  }

  .trust-card p {
    font-size: 10px;
  }


  /* ==========================================
     FOOTER
     ========================================== */

  .hero-footer {
    margin-top: 0;
    padding: 18px 0;

    background: rgba(5, 20, 35, 0.35);
    backdrop-filter: blur(8px);

    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-footer-container {
    width: calc(100% - 32px);

    gap: 8px 10px;
  }

  .footer-badge {
    font-size: 9px;
    letter-spacing: 0.08em;

    padding: 5px 10px;
  }

  .footer-dot {
    font-size: 10px;
  }

  .slide-item:nth-child(1) .hero-bg-img {
    object-position: 50% center;
  }

  .slide-item:nth-child(2) .hero-bg-img {
    object-position: 50% center;
  }

  .slide-item:nth-child(3) .hero-bg-img {
    object-position: 50% top;
  }

}


/* ==========================================
   SMALL PHONES
   ========================================== */

@media (max-width: 480px) {

  .hero {
    padding-top: 78px;
  }

  .hero-container {
    width: calc(100% - 24px);
  }

  .hero-content {
    padding-top: 24px;
    padding-bottom: 38px;
  }


  /* Smaller eyebrow */
  .hero-eyebrow {
    font-size: 8px;
    padding: 5px 10px;
    gap: 6px;
  }


  /* Smaller title */
  .hero-title {
    font-size: clamp(34px, 11vw, 44px);
    line-height: 1.05;
  }


  /* Description */
  .hero-descriptions-container {
    min-height: 145px;
    margin-bottom: 24px;
  }

  .slide-desc {
    font-size: 15px;
    line-height: 1.55;
  }


  /* Buttons */
  .btn-primary,
  .btn-secondary {
    min-height: 52px;
    padding: 14px 16px;
    font-size: 13px;
  }


  /* Trust cards */
  .trust-card {
    padding: 11px 12px;
  }

  .trust-card-icon {
    width: 34px;
    height: 34px;
  }


  /* Footer */
  .hero-footer-container {
    width: calc(100% - 20px);
    gap: 6px;
  }

  .footer-badge {
    font-size: 8px;
    padding: 4px 8px;
  }
}


/* ==========================================
   VERY SMALL PHONES
   ========================================== */

@media (max-width: 360px) {

  .hero-title {
    font-size: 32px;
  }

  .hero-descriptions-container {
    min-height: 165px;
  }

  .slide-desc {
    font-size: 14px;
  }

  .hero-eyebrow {
    font-size: 7px;
  }

