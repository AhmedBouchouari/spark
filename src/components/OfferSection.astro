 ---
const stages = [
  {
    number: "01",
    title: "ATTIRER",
    label: "ACQUISITION",
    items: ["Facebook & Instagram Ads", "Social Media"],
  },
  {
    number: "02",
    title: "CONVERTIR",
    label: "CONVERSION",
    items: ["Contenus promotionnels", "Offres attractives"],
  },
  {
    number: "03",
    title: "SUIVRE",
    label: "LEADS",
    items: ["WhatsApp / Messenger", "Gestion des leads"],
  },
  {
    number: "04",
    title: "OPTIMISER",
    label: "PERFORMANCE",
    items: ["Suivi quotidien", "Reporting"],
  },
];

const totalFeatures = stages.reduce(
  (total, stage) => total + stage.items.length,
  0,
);
---

<section
  id="offer"
  class="offer"
  aria-labelledby="offer-title"
>
  <!-- Decorative background -->
  <div class="offer-orb offer-orb-one" aria-hidden="true"></div>
  <div class="offer-orb offer-orb-two" aria-hidden="true"></div>

  <div class="offer-container">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="offer-header">
      <div class="eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span>THE OFFER</span>
      </div>

      <div class="offer-heading">

        <div class="heading-main">
          <span class="heading-index">SPARK / 01</span>

          <h2 id="offer-title">
            Tout ce dont votre salon
            <span>a besoin pour grandir.</span>
          </h2>
        </div>

        <div class="heading-side">
          <p>
            Un système simple et structuré pour attirer,
            convertir et optimiser vos demandes.
          </p>

          <div class="heading-note">
            <span class="note-dot" aria-hidden="true"></span>
            <span>Pensé pour les salons de beauté</span>
          </div>
        </div>

      </div>
    </header>


    <!-- =====================================================
         OFFER EXPERIENCE
    ====================================================== -->

    <div class="offer-layout">

      <!-- ===================================================
           MAIN OFFER CARD
      ==================================================== -->

      <article class="pricing-card">

        <!-- Pricing header -->

        <div class="pricing-top">

          <div class="plan-information">

            <div
              class="plan-icon"
              aria-hidden="true"
            >
              S
            </div>

            <div class="plan-copy">
              <span class="plan-label">
                SPARK
              </span>

              <h3>
                GROWTH
              </h3>

              <p>
                Beauty Growth System
              </p>
            </div>

          </div>


          <div
            class="price"
            aria-label="1 500 dirhams par mois"
          >
            <span class="price-amount">
              1 500
            </span>

            <div class="price-details">
              <span class="price-currency">
                DH
              </span>

              <span class="price-period">
                / mois
              </span>
            </div>
          </div>

        </div>


        <!-- =================================================
             SYSTEM STATUS
        ================================================== -->

        <div class="system-wrapper">

          <div class="system-meta">

            <div class="system-title">
              <span
                class="system-indicator"
                aria-hidden="true"
              ></span>

              <span>
                VOTRE SYSTÈME DE CROISSANCE
              </span>
            </div>

            <span class="system-status">
              ACTIVE
            </span>

          </div>


          <div
            class="system-bar"
            aria-label="Les quatre étapes du système Spark"
          >

            <div
              class="system-progress"
              aria-hidden="true"
            ></div>

            {stages.map((stage, index) => (
              <div
                class:list={[
                  "system-stage",
                  { active: index === 0 },
                ]}
              >
                <span class="stage-number">
                  {stage.number}
                </span>

                <span class="stage-title">
                  {stage.title}
                </span>
              </div>
            ))}

          </div>

        </div>


        <!-- =================================================
             INCLUDED
        ================================================== -->

        <div class="included">

          <div class="included-header">

            <div>
              <span class="included-label">
                CE QUI EST INCLUS
              </span>

              <span class="included-subtitle">
                Un système complet, pas seulement de la publicité.
              </span>
            </div>

            <span class="included-count">
              {totalFeatures} ÉLÉMENTS
            </span>

          </div>


          <div class="included-grid">

            {stages.map((stage) => (
              <div class="feature-group">

                <div class="feature-group-header">

                  <span class="feature-number">
                    {stage.number}
                  </span>

                  <div>
                    <span class="feature-title">
                      {stage.title}
                    </span>

                    <span class="feature-label">
                      {stage.label}
                    </span>
                  </div>

                </div>


                <div class="feature-list">

                  {stage.items.map((item) => (
                    <div class="feature">

                      <span
                        class="check"
                        aria-hidden="true"
                      >
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M3 8.5L6.5 12L13 5"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>

                      <span>
                        {item}
                      </span>

                    </div>
                  ))}

                </div>

              </div>
            ))}

          </div>

        </div>


        <!-- =================================================
             FOOTER CTA
        ================================================== -->

        <div class="pricing-footer">

          <div class="footer-message">

            <span
              class="footer-dot"
              aria-hidden="true"
            ></span>

            <div>
              <strong>
                Pensé exclusivement pour les salons.
              </strong>

              <span>
                Simple à comprendre. Facile à suivre.
              </span>
            </div>

          </div>


          <a
            href="#contact"
            class="offer-button"
            aria-label="Parler à Spark au sujet de votre salon"
          >
            <span>
              Parler à Spark
            </span>

            <span
              class="arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>

        </div>

      </article>


      <!-- ===================================================
           VISUAL PANEL
      ==================================================== -->

      <aside
        class="offer-visual"
        aria-label="Aperçu du système Spark"
      >

        <div class="visual-top">

          <div>
            <span class="visual-eyebrow">
              SPARK SYSTEM
            </span>

            <h3>
              Votre croissance,
              <span>en mouvement.</span>
            </h3>
          </div>

          <div class="visual-status">

            <span aria-hidden="true"></span>

            ACTIVE

          </div>

        </div>


        <!-- =================================================
             GRAPH
        ================================================== -->

        <div
          class="growth-graph"
          aria-hidden="true"
        >

          <div class="graph-grid"></div>

          <div class="graph-label graph-label-one">
            DEMANDES
          </div>

          <div class="graph-label graph-label-two">
            PERFORMANCE
          </div>


          <svg
            class="growth-line"
            viewBox="0 0 500 220"
            preserveAspectRatio="none"
          >

            <defs>

              <linearGradient
                id="sparkLineGradient"
                x1="0"
                y1="0"
                x2="1"
                y2="0"
              >
                <stop
                  offset="0%"
                  stop-color="#00afb9"
                />

                <stop
                  offset="100%"
                  stop-color="#7ce8ee"
                />
              </linearGradient>


              <linearGradient
                id="sparkAreaGradient"
                x1="0"
                y1="0"
                x2="0"
                y2="1"
              >
                <stop
                  offset="0%"
                  stop-color="#00afb9"
                  stop-opacity="0.18"
                />

                <stop
                  offset="100%"
                  stop-color="#00afb9"
                  stop-opacity="0"
                />
              </linearGradient>

            </defs>


            <path
              class="graph-area"
              d="
                M0 184
                C42 180 60 170 92 174
                C126 178 139 147 169 151
                C204 155 213 124 242 131
                C275 139 289 104 316 111
                C348 120 359 81 389 88
                C423 96 443 57 500 42
                L500 220
                L0 220
                Z
              "
            />


            <path
              class="graph-path"
              d="
                M0 184
                C42 180 60 170 92 174
                C126 178 139 147 169 151
                C204 155 213 124 242 131
                C275 139 289 104 316 111
                C348 120 359 81 389 88
                C423 96 443 57 500 42
              "
            />

          </svg>


          <span class="graph-point point-one"></span>
          <span class="graph-point point-two"></span>
          <span class="graph-point point-three"></span>

        </div>


        <!-- =================================================
             METRICS
        ================================================== -->

        <div class="visual-metrics">

          <div class="metric">

            <span class="metric-label">
              ACQUISITION
            </span>

            <strong>
              ADS
            </strong>

            <small>
              Facebook + Instagram
            </small>

          </div>


          <div class="metric">

            <span class="metric-label">
              CONVERSION
            </span>

            <strong>
              OFFERS
            </strong>

            <small>
              Contenus promotionnels
            </small>

          </div>


          <div class="metric">

            <span class="metric-label">
              LEADS
            </span>

            <strong>
              WHATSAPP
            </strong>

            <small>
              Conversations
            </small>

          </div>


          <div class="metric">

            <span class="metric-label">
              OPTIMISATION
            </span>

            <strong>
              DATA
            </strong>

            <small>
              Suivi + reporting
            </small>

          </div>

        </div>


        <!-- =================================================
             VISUAL FOOTER
        ================================================== -->

        <div class="visual-footer">

          <span>
            SYSTÈME EN CONTINU
          </span>

          <span
            class="visual-arrow"
            aria-hidden="true"
          >
            ↗
          </span>

        </div>

      </aside>

    </div>


    <!-- =====================================================
         BOTTOM NOTE
    ====================================================== -->

    <div class="offer-note">

      <span
        class="note-line"
        aria-hidden="true"
      ></span>

      <p>
        Parlons de votre salon.
        <strong>Sans engagement.</strong>
      </p>

      <span
        class="note-line note-line-right"
        aria-hidden="true"
      ></span>

    </div>

  </div>
</section>


<style>
  /* =========================================================
     SECTION
  ========================================================= */

  .offer {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 75% 15%,
        rgba(0, 175, 185, 0.055),
        transparent 30%
      ),
      #f3f6f7;
    color: #071116;
  }

  .offer-container {
    position: relative;
    z-index: 2;
    width: min(1220px, calc(100% - 48px));
    margin: 0 auto;
    padding: 125px 0 120px;
  }

  .offer-orb {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
  }

  .offer-orb-one {
    top: 20%;
    right: -250px;
    background: rgba(0, 175, 185, 0.055);
  }

  .offer-orb-two {
    bottom: -300px;
    left: -250px;
    background: rgba(0, 175, 185, 0.035);
  }


  /* =========================================================
     HEADER
  ========================================================= */

  .offer-header {
    margin-bottom: 65px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #008c96;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.17em;
  }

  .eyebrow-line {
    width: 26px;
    height: 1px;
    flex: 0 0 auto;
    background: #00afb9;
  }

  .offer-heading {
    display: grid;
    grid-template-columns:
      minmax(0, 1.25fr)
      minmax(280px, 0.75fr);
    align-items: end;
    gap: 80px;
    margin-top: 22px;
  }

  .heading-index {
    display: block;
    margin-bottom: 16px;
    color: #9aa5aa;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .heading-main h2 {
    max-width: 820px;
    margin: 0;
    color: #071116;
    font-size: clamp(48px, 5.7vw, 76px);
    line-height: 0.96;
    letter-spacing: -0.06em;
    font-weight: 800;
  }

  .heading-main h2 span {
    display: block;
    color: #008c96;
  }

  .heading-side {
    padding-bottom: 3px;
  }

  .heading-side p {
    max-width: 430px;
    margin: 0;
    color: #657279;
    font-size: 14px;
    line-height: 1.8;
  }

  .heading-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    color: #879299;
    font-size: 8px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .note-dot {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #00afb9;
    box-shadow: 0 0 0 4px rgba(0, 175, 185, 0.08);
  }


  /* =========================================================
     LAYOUT
  ========================================================= */

  .offer-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1.65fr)
      minmax(300px, 0.7fr);
    gap: 18px;
    align-items: stretch;
  }


  /* =========================================================
     PRICING CARD
  ========================================================= */

  .pricing-card {
    overflow: hidden;
    border: 1px solid #dce4e6;
    border-radius: 18px;
    background: #ffffff;
    box-shadow:
      0 25px 70px rgba(7, 17, 22, 0.07);
  }


  /* =========================================================
     PRICING TOP
  ========================================================= */

  .pricing-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 31px 34px;
    background:
      linear-gradient(
        135deg,
        #edf8f9,
        #f5fbfb
      );
    border-bottom: 1px solid #dce8ea;
  }

  .plan-information {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .plan-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    flex: 0 0 auto;
    border-radius: 11px;
    background: #071116;
    color: #ffffff;
    font-size: 17px;
    font-weight: 800;
    box-shadow:
      0 8px 22px rgba(7, 17, 22, 0.14);
  }

  .plan-copy {
    display: flex;
    flex-direction: column;
  }

  .plan-label {
    color: #008c96;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .plan-copy h3 {
    margin: 3px 0 0;
    color: #071116;
    font-size: 18px;
    line-height: 1;
    letter-spacing: 0.07em;
    font-weight: 800;
  }

  .plan-copy p {
    margin: 5px 0 0;
    color: #738087;
    font-size: 10px;
  }


  /* =========================================================
     PRICE
  ========================================================= */

  .price {
    display: flex;
    align-items: flex-end;
    color: #071116;
  }

  .price-amount {
    font-size: clamp(42px, 5vw, 63px);
    line-height: 0.9;
    letter-spacing: -0.065em;
    font-weight: 800;
  }

  .price-details {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin:
      0 0
      5px 8px;
  }

  .price-currency {
    color: #008c96;
    font-size: 16px;
    font-weight: 800;
  }

  .price-period {
    color: #758188;
    font-size: 11px;
  }


  /* =========================================================
     SYSTEM
  ========================================================= */

  .system-wrapper {
    padding: 24px 34px 27px;
    border-bottom: 1px solid #e5eaec;
  }

  .system-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .system-title {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #8a959b;
  }

  .system-indicator {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #00afb9;
    box-shadow:
      0 0 0 4px rgba(0, 175, 185, 0.08);
  }

  .system-status {
    color: #008c96;
  }

  .system-bar {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    min-height: 58px;
    overflow: hidden;
    border: 1px solid #dfe6e8;
    border-radius: 10px;
    background: #f5f7f8;
  }

  .system-progress {
    position: absolute;
    z-index: 0;
    inset: 0 auto 0 0;
    width: 25%;
    background:
      linear-gradient(
        90deg,
        rgba(0, 175, 185, 0.16),
        rgba(0, 175, 185, 0.035)
      );
    border-right: 1px solid rgba(0, 175, 185, 0.2);
  }

  .system-stage {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-right: 1px solid #e1e7e9;
    color: #89949a;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .system-stage:last-child {
    border-right: 0;
  }

  .system-stage.active {
    color: #071116;
  }

  .stage-number {
    color: #00afb9;
    font-size: 8px;
  }


  /* =========================================================
     INCLUDED
  ========================================================= */

  .included {
    padding: 27px 34px 33px;
  }

  .included-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 21px;
  }

  .included-header > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .included-label {
    color: #8a959b;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .included-subtitle {
    color: #9aa4a9;
    font-size: 9px;
  }

  .included-count {
    color: #008c96;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .included-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid #e5eaec;
    border-bottom: 1px solid #e5eaec;
  }

  .feature-group {
    min-height: 164px;
    padding: 21px 18px 24px 0;
    border-right: 1px solid #e5eaec;
  }

  .feature-group:not(:first-child) {
    padding-left: 18px;
  }

  .feature-group:last-child {
    border-right: 0;
  }

  .feature-group-header {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-bottom: 21px;
  }

  .feature-number {
    color: #00afb9;
    font-size: 8px;
    font-weight: 800;
  }

  .feature-group-header > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .feature-title {
    color: #071116;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .feature-label {
    color: #a1aaae;
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #58666e;
    font-size: 10px;
    line-height: 1.4;
  }

  .check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    flex: 0 0 auto;
    border: 1px solid rgba(0, 175, 185, 0.24);
    border-radius: 50%;
    background: rgba(0, 175, 185, 0.06);
    color: #008c96;
  }

  .check svg {
    width: 11px;
    height: 11px;
  }


  /* =========================================================
     FOOTER
  ========================================================= */

  .pricing-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 19px 34px;
    background: #fafbfb;
    border-top: 1px solid #e7ebed;
  }

  .footer-message {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #00afb9;
    box-shadow:
      0 0 0 4px rgba(0, 175, 185, 0.08);
  }

  .footer-message div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .footer-message strong {
    color: #26333a;
    font-size: 10px;
    font-weight: 750;
  }

  .footer-message span {
    color: #879299;
    font-size: 9px;
  }


  /* =========================================================
     CTA
  ========================================================= */

  .offer-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 46px;
    padding: 0 18px 0 21px;
    border-radius: 8px;
    background: #071116;
    color: #ffffff;
    text-decoration: none;
    font-size: 11px;
    font-weight: 750;
    transition:
      background 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .offer-button:hover {
    background: #008c96;
    transform: translateY(-2px);
    box-shadow:
      0 10px 25px rgba(0, 140, 150, 0.18);
  }

  .offer-button:focus-visible {
    outline: 2px solid #00afb9;
    outline-offset: 3px;
  }

  .arrow {
    font-size: 16px;
    line-height: 1;
  }


  /* =========================================================
     VISUAL PANEL
  ========================================================= */

  .offer-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 100%;
    padding: 27px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    background:
      radial-gradient(
        circle at 70% 25%,
        rgba(0, 175, 185, 0.12),
        transparent 35%
      ),
      #071116;
    color: #ffffff;
    box-shadow:
      0 25px 70px rgba(7, 17, 22, 0.12);
  }

  .offer-visual::before {
    position: absolute;
    inset: 0;
    content: "";
    opacity: 0.28;
    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
