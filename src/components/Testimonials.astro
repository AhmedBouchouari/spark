---
/*
 * ============================================================
 * SPARK — EXPERIENCE & CLIENTS
 * ============================================================
 *
 * DEMO CONTENT
 * ------------------------------------------------------------
 * The clients, reviews and metrics below are examples for
 * visual development only.
 *
 * Replace them with verified SPARK data before publishing.
 */

/* ============================================================
   EXPERIENCE / PROOF
============================================================ */

const proofPoints = [
  {
    value: "+25",
    label: "salons accompagnés",
    note: "Exemple de donnée",
  },
  {
    value: "80+",
    label: "campagnes lancées",
    note: "Exemple de donnée",
  },
  {
    value: "6",
    label: "villes accompagnées",
    note: "Exemple de donnée",
  },
  {
    value: "4 ans",
    label: "d’expérience",
    note: "Exemple de donnée",
  },
];


/* ============================================================
   CLIENTS
============================================================ */

const clients = [
  {
    name: "Maison Élégance",
    category: "Beauty & Hair",
    location: "Casablanca",
    logo:
      "https://placehold.co/300x100/F3FAFF/011640?text=MAISON+ELEGANCE",
  },
  {
    name: "Studio Noor",
    category: "Beauty Studio",
    location: "Rabat",
    logo:
      "https://placehold.co/300x100/F3FAFF/011640?text=STUDIO+NOOR",
  },
  {
    name: "Luna Beauty",
    category: "Beauty Salon",
    location: "Marrakech",
    logo:
      "https://placehold.co/300x100/F3FAFF/011640?text=LUNA+BEAUTY",
  },
  {
    name: "Éclat Studio",
    category: "Hair & Beauty",
    location: "Agadir",
    logo:
      "https://placehold.co/300x100/F3FAFF/011640?text=ECLAT+STUDIO",
  },
];


/* ============================================================
   TESTIMONIAL
============================================================ */

const testimonial = {
  quote:
    "Nous avions déjà essayé de communiquer sur les réseaux sociaux, mais sans véritable structure. Avec Spark, nous avons enfin une approche claire : une offre, des campagnes et un parcours pensé pour générer des rendez-vous.",
  name: "Sarah El Mansouri",
  salon: "Maison Élégance",
  location: "Casablanca, Maroc",
  role: "Fondatrice",
};


/* ============================================================
   MINI CASE STUDY
============================================================ */

const caseStudy = {
  result: "+32%",
  metric: "demandes de rendez-vous",
  period: "Exemple — sur 90 jours",
};
---


<section
  id="experience"
  class="experience-section"
  aria-labelledby="experience-title"
>

  <div class="experience-container">

    <!-- =====================================================
         INTRODUCTION
    ====================================================== -->

    <header class="experience-header">

      <div class="experience-eyebrow">

        <span class="eyebrow-number">
          05
        </span>

        <span
          class="eyebrow-line"
          aria-hidden="true"
        ></span>

        <span>
          NOTRE EXPÉRIENCE
        </span>

      </div>


      <div class="experience-heading">

        <div class="heading-main">

          <span class="section-index">
            EXPÉRIENCE / PREUVE
          </span>

          <h2 id="experience-title">
            Une expérience pensée
            <span>pour les salons.</span>
          </h2>

        </div>


        <div class="heading-side">

          <p>
            Nous construisons des systèmes marketing conçus autour
            d’un objectif simple : transformer l’attention en rendez-vous.
          </p>


          <div class="specialization">

            <span
              class="specialization-dot"
              aria-hidden="true"
            ></span>

            <span>
              Spécialisé dans l’univers de la beauté
            </span>

          </div>

        </div>

      </div>

    </header>



    <!-- =====================================================
         EXPERIENCE / PROOF
    ====================================================== -->

    <div class="experience-proof">

      <div class="proof-intro">

        <span class="proof-label">
          L’EXPÉRIENCE SPARK
        </span>


        <h3>
          Comprendre le salon
          <span>avant de construire le système.</span>
        </h3>


        <p>
          Un salon ne cherche pas simplement plus de visibilité.
          Il cherche des conversations qualifiées, des demandes
          concrètes et davantage d’opportunités de rendez-vous.
        </p>


        <div class="proof-note">

          <span class="proof-note-dot"></span>

          <span>
            Données présentées à titre d’exemple
          </span>

        </div>

      </div>



      <!-- =================================================
           METRICS
      ================================================== -->

      <div class="proof-points">

        {proofPoints.map((point, index) => (

          <div class="proof-point">

            <span class="proof-index">
              {String(index + 1).padStart(2, "0")}
            </span>


            <div class="proof-content">

              <strong>
                {point.value}
              </strong>

              <span>
                {point.label}
              </span>

              <small>
                {point.note}
              </small>

            </div>

          </div>

        ))}

      </div>

    </div>



    <!-- =====================================================
         CLIENTS
    ====================================================== -->

    <div class="clients-area">

      <div class="clients-header">

        <div>

          <span class="clients-kicker">
            ILS NOUS FONT CONFIANCE
          </span>

          <h3>
            Des salons qui avancent
            <span>avec une vraie stratégie.</span>
          </h3>

        </div>


        <p>
          Quelques exemples de présentation pour illustrer
          comment les partenaires SPARK peuvent être mis en avant
          sans transformer la section en portfolio classique.
        </p>

      </div>



      <!-- =================================================
           LOGO LIST
      ================================================== -->

      <div class="client-logos">

        {clients.map((client, index) => (

          <div class="client-logo">

            <div class="logo-index">
              0{index + 1}
            </div>


            <div class="logo-image">

              <img
                src={client.logo}
                alt={`Logo ${client.name}`}
                loading="lazy"
                decoding="async"
              />

            </div>


            <div class="logo-information">

              <strong>
                {client.name}
              </strong>

              <span>
                {client.category}
              </span>

              <small>
                {client.location}
              </small>

            </div>

          </div>

        ))}

      </div>

    </div>



    <!-- =====================================================
         CLIENT VOICE + CASE STUDY
    ====================================================== -->

    <article class="client-voice">


      <!-- LEFT MARKER -->

      <div class="voice-marker">

        <span class="voice-index">
          06
        </span>

        <span class="voice-label">
          VOIX CLIENT
        </span>

      </div>



      <!-- TESTIMONIAL -->

      <div class="voice-content">

        <span class="voice-kicker">
          RETOUR D’EXPÉRIENCE
        </span>


        <span
          class="quote-mark"
          aria-hidden="true"
        >
          “
        </span>


        <blockquote>
          {testimonial.quote}
        </blockquote>


        <div class="client-information">

          <div
            class="client-avatar"
            aria-hidden="true"
          >
            S
          </div>


          <div class="client-details">

            <strong>
              {testimonial.name}
            </strong>

            <span>
              {testimonial.salon}
            </span>

            <small>
              {testimonial.role} · {testimonial.location}
            </small>

          </div>

        </div>

      </div>



      <!-- RESULT -->

      <aside class="case-result">

        <span class="case-result-label">
          RÉSULTAT
        </span>


        <strong>
          {caseStudy.result}
        </strong>


        <span class="case-result-metric">
          {caseStudy.metric}
        </span>


        <small>
          {caseStudy.period}
        </small>


        <div class="case-result-line">
          <span></span>
        </div>

      </aside>

    </article>



    <!-- =====================================================
         CLOSING STATEMENT
    ====================================================== -->

    <div class="experience-closing">

      <div class="closing-rule"></div>


      <p>
        Pas une agence généraliste.
        <strong>
          Un système pensé pour les salons.
        </strong>
      </p>


      <div class="closing-rule closing-rule-right"></div>

    </div>

  </div>

</section>



<style>

/* ============================================================
   DESIGN TOKENS
============================================================ */

.experience-section {

  --color-ink: #011640;

  --color-blue-dark: #0A4A82;

  --color-blue: #0B5FA5;

  --color-cyan: #3BC9DB;

  --color-body: #3F3F3F;

  --color-background: #F3FAFF;

  --color-surface: #FFFFFF;

  --color-neutral: #F1F3F5;

  --color-muted: #7A858C;

  --color-border: #DDE5EA;

  --color-border-soft: #E8EEF2;


  position: relative;

  isolation: isolate;

  overflow: hidden;

  background: var(--color-background);

  color: var(--color-ink);

}



/* ============================================================
   BACKGROUND ATMOSPHERE
============================================================ */

.experience-section::before {

  position: absolute;

  top: -280px;

  right: -220px;

  width: 650px;

  height: 650px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(59, 201, 219, 0.09),
      rgba(59, 201, 219, 0.025) 40%,
      transparent 70%
    );

  content: "";

  pointer-events: none;

}


.experience-section::after {

  position: absolute;

  bottom: -300px;

  left: -260px;

  width: 580px;

  height: 580px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(10, 74, 130, 0.055),
      transparent 70%
    );

  content: "";

  pointer-events: none;

}



/* ============================================================
   CONTAINER
============================================================ */

.experience-container {

  position: relative;

  z-index: 2;

  width:
    min(
      1180px,
      calc(100% - 64px)
    );

  margin-inline: auto;

  padding:
    145px
    0
    135px;

}



/* ============================================================
   HEADER
============================================================ */

.experience-header {

  margin-bottom: 92px;

}


.experience-eyebrow {

  display: flex;

  align-items: center;

  gap: 11px;

  color: var(--color-blue);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 0.18em;

}


.eyebrow-number {

  color: var(--color-muted);

  font-size: 8px;

}


.eyebrow-line {

  width: 34px;

  height: 1px;

  background: var(--color-blue);

}


.experience-heading {

  display: grid;

  grid-template-columns:
    minmax(0, 1.35fr)
    minmax(280px, 0.65fr);

  gap: 90px;

  align-items: end;

  margin-top: 27px;

}


.section-index {

  display: block;

  margin-bottom: 18px;

  color: #8C979E;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: 0.16em;

}


.heading-main h2 {

  max-width: 800px;

  margin: 0;

  color: var(--color-ink);

  font-size:
    clamp(
      52px,
      6vw,
      80px
    );

  line-height: 0.95;

  letter-spacing: -0.065em;

  font-weight: 800;

}


.heading-main h2 span {

  display: block;

  color: var(--color-blue);

}


.heading-side {

  padding-bottom: 4px;

}


.heading-side > p {

  max-width: 390px;

  margin: 0;

  color: var(--color-body);

  font-size: 14px;

  line-height: 1.8;

}


.specialization {

  display: flex;

  align-items: center;

  gap: 10px;

  margin-top: 25px;

  color: var(--color-blue-dark);

  font-size: 8px;

  font-weight: 800;

  letter-spacing: 0.09em;

  text-transform: uppercase;

}


.specialization-dot {

  width: 7px;

  height: 7px;

  border-radius: 50%;

  background: var(--color-cyan);

}



/* ============================================================
   EXPERIENCE / PROOF
============================================================ */

.experience-proof {

  display: grid;

  grid-template-columns:
    minmax(280px, 0.82fr)
    minmax(0, 1.18fr);

  gap: 80px;

  padding:
    42px
    0
    55px;

  border-top:
    1px solid
    var(--color-border);

  border-bottom:
    1px solid
    var(--color-border);

}


.proof-intro {

  max-width: 390px;

}


.proof-label {

  display: block;

  margin-bottom: 19px;

  color: var(--color-blue);

  font-size: 8px;

  font-weight: 800;

  letter-spacing: 0.16em;

}


.proof-intro h3 {

  margin: 0;

  color: var(--color-ink);

  font-size:
    clamp(
      28px,
      3vw,
      38px
    );

  line-height: 1.05;

  letter-spacing: -0.045em;

  font-weight: 750;

}


.proof-intro h3 span {

  display: block;

  color: var(--color-blue-dark);

}


.proof-intro p {

  max-width: 360px;

  margin:
    21px
    0
    0;

  color: var(--color-body);

  font-size: 12px;

  line-height: 1.8;

}


.proof-note {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-top: 24px;

  color: var(--color-muted);

  font-size: 8px;

  letter-spacing: 0.03em;

}


.proof-note-dot {

  width: 5px;

  height: 5px;

  border-radius: 50%;

  background: var(--color-cyan);

}



/* ============================================================
   PROOF POINTS
============================================================ */

.proof-points {

  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  border-top:
    1px solid
    var(--color-border-soft);

  border-left:
    1px solid
    var(--color-border-soft);

}


.proof-point {

  display: flex;

  min-height: 154px;

  padding:
    25px
    27px;

  background:
    rgba(
      255,
      255,
      255,
      0.45
    );

  border-right:
    1px solid
    var(--color-border-soft);

  border-bottom:
    1px solid
    var(--color-border-soft);

  transition:
    background 220ms ease,
    transform 220ms ease;

}


.proof-point:hover {

  background:
    var(--color-surface);

  transform:
    translateY(-2px);

}


.proof-index {

  margin-right: 24px;

  color: #9BA6AD;

  font-size: 7px;

  font-weight: 800;

  letter-spacing: 0.13em;

}


.proof-content {

  display: flex;

  flex-direction: column;

  align-items: flex-start;

}


.proof-content strong {

  color: var(--color-ink);

  font-size:
    clamp(
      34px,
      3.6vw,
      49px
    );

  line-height: 0.95;

  letter-spacing: -0.065em;

  font-weight: 800;

}


.proof-content > span {

  margin-top: 10px;

  color: var(--color-body);

  font-size: 9px;

  font-weight: 750;

  letter-spacing: 0.07em;

  text-transform: uppercase;

}


.proof-content small {

  margin-top: 9px;

  color: var(--color-muted);

  font-size: 7px;

  line-height: 1.4;

}



/* ============================================================
   CLIENT AREA
============================================================ */

.clients-area {

  padding:
    67px
    0
    72px;

}


.clients-header {

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(260px, 0.55fr);

  gap: 60px;

  align-items: end;

}


.clients-kicker {

  display: block;

  margin-bottom: 12px;

  color: var(--color-blue);

  font-size: 8px;

  font-weight: 800;

  letter-spacing: 0.17em;

}


.clients-heading h3 {

  margin: 0;

  color: var(--color-ink);

  font-size:
    clamp(
      28px,
      3vw,
      38px
    );

  line-height: 1;

  letter-spacing: -0.045em;

  font-weight: 750;

}


.clients-heading h3 span {

  display: block;

  color: var(--color-blue-dark);

}


.clients-header > p {

  max-width: 340px;

  margin: 0;

  color: var(--color-body);

  font-size: 11px;

  line-height: 1.7;

}



/* ============================================================
   CLIENT LOGOS
============================================================ */

.client-logos {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  margin-top: 35px;

  background:
    rgba(
      255,
      255,
      255,
      0.45
    );

  border-top:
    1px solid
    var(--color-border-soft);

  border-bottom:
    1px solid
    var(--color-border-soft);

}


.client-logo {

  min-height: 115px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  gap: 10px;

  padding:
    18px
    22px;

  border-right:
    1px solid
    var(--color-border-soft);

  transition:
    background 220ms ease;

}


.client-logo:last-child {

  border-right: 0;

}


.client-logo:hover {

  background:
    rgba(
      255,
      255,
      255,
      0.9
    );

}


.logo-index {

  color: #A0AAB0;

  font-size: 7px;

  font-weight: 800;

  letter-spacing: 0.14em;

}


.logo-image {

  width: 100%;

  height: 45px;

  display: flex;

  align-items: center;

  justify-content: flex-start;

}


.logo-image img {

  display: block;

  width: 170px;

  max-width: 100%;

  height: 52px;

  object-fit: contain;

  object-position: left center;

  filter:
    grayscale(1)
    contrast(0.8);

  opacity: 0.7;

  transition:
    filter 220ms ease,
    opacity 220ms ease;

}


.client-logo:hover img {

  filter:
    grayscale(0)
    contrast(1);

  opacity: 1;

}


.logo-information {

  display: flex;

  align-items: center;

  gap: 7px;

}


.logo-information strong {

  color: var(--color-ink);

  font-size: 8px;

  font-weight: 800;

  letter-spacing: 0.04em;

}


.logo-information span {

  color: var(--color-muted);

  font-size: 7px;

}


.logo-information small {

  color: #9AA4AA;

  font-size: 6px;

}



/* ============================================================
   CLIENT VOICE
============================================================ */

.client-voice {

  display: grid;

  grid-template-columns:
    105px
    minmax(0, 1fr)
    210px;

  gap: 55px;

  padding:
    55px
    0
    48px;

  border-top:
    1px solid
    var(--color-border);

  border-bottom:
    1px solid
    var(--color-border);

}


.voice-marker {

  display: flex;

  flex-direction: column;

  gap: 9px;

}


.voice-index {

  color: var(--color-blue);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 0.13em;

}


.voice-label {

  color: #9BA5AA;

  font-size: 7px;

  font-weight: 800;

  line-height: 1.5;

  letter-spacing: 0.14em;

}


.voice-content {

  position: relative;

}


.voice-kicker {

  display: block;

  margin-bottom: 17px;

  color: var(--color-blue);

  font-size: 7px;

  font-weight: 800;

  letter-spacing: 0.15em;

}


.quote-mark {

  position: absolute;

  top: -38px;

  left: -10px;

  color:
    rgba(
      59,
      201,
      219,
      0.18
    );

  font-family: Georgia, serif;

  font-size: 82px;

  line-height: 1;

}


.voice-content blockquote {

  position: relative;

  max-width: 710px;

  margin: 0;

  color: var(--color-ink);

  font-size:
    clamp(
      24px,
      2.7vw,
      36px
    );

  line-height: 1.18;

  letter-spacing: -0.04em;

  font-weight: 600;

}


.client-information {

  display: flex;

  align-items: center;

  gap: 13px;

  margin-top: 32px;

}


.client-avatar {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 40px;

  height: 40px;

  flex: 0 0 auto;

  border:
    1px solid
    rgba(
      11,
      95,
      165,
      0.22
    );

  border-radius: 50%;

  background:
    var(--color-surface);

  color:
    var(--color-blue);

  font-size: 11px;

  font-weight: 800;

}


.client-details {

  display: flex;

  flex-direction: column;

  gap: 3px;

}


.client-details strong {

  color: var(--color-ink);

  font-size: 10px;

  font-weight: 800;

}


.client-details span {

  color: var(--color-body);

  font-size: 9px;

}


.client-details small {

  color: var(--color-muted);

  font-size: 7px;

}



/* ============================================================
   CASE RESULT
============================================================ */

.case-result {

  align-self: end;

  padding-left: 25px;

  border-left:
    1px solid
    var(--color-border);

}


.case-result-label {

  display: block;

  margin-bottom: 13px;

  color: var(--color-blue);

  font-size: 7px;

  font-weight: 800;

  letter-spacing: 0.15em;

}


.case-result strong {

  display: block;

  color: var(--color-ink);

  font-size: 42px;

  line-height: 0.95;

  letter-spacing: -0.06em;

  font-weight: 800;

}


.case-result-metric {

  display: block;

  margin-top: 9px;

  color: var(--color-body);

  font-size: 9px;

  line-height: 1.4;

}


.case-result small {

  display: block;

  margin-top: 6px;

  color: var(--color-muted);

  font-size: 7px;

}


.case-result-line {

  width: 55px;

  margin-top: 20px;

}


.case-result-line span {

  display: block;

  width: 100%;

  height: 2px;

  background:
    var(--color-cyan);

}



/* ============================================================
   CLOSING
============================================================ */

.experience-closing {

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  gap: 26px;

  padding-top: 46px;

}


.experience-closing p {

  margin: 0;

  color: var(--color-body);

  font-size: 10px;

  text-align: center;

}


.experience-closing strong {

  color: var(--color-ink);

}


.closing-rule {

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--color-border)
    );

}


.closing-rule-right {

  background:
    linear-gradient(
      90deg,
      var(--color-border),
      transparent
    );

}



/* ============================================================
   TABLET
============================================================ */

@media (max-width: 1000px) {

  .experience-container {

    width:
      min(
        900px,
        calc(100% - 48px)
      );

    padding:
      115px
      0
      110px;

  }


  .experience-heading {

