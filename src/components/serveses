---
const stages = [
  {
    number: "01",
    title: "ATTIRER",
    items: ["Facebook & Instagram Ads", "Social Media"],
  },
  {
    number: "02",
    title: "CONVERTIR",
    items: ["Contenus promotionnels", "Offres attractives"],
  },
  {
    number: "03",
    title: "SUIVRE",
    items: ["WhatsApp / Messenger", "Gestion des leads"],
  },
  {
    number: "04",
    title: "OPTIMISER",
    items: ["Suivi quotidien", "Reporting"],
  },
];
---

<section id="offer" class="offer">
  <div class="offer-container">

    <!-- =========================================
         HEADER
    ========================================== -->

    <header class="offer-header">

      <span class="eyebrow">
        <span class="eyebrow-dot"></span>
        THE OFFER
      </span>

      <h2>
        Tout ce dont votre salon
        <span>a besoin pour grandir.</span>
      </h2>

      <p>
        Un système simple et structuré pour attirer,
        convertir et optimiser vos demandes.
      </p>

    </header>


    <!-- =========================================
         PRICING INTERFACE
    ========================================== -->

    <div class="pricing-card">

      <!-- TOP PRICING BAR -->

      <div class="pricing-top">

        <div class="plan-information">

          <div class="plan-icon">
            S
          </div>

          <div class="plan-copy">

            <span class="plan-label">
              SPARK
            </span>

            <h3>
              GROWTH
            </h3>

            <p>
              Beauty Growth System
            </p>

          </div>

        </div>


        <div class="price">

          <span class="price-amount">
            1 500
          </span>

          <div class="price-details">
            <span class="price-currency">
              DH
            </span>

            <span class="price-period">
              / mois
            </span>
          </div>

        </div>

      </div>


      <!-- =========================================
           SYSTEM BAR
      ========================================== -->

      <div class="system-wrapper">

        <div class="system-meta">

          <span>
            VOTRE SYSTÈME DE CROISSANCE
          </span>

          <span class="system-status">
            <i></i>
            ACTIVE
          </span>

        </div>


        <div class="system-bar">

          <div class="system-progress"></div>

          {stages.map((stage, index) => (
            <div
              class:list={[
                "system-stage",
                { active: index === 0 },
              ]}
            >

              <span class="stage-number">
                {stage.number}
              </span>

              <span class="stage-title">
                {stage.title}
              </span>

            </div>
          ))}

        </div>

      </div>


      <!-- =========================================
           INCLUDED
      ========================================== -->

      <div class="included">

        <div class="included-header">

          <span>
            CE QUI EST INCLUS
          </span>

          <span>
            7 ÉLÉMENTS
          </span>

        </div>


        <div class="included-grid">

          {stages.map((stage) => (

            <div class="feature-group">

              <div class="feature-group-header">

                <span class="feature-number">
                  {stage.number}
                </span>

                <span class="feature-title">
                  {stage.title}
                </span>

              </div>


              <div class="feature-list">

                {stage.items.map((item) => (

                  <div class="feature">

                    <span class="check">

                      <svg
                        viewBox="0 0 16 16"
                        aria-hidden="true"
                      >
                        <path d="M3 8.5L6.5 12L13 5" />
                      </svg>

                    </span>

                    <span>
                      {item}
                    </span>

                  </div>

                ))}

              </div>

            </div>

          ))}

        </div>

      </div>


      <!-- =========================================
           BOTTOM CTA
      ========================================== -->

      <div class="pricing-footer">

        <div class="footer-message">

          <span class="footer-dot"></span>

          <div>
            <strong>
              Pensé exclusivement pour les salons.
            </strong>

            <span>
              Simple à comprendre. Facile à suivre.
            </span>
          </div>

        </div>


        <a
          href="#contact"
          class="offer-button"
        >

          <span>
            Parler à Spark
          </span>

          <span class="arrow">
            →
          </span>

        </a>

      </div>

    </div>


    <!-- =========================================
         MICROCOPY
    ========================================== -->

    <p class="offer-note">
      Parlons de votre salon.
      <span>Sans engagement.</span>
    </p>

  </div>
</section>


<style>

  /* =========================================
     SECTION
  ========================================== */

  .offer {
    position: relative;

    overflow: hidden;

    background: #f5f7f8;

    color: #071116;
  }


  .offer-container {
    width: min(
      1180px,
      calc(100% - 48px)
    );

    margin: 0 auto;

    padding:
      120px 0
      125px;
  }


  /* =========================================
     HEADER
  ========================================== */

  .offer-header {
    max-width: 900px;

    margin-bottom: 52px;
  }


  .eyebrow {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    color: #008c96;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 0.16em;
  }


  .eyebrow-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #00afb9;
  }


  .offer-header h2 {
    margin:
      18px 0
      16px;

    max-width: 780px;

    font-size: clamp(
      45px,
      5.3vw,
      70px
    );

    line-height: 0.98;

    letter-spacing: -0.055em;

    font-weight: 800;
  }


  .offer-header h2 span {
    display: block;

    color: #008c96;
  }


  .offer-header p {
    max-width: 460px;

    margin: 0;

    color: #66737b;

    font-size: 14px;

    line-height: 1.8;
  }


  /* =========================================
     PRICING CARD
  ========================================== */

  .pricing-card {
    overflow: hidden;

    border: 1px solid #dce3e6;

    border-radius: 16px;

    background: #ffffff;

    box-shadow:
      0 24px 70px
      rgba(7, 17, 22, 0.08);
  }


  /* =========================================
     TOP
  ========================================== */

  .pricing-top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

    padding:
      32px 38px;

    background: #eef8f9;

    border-bottom:
      1px solid #dce8ea;
  }


  .plan-information {
    display: flex;

    align-items: center;

    gap: 14px;
  }


  .plan-icon {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 44px;
    height: 44px;

    border-radius: 10px;

    background: #071116;

    color: #ffffff;

    font-size: 17px;

    font-weight: 800;

    box-shadow:
      0 8px 20px
      rgba(7, 17, 22, 0.12);
  }


  .plan-copy {
    display: flex;

    flex-direction: column;
  }


  .plan-label {
    color: #008c96;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.18em;
  }


  .plan-copy h3 {
    margin: 2px 0 0;

    font-size: 17px;

    line-height: 1;

    letter-spacing: 0.07em;

    font-weight: 800;
  }


  .plan-copy p {
    margin: 5px 0 0;

    color: #738087;

    font-size: 10px;
  }


  /* =========================================
     PRICE
  ========================================== */

  .price {
    display: flex;

    align-items: flex-end;

    color: #071116;
  }


  .price-amount {
    font-size: clamp(
      42px,
      5vw,
      64px
    );

    line-height: 0.9;

    letter-spacing: -0.065em;

    font-weight: 800;
  }


  .price-details {
    display: flex;

    align-items: baseline;

    gap: 4px;

    margin:
      0 0
      5px
      8px;
  }


  .price-currency {
    color: #008c96;

    font-size: 16px;

    font-weight: 800;
  }


  .price-period {
    color: #758188;

    font-size: 11px;
  }


  /* =========================================
     SYSTEM
  ========================================== */

  .system-wrapper {
    padding:
      25px 38px
      28px;

    border-bottom:
      1px solid #e5eaec;
  }


  .system-meta {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 15px;

    color: #8a959b;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.13em;
  }


  .system-status {
    display: flex;

    align-items: center;

    gap: 6px;

    color: #008c96;
  }


  .system-status i {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #00afb9;

    box-shadow:
      0 0 0 4px
      rgba(0, 175, 185, 0.08);
  }


  .system-bar {
    position: relative;

    display: grid;

    grid-template-columns:
      repeat(4, 1fr);

    min-height: 58px;

    border:
      1px solid #dfe6e8;

    border-radius: 10px;

    background: #f5f7f8;

    overflow: hidden;
  }


  .system-progress {
    position: absolute;

    z-index: 0;

    top: 0;
    bottom: 0;
    left: 0;

    width: 25%;

    background:
      linear-gradient(
        90deg,
        rgba(0, 175, 185, 0.16),
        rgba(0, 175, 185, 0.035)
      );

    border-right:
      1px solid
      rgba(0, 175, 185, 0.2);
  }


  .system-stage {
    position: relative;

    z-index: 1;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    border-right:
      1px solid #e1e7e9;

    color: #89949a;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.08em;
  }


  .system-stage:last-child {
    border-right: 0;
  }


  .system-stage.active {
    color: #071116;
  }


  .stage-number {
    color: #00afb9;

    font-size: 8px;
  }


  /* =========================================
     INCLUDED
  ========================================== */

  .included {
    padding:
      28px 38px
      34px;
  }


  .included-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 23px;

    color: #909ba0;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.13em;
  }


  .included-grid {
    display: grid;

    grid-template-columns:
      repeat(4, 1fr);

    border-top:
      1px solid #e5eaec;

    border-bottom:
      1px solid #e5eaec;
  }


  .feature-group {
    min-height: 160px;

    padding:
      22px 20px
      24px 0;

    border-right:
      1px solid #e5eaec;
  }


  .feature-group:not(:first-child) {
    padding-left: 20px;
  }


  .feature-group:last-child {
    border-right: 0;
  }


  .feature-group-header {
    display: flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 22px;
  }


  .feature-number {
    color: #00afb9;

    font-size: 8px;

    font-weight: 800;
  }


  .feature-title {
    color: #071116;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 0.11em;
  }


  .feature-list {
    display: flex;

    flex-direction: column;

    gap: 13px;
  }


  .feature {
    display: flex;

    align-items: center;

    gap: 8px;

    color: #58666e;

    font-size: 10px;

    line-height: 1.4;
  }


  .check {
    display: flex;

    align-items: center;

    justify-content: center;

    flex: 0 0 auto;

    width: 19px;
    height: 19px;

    border:
      1px solid
      rgba(0, 175, 185, 0.24);

    border-radius: 50%;

    background:
      rgba(0, 175, 185, 0.06);

    color: #008c96;
  }


  .check svg {
    width: 11px;
    height: 11px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.6;

    stroke-linecap: round;

    stroke-linejoin: round;
  }


  /* =========================================
     FOOTER
  ========================================== */

  .pricing-footer {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

    padding:
      20px 38px;

    background: #fafbfb;

    border-top:
      1px solid #e7ebed;
  }


  .footer-message {
    display: flex;

    align-items: center;

    gap: 10px;
  }


  .footer-dot {
    width: 7px;
    height: 7px;

    flex: 0 0 auto;

    border-radius: 50%;

    background: #00afb9;

    box-shadow:
      0 0 0 4px
      rgba(0, 175, 185, 0.08);
  }


  .footer-message div {
    display: flex;

    flex-direction: column;

    gap: 3px;
  }


  .footer-message strong {
    color: #26333a;

    font-size: 10px;

    font-weight: 750;
  }


  .footer-message span {
    color: #879299;

    font-size: 9px;
  }


  /* =========================================
     CTA
  ========================================== */

  .offer-button {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 18px;

    min-height: 46px;

    padding:
      0 18px
      0 21px;

    border-radius: 8px;

    background: #071116;

    color: #ffffff;

    text-decoration: none;

    font-size: 11px;

    font-weight: 750;

    transition:
      background 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }


  .offer-button:hover {
    background: #008c96;

    transform: translateY(-2px);

    box-shadow:
      0 10px 24px
      rgba(0, 140, 150, 0.18);
  }


  .offer-button:focus-visible {
    outline:
      2px solid #00afb9;

    outline-offset: 3px;
  }


  .arrow {
    font-size: 16px;

    line-height: 1;
  }


  /* =========================================
     NOTE
  ========================================== */

  .offer-note {
    margin: 17px 0 0;

    text-align: center;

    color: #8a959b;

    font-size: 10px;
  }


  .offer-note span {
    color: #071116;

    font-weight: 700;
  }


  /* =========================================
     TABLET
  ========================================== */

  @media (max-width: 900px) {

    .offer-container {
      width: min(
        850px,
        calc(100% - 40px)
      );
    }


    .included-grid {
      grid-template-columns:
        repeat(2, 1fr);
    }


    .feature-group:nth-child(2) {
      border-right: 0;
    }


    .feature-group:nth-child(3),
    .feature-group:nth-child(4) {
      border-top:
        1px solid #e5eaec;
    }


    .feature-group:nth-child(3) {
      padding-left: 0;
    }

  }


  /* =========================================
     MOBILE
  ========================================== */

  @media (max-width: 650px) {

    .offer-container {
      width: calc(100% - 28px);

      padding:
        80px 0
        82px;
    }


    .offer-header {
      margin-bottom: 38px;
    }


    .offer-header h2 {
      font-size: 43px;
    }


    .offer-header p {
      font-size: 13px;
    }


    .pricing-top {
      align-items: flex-start;

      flex-direction: column;

      padding:
        25px 20px;
    }


    .price-amount {
      font-size: 46px;
    }


    .system-wrapper {
      padding:
        22px 18px
        24px;
    }


    .system-bar {
      grid-template-columns:
        repeat(4, 1fr);

      min-height: 68px;
    }


    .system-stage {
      flex-direction: column;

      gap: 4px;

      font-size: 7px;
    }


    .included {
      padding:
        24px 18px
        28px;
    }


    .included-grid {
      grid-template-columns: 1fr;
    }


    .feature-group,
    .feature-group:not(:first-child) {
      min-height: auto;

      padding:
        21px 0;

      border-right: 0;

      border-bottom:
        1px solid #e5eaec;
    }


    .feature-group:last-child {
      border-bottom: 0;
    }


    .pricing-footer {
      align-items: stretch;

      flex-direction: column;

      padding:
        20px 18px;
    }


    .footer-message {
      align-items: flex-start;
    }


    .offer-button {
      width: 100%;
    }

  }


  /* =========================================
     SMALL MOBILE
  ========================================== */

  @media (max-width: 420px) {

    .offer-header h2 {
      font-size: 38px;
    }


    .system-stage {
      font-size: 6px;
    }


    .stage-number {
      font-size: 7px;
    }


    .price-amount {
      font-size: 42px;
    }

  }


  /* =========================================
     REDUCED MOTION
  ========================================== */

  @media (prefers-reduced-motion: reduce) {

    .offer-button {
      transition: none;
    }

  }

</style>