---
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero/hero-dashboard.webp";

const steps = [
  {
    number: "01",
    title: "VISIBILITÉ",
    headline: "Attirer les bonnes clientes.",
    service: "FACEBOOK & INSTAGRAM ADS",
    description:
      "Nous diffusons votre offre auprès de personnes susceptibles d'être intéressées par vos services.",
  },
  {
    number: "02",
    title: "CONVERSION",
    headline: "Transformer l'intérêt en demandes.",
    service: "OFFRES + CONTENU",
    description:
      "Des offres et contenus pensés pour donner envie de passer à l'action.",
  },
  {
    number: "03",
    title: "RELANCE",
    headline: "Ne laisser passer aucune opportunité.",
    service: "WHATSAPP / MESSENGER",
    description:
      "Les prospects sont orientés vers WhatsApp ou Messenger pour faciliter les échanges et les demandes de rendez-vous.",
  },
  {
    number: "04",
    title: "RENDEZ-VOUS",
    headline: "Améliorer ce qui fonctionne.",
    service: "SUIVI + OPTIMISATION",
    description:
      "Nous suivons les performances et ajustons le système pour améliorer progressivement les résultats.",
  },
];
---

<section id="spark-system" class="system-section">
  <div class="system-bg" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="bg-orb bg-orb-one"></div>
    <div class="bg-orb bg-orb-two"></div>
  </div>

  <div class="system-container">

    <!-- =====================================================
         OUTCOME
    ====================================================== -->

    <header class="outcome-header">

      <div class="section-eyebrow">
        <span class="eyebrow-line"></span>
        <span>THE SPARK SYSTEM</span>
      </div>

      <div class="outcome-layout">

        <div class="outcome-copy">

          <span class="section-index">
            03 / LE SYSTÈME
          </span>

          <h2>
            De la visibilité
            <span>aux rendez-vous.</span>
          </h2>

        </div>

        <div class="outcome-description">

          <p>
            Être visible ne suffit pas. Spark transforme cette
            visibilité en demandes, puis en conversations et en
            rendez-vous grâce à un parcours pensé pour votre salon.
          </p>

          <a href="#offer" class="outcome-link">
            <span>Découvrir l'offre</span>

            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 8H13M13 8L9 4M13 8L9 12"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>

        </div>

      </div>
    </header>


    <!-- =====================================================
         VISUAL STORY
    ====================================================== -->

    <div class="story">

      <div class="story-image">

        <Image
          src={heroImage}
          alt="Salon de beauté accompagné par le système Spark"
          loading="lazy"
          decoding="async"
          width={1100}
          height={720}
        />

        <div class="story-overlay"></div>

        <div class="story-topline">
          <span class="story-status-dot"></span>
          <span>SYSTÈME SPARK</span>
        </div>

        <div class="story-caption">

          <span class="caption-label">
            DE LA VISIBILITÉ
          </span>

          <strong>
            Jusqu'au rendez-vous.
          </strong>

          <p>
            Chaque étape transforme la suivante.
          </p>

        </div>

        <div class="story-endpoint">
          <span>OBJECTIF</span>
          <strong>RENDEZ-VOUS</strong>
        </div>

      </div>


      <!-- Story side -->

      <div class="story-side">

        <span class="story-side-label">
          LE PARCOURS
        </span>

        <h3>
          Une visibilité qui
          <span>mène quelque part.</span>
        </h3>

        <p>
          Nous ne cherchons pas simplement à faire connaître votre
          salon. Nous construisons un parcours où chaque action
          prépare la suivante.
        </p>

        <div class="story-flow">

          <div class="flow-item">
            <span class="flow-number">01</span>
            <strong>Être vu.</strong>
          </div>

          <div class="flow-line"></div>

          <div class="flow-item">
            <span class="flow-number">02</span>
            <strong>Donner envie.</strong>
          </div>

          <div class="flow-line"></div>

          <div class="flow-item">
            <span class="flow-number">03</span>
            <strong>Créer le contact.</strong>
          </div>

          <div class="flow-line"></div>

          <div class="flow-item flow-final">
            <span class="flow-number">04</span>
            <strong>Obtenir le rendez-vous.</strong>
          </div>

        </div>

      </div>

    </div>


    <!-- =====================================================
         CONTINUATION / SYSTEM
    ====================================================== -->

    <div class="system-transition">

      <div class="transition-line"></div>

      <div class="transition-label">
        <span>COMMENT ÇA FONCTIONNE</span>

        <span class="active-status">
          <i></i>
          SYSTÈME ACTIF
        </span>
      </div>

      <div class="system-intro">

        <div>
          <span class="system-label">
            UN SYSTÈME SIMPLE
          </span>

          <h3>
            Chaque étape
            <span>compte.</span>
          </h3>
        </div>

        <p>
          Pas besoin de marketing compliqué. Chaque action a une
          fonction claire dans le parcours qui transforme la
          visibilité en rendez-vous.
        </p>

      </div>

    </div>


    <!-- =====================================================
         CONNECTED PROCESS
    ====================================================== -->

    <div class="process">

      {steps.map((step, index) => (
        <article
          class:list={[
            "process-step",
            index === steps.length - 1 && "process-step-final",
          ]}
        >

          <div class="process-top">

            <span class="process-number">
              {step.number}
            </span>

            <span class="process-service">
              {step.service}
            </span>

          </div>


          <div class="process-content">

            <div class="process-title-row">

              <span class="process-title">
                {step.title}
              </span>

              {index < steps.length - 1 && (
                <span class="process-arrow" aria-hidden="true">
                  →
                </span>
              )}

            </div>

            <h4>
              {step.headline}
            </h4>

            <p>
              {step.description}
            </p>

          </div>


          {index < steps.length - 1 && (
            <div class="process-connector" aria-hidden="true">
              <span></span>
            </div>
          )}

        </article>
      ))}

    </div>


    <!-- =====================================================
         FINAL MESSAGE
    ====================================================== -->

    <div class="system-outcome">

      <div class="outcome-rule"></div>

      <span>
        LE RÉSULTAT RECHERCHÉ
      </span>

      <h3>
        Plus de demandes.
        <strong>Plus de rendez-vous.</strong>
      </h3>

    </div>

  </div>
</section>


<style>

/* =========================================================
   SECTION
========================================================= */

.system-section {
  position: relative;
  overflow: hidden;

  background:
    linear-gradient(
      180deg,
      #f4fafb 0%,
      #ffffff 42%,
      #ffffff 100%
    );

  color: #111318;
}


/* =========================================================
   BACKGROUND
========================================================= */

.system-bg {
  position: absolute;
  inset: 0;

  pointer-events: none;
}

.bg-grid {
  position: absolute;
  inset: 0;

  opacity: 0.38;

  background-image:
    linear-gradient(
      rgba(17, 19, 24, 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(17, 19, 24, 0.035) 1px,
      transparent 1px
    );

  background-size: 72px 72px;

  mask-image:
    linear-gradient(
      to bottom,
      transparent,
      black 15%,
      black 75%,
      transparent
    );
}

.bg-orb {
  position: absolute;

  border-radius: 50%;

  filter: blur(80px);
}

.bg-orb-one {
  top: 8%;
  right: -180px;

  width: 420px;
  height: 420px;

  background: rgba(0, 175, 185, 0.065);
}

.bg-orb-two {
  top: 55%;
  left: -190px;

  width: 400px;
  height: 400px;

  background: rgba(102, 170, 210, 0.04);
}


/* =========================================================
   CONTAINER
========================================================= */

.system-container {
  position: relative;
  z-index: 2;

  width: min(
    1280px,
    calc(100% - 80px)
  );

  margin: 0 auto;

  padding:
    125px 0
    135px;
}


/* =========================================================
   OUTCOME HEADER
========================================================= */

.outcome-header {
  margin-bottom: 58px;
}

.section-eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;

  color: #00a5ae;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: 0.15em;
}

.eyebrow-line {
  width: 25px;
  height: 1px;

  background: #00afb9;
}

.outcome-layout {
  display: grid;

  grid-template-columns:
    minmax(0, 1.25fr)
    minmax(280px, 0.75fr);

  align-items: end;

  gap: 80px;

  margin-top: 22px;
}

.section-index {
  display: block;

  margin-bottom: 17px;

  color: #9aa2ab;

  font-size: 9px;
  font-weight: 750;

  letter-spacing: 0.13em;
}

.outcome-copy h2 {
  max-width: 760px;

  margin: 0;

  color: #111318;

  font-size: clamp(
    48px,
    6vw,
    78px
  );

  line-height: 0.95;

  letter-spacing: -0.06em;

  font-weight: 800;
}

.outcome-copy h2 span {
  display: block;

  color: #00aab4;
}

.outcome-description {
  max-width: 420px;

  padding-bottom: 4px;
}

.outcome-description p {
  margin: 0;

  color: #626a75;

  font-size: 14px;

  line-height: 1.8;
}

.outcome-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  margin-top: 21px;

  color: #111318;

  font-size: 12px;
  font-weight: 750;

  text-decoration: none;

  transition:
    color 180ms ease,
    transform 180ms ease;
}

.outcome-link svg {
  color: #00aab4;

  transition: transform 180ms ease;
}

.outcome-link:hover {
  color: #00aab4;

  transform: translateX(2px);
}

.outcome-link:hover svg {
  transform: translateX(3px);
}


/* =========================================================
   VISUAL STORY
========================================================= */

.story {
  display: grid;

  grid-template-columns:
    minmax(0, 1.5fr)
    minmax(310px, 0.5fr);

  min-height: 540px;

  overflow: hidden;

  border:
    1px solid #dce7e9;

  border-radius: 24px;

  background: #ffffff;

  box-shadow:
    0 24px 75px rgba(21, 45, 50, 0.075);
}


/* =========================================================
   STORY IMAGE
========================================================= */

.story-image {
  position: relative;

  min-height: 540px;

  overflow: hidden;

  background: #dcecef;
}

.story-image img {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 800ms
    cubic-bezier(
      0.22,
      1,
      0.36,
      1
    );
}

.story:hover .story-image img {
  transform: scale(1.025);
}

.story-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      180deg,
      rgba(7, 17, 22, 0.08) 0%,
      rgba(7, 17, 22, 0.02) 42%,
      rgba(7, 17, 22, 0.6) 100%
    );
}

.story-topline {
  position: absolute;

  top: 27px;
  left: 27px;

  display: flex;
  align-items: center;

  gap: 8px;

  color: rgba(255,255,255,0.82);

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 0.14em;
}

.story-status-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #00afb9;

  box-shadow:
    0 0 0 5px rgba(0,175,185,0.13);
}

.story-caption {
  position: absolute;

  left: 30px;
  bottom: 31px;

  max-width: 360px;

  color: #ffffff;
}

.caption-label {
  display: block;

  margin-bottom: 8px;

  color: #7de1e6;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 0.14em;
}

.story-caption strong {
  display: block;

  font-size: clamp(
    28px,
    3vw,
    42px
  );

  line-height: 0.98;

  letter-spacing: -0.045em;

  font-weight: 800;
}

.story-caption p {
  margin: 13px 0 0;

  color: rgba(255,255,255,0.72);

  font-size: 11px;

  line-height: 1.5;
}

.story-endpoint {
  position: absolute;

  top: 27px;
  right: 27px;

  display: flex;
  flex-direction: column;

  align-items: flex-end;

  gap: 4px;
}

.story-endpoint span {
  color: rgba(255,255,255,0.45);

  font-size: 7px;
  font-weight: 800;

  letter-spacing: 0.13em;
}

.story-endpoint strong {
  color: #ffffff;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.1em;
}


/* =========================================================
   STORY SIDE
========================================================= */

.story-side {
  display: flex;
  flex-direction: column;

  justify-content: center;

  padding:
    50px 40px;

  border-left:
    1px solid #e0e8e9;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f5fbfb
    );
}

.story-side-label {
  color: #00a5ae;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 0.15em;
}

.story-side h3 {
  margin: 14px 0 0;

  color: #111318;

  font-size: clamp(
    28px,
    3vw,
    38px
  );

  line-height: 0.98;

  letter-spacing: -0.045em;

  font-weight: 800;
}

.story-side h3 span {
  display: block;

  color: #00aab4;
}

.story-side > p {
  max-width: 330px;

  margin: 21px 0 0;

  color: #68717c;

  font-size: 12px;

  line-height: 1.75;
}


/* =========================================================
   STORY FLOW
========================================================= */

.story-flow {
  display: flex;
  flex-direction: column;

  margin-top: 32px;
}

.flow-item {
  display: grid;

  grid-template-columns: 25px 1fr;

  align-items: center;

  gap: 10px;

  min-height: 35px;
}

.flow-number {
  color: #a0a8b0;

  font-size: 7px;
  font-weight: 800;

  letter-spacing: 0.1em;
}

.flow-item strong {
  color: #252b32;

  font-size: 10px;
  font-weight: 750;
}

.flow-final strong {
  color: #00a5ae;
}

.flow-line {
  width: 1px;
  height: 18px;

  margin-left: 3px;

  background:
    linear-gradient(
      to bottom,
      #cbdcdf,
      #00afb9
    );
}


/* =========================================================
   TRANSITION
========================================================= */

.system-transition {
  padding-top: 76px;
}

.transition-line {
  width: 100%;
  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #d8e4e6 10%,
      #d8e4e6 90%,
      transparent
    );
}

.transition-label {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-top: 25px;

  color: #8a929c;

  font-size: 7px;
  font-weight: 800;

  letter-spacing: 0.14em;
}

.active-status {
  display: flex;
  align-items: center;

  gap: 6px;

  color: #00a5ae;
}

.active-status i {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #00afb9;

  box-shadow:
    0 0 0 4px rgba(0,175,185,0.09);
}


/* =========================================================
   SYSTEM INTRO
========================================================= */

.system-intro {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(280px, 0.55fr);

  align-items: end;

  gap: 70px;

  margin-top: 28px;
}

.system-label {
  display: block;

  margin-bottom: 11px;

  color: #00a5ae;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.15em;
}

.system-intro h3 {
  margin: 0;

  color: #111318;

  font-size: clamp(
    34px,
    4vw,
    52px
  );

  line-height: 0.98;

  letter-spacing: -0.05em;

  font-weight: 800;
}

.system-intro h3 span {
  color: #00aab4;
}

.system-intro > p {
  max-width: 400px;

  margin: 0;

  color: #6b727e;

  font-size: 13px;

  line-height: 1.75;
}


/* =========================================================
   PROCESS
========================================================= */

.process {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  margin-top: 38px;

  border-top:
    1px solid #dfe6e8;

  border-left:
    1px solid #dfe6e8;
}

.process-step {
  position: relative;

  min-height: 300px;

  padding:
    24px 24px
    28px;

  border-right:
    1px solid #dfe6e8;

  border-bottom:
    1px solid #dfe6e8;

  background: rgba(255,255,255,0.58);

  transition:
    background 220ms ease;
}

.process-step:hover {
  background: #f7fcfc;
}

.process-step-final {
  background:
    linear-gradient(
      180deg,
      #f4fbfb,
      #ffffff
    );
}

.process-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;
}

.process-number {
  color: #00a5ae;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.12em;
}

.process-service {
  color: #a0a7af;

  font-size: 6px;
  font-weight: 800;

  letter-spacing: 0.11em;

  text-align: right;
}

.process-content {
  margin-top: 55px;
}

.process-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;
}

.process-title {
  color: #00a5ae;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.13em;
}

.process-arrow {
  color: #b3c2c5;

  font-size: 14px;
}

.process-step-final .process-arrow {
  display: none;
}

.process-step h4 {
  max-width: 240px;

  margin: 10px 0 0;

  color: #111318;

  font-size: 20px;

  line-height: 1.08;

  letter-spacing: -0.035em;

  font-weight: 750;
}

.process-step p {
  max-width: 260px;

  margin: 17px 0 0;

  color: #69717c;

  font-size: 11px;

  line-height: 1.72;
}


/* =========================================================
   PROCESS CONNECTOR
========================================================= */

.process-connector {
  position: absolute;

  top: 63px;
  right: -1px;

  display: flex;
  align-items: center;

  width: 1px;
  height: 28px;

  background: #d5e1e3;
}

.process-connector span {
  position: absolute;

  right: -2px;

  width: 5px;
  height: 5px;

  border-top:
    1px solid #00afb9;

  border-right:
    1px solid #00afb9;

  transform:
    rotate(45deg);
}


/* =========================================================
   FINAL OUTCOME
========================================================= */

.system-outcome {
  margin-top: 82px;

  text-align: center;
}

.outcome-rule {
  width: 42px;
  height: 1px;

  margin:
    0 auto
    25px;

  background: #d8e2e4;
}

.system-outcome > span {
  display: block;

  margin-bottom: 12px;

  color: #00a5ae;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 0.16em;
}

.system-outcome h3 {
  margin: 0;

  color: #111318;

  font-size: clamp(
    30px,
    3.8vw,
    46px
  );

  line-height: 1;

  letter-spacing: -0.05em;

  font-weight: 800;
}

.system-outcome strong {
  color: #00aab4;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) {

  .system-container {
    width: min(
      1200px,
      calc(100% - 56px)
    );

    padding:
      105px 0
      110px;
  }

  .outcome-layout {
    gap: 45px;
  }

  .story {
    grid-template-columns:
      minmax(0, 1.35fr)
      minmax(280px, 0.65fr);
  }

  .story-side {
    padding:
      35px 27px;
  }

  .process-step {
    padding:
      22px 20px
      25px;
  }

  .process-step h4 {
    font-size: 18px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  .system-section {
    background:
      linear-gradient(
        180deg,
        #f4fafb,
        #ffffff 28%
      );
  }

  .system-container {
    width: min(
      calc(100% - 32px),
      640px
    );

    padding:
      82px 0
      88px;
  }

  .bg-grid {
    background-size:
      48px 48px;
  }


  /* Outcome */

  .outcome-header {
    margin-bottom: 43px;
  }

  .section-eyebrow {
    font-size: 8px;
  }

  .outcome-layout {
    grid-template-columns: 1fr;

    gap: 23px;

    margin-top: 19px;
  }

  .section-index {
    margin-bottom: 13px;

    font-size: 8px;
  }

  .outcome-copy h2 {
    font-size:
      clamp(
        42px,
        11vw,
        60px
      );
  }

  .outcome-description {
    max-width: 560px;
  }

  .outcome-description p {
    font-size: 13px;
  }


  /* Story */

  .story {
    display: block;

    min-height: auto;

    border-radius: 19px;
  }

  .story-image {
    min-height: 390px;
  }

  .story-topline {
    top: 19px;
    left: 19px;
  }

  .story-endpoint {
    top: 19px;
    right: 19px;
  }

  .story-caption {
    right: 19px;
    left: 19px;
    bottom: 22px;
  }

